<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Add the Vehicle field to the request form (fleet requests).
         Odoo 19 rebuild: inherits myservice_request_core's request form
         (was generic_request). The location field (generic_location_id) is
         already on request_core's form, so the old crnd_wsd/m2o_info
         header-location relabel record has been removed. -->
    <record id="view_request_request_form_vehicle" model="ir.ui.view">
        <field name="name">request.request.form.vehicle</field>
        <field name="model">request.request</field>
        <field name="inherit_id" ref="myservice_request_core.view_request_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="vehicle_id"
                    string="Vehicle"
                    options="{'no_create': True, 'no_open': True}"
                    placeholder="Search by plate, chassis or tag"/>
            </xpath>
        </field>
    </record>

</odoo>
