<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_request_request_form_vehicle_location" model="ir.ui.view">
        <field name="name">request.request.form.vehicle.location</field>
        <field name="model">request.request</field>
        <field name="inherit_id" ref="generic_request.view_request_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='category_id']" position="after">
                <field name="generic_location_id"
                    string="Location"
                    required="1"
                    options="{'no_create': True, 'no_open': True}"
                    placeholder="Search by office, state or zone"/>
                <field name="vehicle_id"
                    string="Vehicle"
                    options="{'no_create': True, 'no_open': True}"
                    placeholder="Search by plate, chassis or tag"/>
            </xpath>
        </field>
    </record>

</odoo>
