<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sap_sync_log_list" model="ir.ui.view">
        <field name="name">nrs.sap.sync.log.list</field>
        <field name="model">nrs.sap.sync.log</field>
        <field name="arch" type="xml">
            <tree decoration-success="status == 'success'"
                  decoration-danger="status == 'error'"
                  decoration-muted="status == 'skipped'">
                <field name="create_date"/>
                <field name="ir_number"/>
                <field name="employee_id"/>
                <field name="sync_type"/>
                <field name="sap_event"/>
                <field name="status"/>
                <field name="duration_ms"/>
            </tree>
        </field>
    </record>

    <record id="view_sap_sync_log_form" model="ir.ui.view">
        <field name="name">nrs.sap.sync.log.form</field>
        <field name="model">nrs.sap.sync.log</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="ir_number"/>
                        <field name="employee_id"/>
                        <field name="sync_type"/>
                        <field name="sap_event"/>
                    </group>
                    <group>
                        <field name="status"/>
                        <field name="duration_ms"/>
                        <field name="create_date"/>
                    </group>
                </group>
                <notebook>
                    <page string="Changes">
                        <field name="changes_applied"/>
                    </page>
                    <page string="Raw Payload">
                        <field name="payload"/>
                    </page>
                    <page string="Error">
                        <field name="error_message"/>
                    </page>
                </notebook>
            </form>
        </field>
    </record>

    <record id="action_sap_sync_log" model="ir.actions.act_window">
        <field name="name">SAP Sync Log</field>
        <field name="res_model">nrs.sap.sync.log</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>
