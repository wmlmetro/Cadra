<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sap_import_wizard" model="ir.ui.view">
        <field name="name">nrs.sap.import.wizard.form</field>
        <field name="model">nrs.sap.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Employees from SAP CSV">
                <group>
                    <field name="file_data" filename="file_name"/>
                    <field name="file_name" invisible="1"/>
                    <field name="delimiter"/>
                </group>
                <footer>
                    <button name="action_preview" type="object"
                            string="Preview" class="btn-secondary"/>
                    <button name="action_import" type="object"
                            string="Import" class="btn-primary"/>
                    <button string="Close" class="btn-secondary" special="cancel"/>
                </footer>
                <group string="Preview"
                       invisible="preview_html == False">
                    <field name="preview_html" nolabel="1"/>
                </group>
                <group string="Result"
                       invisible="result_html == False">
                    <field name="result_html" nolabel="1"/>
                </group>
            </form>
        </field>
    </record>

    <record id="action_sap_import_wizard" model="ir.actions.act_window">
        <field name="name">Import from SAP CSV</field>
        <field name="res_model">nrs.sap.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
