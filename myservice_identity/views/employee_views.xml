<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_employee_identity_form" model="ir.ui.view">
        <field name="name">hr.employee.identity.form</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="ir_number" placeholder="e.g. IR12345678"/>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="nrs_identity" string="NRS Identity">
                    <group string="SAP SuccessFactors">
                        <group>
                            <field name="ir_number"/>
                            <field name="sap_user_id"/>
                            <field name="sap_status"/>
                            <field name="sap_last_sync"/>
                            <field name="sap_sync_status"/>
                        </group>
                        <group>
                            <field name="grade_level"/>
                            <field name="cost_centre"/>
                            <field name="sap_department"/>
                            <field name="sap_location_id"/>
                            <field name="sap_manager_ir"/>
                        </group>
                    </group>
                    <group string="Employment Dates">
                        <group>
                            <field name="employment_start_date"/>
                            <field name="employment_end_date"/>
                        </group>
                    </group>
                    <group string="Assets">
                        <group>
                            <field name="asset_count"/>
                            <field name="has_pending_retrieval"/>
                        </group>
                    </group>
                    <div>
                        <button name="action_view_assets" type="object"
                                string="View Assets" class="btn-secondary me-2"/>
                        <button name="action_sap_sync_single" type="object"
                                string="Sync from SAP" class="btn-primary me-2"/>
                        <button name="action_flag_retrieval" type="object"
                                string="Flag Assets for Retrieval" class="btn-danger"
                                invisible="sap_status != 'exited'"/>
                    </div>
                </page>
            </xpath>
        </field>
    </record>

    <record id="action_employee_ir_search" model="ir.actions.act_window">
        <field name="name">Employees by IR Number</field>
        <field name="res_model">hr.employee</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>
</odoo>
