<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Handoff 42, finishing what 41 started: on Odoo 19 a group reaches the
        user form only through a `res.groups.privilege`; without one it is
        shown only under *Extra Rights* in developer mode. In the asset
        register's category because this module depends on it and the roster
        is read beside the register. Display grouping only.
    -->
    <record id="privilege_identity" model="res.groups.privilege">
        <field name="name">Identity</field>
        <field name="sequence">40</field>
        <field name="category_id" ref="myservice_asset_register.module_category_nrs_assets"/>
        <field name="description">Manages the employee roster, the SAP employee sync and the nominal-roll import.</field>
    </record>

    <record id="group_identity_manager" model="res.groups">
        <field name="name">Identity Manager</field>
        <field name="privilege_id" ref="privilege_identity"/>
        <field name="sequence">10</field>
        <field name="comment">Can manage employee identity, SAP sync and asset assignments</field>
    </record>
</odoo>
