        <record id="request_category_security_cctv" model="request.category">
            <field name="name">CCTV / Surveillance Request</field>
            <field name="code">SEC-CCTV</field>
        </record>
        <record id="request_category_security_emergency" model="request.category">
            <field name="name">Emergency Response</field>
            <field name="code">SEC-EMRG</field>
        </record>
    </data>
</odoo>
