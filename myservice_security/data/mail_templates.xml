<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="email_template_incident_critical" model="mail.template">
            <field name="name">Security: Critical Incident Alert</field>
            <field name="model_id" ref="myservice_security.model_security_incident"/>
            <field name="subject">🚨 CRITICAL SECURITY INCIDENT — {{object.name}} at {{object.location_id.name}}</field>
            <field name="email_to">{{object.assigned_to.email or ''}}</field>
            <field name="body_html" type="html">
<div style="font-family:Arial,sans-serif;max-width:600px;margin:0 auto;border:1px solid #e0e0e0;border-radius:8px;overflow:hidden;">
    <div style="background:#dc3545;padding:20px;text-align:center;">
        <h1 style="color:#fff;margin:0;font-size:20px;">🚨 CRITICAL SECURITY INCIDENT</h1>
        <p style="color:rgba(255,255,255,0.85);margin:6px 0 0;font-size:13px;">NRS myservice Security Operations</p>
    </div>
    <div style="padding:24px;">
        <table style="width:100%;border-collapse:collapse;margin:16px 0;">
            <tr style="background:#f8f8f8;"><td style="padding:10px;font-weight:bold;width:40%;">Reference</td><td style="padding:10px;">{{object.name}}</td></tr>
            <tr><td style="padding:10px;font-weight:bold;">Type</td><td style="padding:10px;">{{object.incident_type}}</td></tr>
            <tr style="background:#f8f8f8;"><td style="padding:10px;font-weight:bold;">Severity</td><td style="padding:10px;color:#dc3545;font-weight:bold;">{{object.severity|upper}}</td></tr>
            <tr><td style="padding:10px;font-weight:bold;">Location</td><td style="padding:10px;">{{object.location_id.name}}</td></tr>
            <tr style="background:#f8f8f8;"><td style="padding:10px;font-weight:bold;">Date/Time</td><td style="padding:10px;">{{object.date_incident}}</td></tr>
        </table>
        <p style="text-align:center;margin-top:20px;">
            <a href="https://myservice.com.ng/web" style="background:#dc3545;color:#fff;padding:12px 24px;border-radius:6px;text-decoration:none;font-weight:bold;">View Incident →</a>
        </p>
    </div>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
