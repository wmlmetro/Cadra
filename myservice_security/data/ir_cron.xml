<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- on_duty is a stored compute measured against today's date, so it
             lapses at midnight without anything writing to the guard or to the
             duty roster and no @api.depends can ever fire for it. See the
             docstring on security.guard._cron_refresh_on_duty. -->
        <record id="cron_security_refresh_on_duty" model="ir.cron">
            <field name="name">Security — Refresh guards on duty</field>
            <field name="model_id" ref="model_security_guard"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh_on_duty()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>
    </data>
</odoo>
