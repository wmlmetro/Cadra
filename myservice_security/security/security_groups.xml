<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_security" model="ir.module.category">
            <field name="name">myservice Security</field>
            <field name="sequence">20</field>
        </record>

        <!--
            Handoff 42, finishing what 41 started: on Odoo 19 a group reaches
            the user form only through a `res.groups.privilege` (one SELECTION
            per privilege, grouped by its category); a group with none is shown
            only under *Extra Rights* in developer mode. Display grouping only —
            no implication, no access rule changes. See the comment in
            `myservice_asset_register/security/asset_security.xml`.
        -->
        <record id="privilege_security" model="res.groups.privilege">
            <field name="name">Security</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="module_category_security"/>
            <field name="description">Officer sees the dashboards; Manager runs the rosters; Administrator configures the module. Each level implies the one below.</field>
        </record>

        <record id="group_security_officer" model="res.groups">
            <field name="name">Security Officer</field>
            <field name="privilege_id" ref="privilege_security"/>
            <field name="sequence">10</field>
            <field name="comment">Can log incidents and manage access logs</field>
        </record>

        <record id="group_security_manager" model="res.groups">
            <field name="name">Security Manager</field>
            <field name="privilege_id" ref="privilege_security"/>
            <field name="sequence">20</field>
            <field name="implied_ids" eval="[(4, ref('group_security_officer'))]"/>
            <field name="comment">Full security access including incident management and guard roster</field>
        </record>

        <record id="group_security_admin" model="res.groups">
            <field name="name">Security Administrator</field>
            <field name="privilege_id" ref="privilege_security"/>
            <field name="sequence">30</field>
            <field name="implied_ids" eval="[(4, ref('group_security_manager'))]"/>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
            <field name="comment">Full admin including all security operations</field>
        </record>
    </data>
</odoo>
