<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">

<!-- ── Case Management ──────────────────────────────────────────── -->
<t t-name="myservice_security.CaseManagement">
<div class="nrs-tabpage">
    <div class="nrs-tabbar">
        <div class="nrs-tabbar-header">
            <div class="nrs-tabbar-title">
                <span class="nrs-tabbar-icon">&#9632;</span>
                Case Management
            </div>
            <div class="nrs-tabs">
                <button class="nrs-tab active" data-tab="incidents">Incidents</button>
                <button class="nrs-tab" data-tab="watchlist">Watchlist</button>
                <button class="nrs-tab" data-tab="threats">State Threats</button>
            </div>
            <div class="nrs-tabbar-actions">
                <button class="nrs-view-all" data-action="331">View All Incidents &#8594;</button>
            </div>
        </div>
    </div>
    <div class="nrs-tab-panel" data-panel="incidents">
        <div class="nrs-tab-body-incidents"><div class="nrs-loading">Loading incidents...</div></div>
    </div>
    <div class="nrs-tab-panel" data-panel="watchlist" style="display:none">
        <div class="nrs-tab-body-watchlist"><div class="nrs-loading">Loading watchlist...</div></div>
    </div>
    <div class="nrs-tab-panel" data-panel="threats" style="display:none">
        <div class="nrs-tab-body-threats"><div class="nrs-loading">Loading threat levels...</div></div>
    </div>
</div>
</t>

<!-- ── OSINT ─────────────────────────────────────────────────────── -->
<t t-name="myservice_security.OsintPage">
<div class="nrs-tabpage">
    <div class="nrs-tabbar">
        <div class="nrs-tabbar-header">
            <div class="nrs-tabbar-title">
                <span class="nrs-tabbar-icon">&#9670;</span>
                OSINT &amp; Intelligence
            </div>
            <div class="nrs-tabs">
                <button class="nrs-tab active" data-tab="feed">Intelligence Feed</button>
                <button class="nrs-tab" data-tab="sources">Sources</button>
                <button class="nrs-tab" data-tab="osint">OSINT Feed</button>
            </div>
            <div class="nrs-tabbar-actions">
                <button class="nrs-view-all" data-action="344">View All &#8594;</button>
            </div>
        </div>
    </div>
    <div class="nrs-tab-panel" data-panel="feed">
        <div class="nrs-tab-body-feed"><div class="nrs-loading">Loading intelligence feed...</div></div>
    </div>
    <div class="nrs-tab-panel" data-panel="sources" style="display:none">
        <div class="nrs-tab-body-sources"><div class="nrs-loading">Loading sources...</div></div>
    </div>
    <div class="nrs-tab-panel" data-panel="osint" style="display:none">
        <div class="nrs-tab-body-osint"><div class="nrs-loading">Loading OSINT feed...</div></div>
    </div>
</div>
</t>

<!-- ── AI Patterns ───────────────────────────────────────────────── -->
<t t-name="myservice_security.AiPatternsPage">
<div class="nrs-tabpage">
    <div class="nrs-tabbar">
        <div class="nrs-tabbar-header">
            <div class="nrs-tabbar-title">
                <span class="nrs-tabbar-icon">&#9650;</span>
                AI Patterns &amp; Intelligence
            </div>
            <div class="nrs-tabs">
                <button class="nrs-tab active" data-tab="alerts">Pattern Alerts</button>
                <button class="nrs-tab" data-tab="briefs">Daily Briefs</button>
            </div>
            <div class="nrs-tabbar-actions">
                <button class="nrs-view-all" data-action="347">View All Alerts &#8594;</button>
            </div>
        </div>
    </div>
    <div class="nrs-tab-panel" data-panel="alerts">
        <div class="nrs-tab-body-alerts"><div class="nrs-loading">Loading pattern alerts...</div></div>
    </div>
    <div class="nrs-tab-panel" data-panel="briefs" style="display:none">
        <div class="nrs-tab-body-briefs"><div class="nrs-loading">Loading daily briefs...</div></div>
    </div>
</div>
</t>

</templates>
