<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">

<!-- ══ Security Command Center — 5 tabs ═══════════════════════════ -->
<t t-name="myservice_security.SecurityCommandCenter">
<div class="nrs-tabpage">
    <div class="nrs-tabbar">
        <div class="nrs-tabbar-header">
            <div class="nrs-tabbar-title">
                <span class="nrs-title-dot"/>Security Command Center
            </div>
            <div class="nrs-tabs">
                <button class="nrs-tab active"  data-tab="dashboard">Dashboard</button>
                <button class="nrs-tab"         data-tab="incidents">Incidents</button>
                <button class="nrs-tab"         data-tab="guards">Guards</button>
                <button class="nrs-tab"         data-tab="access_logs">Access Logs</button>
                <button class="nrs-tab"         data-tab="duty_roster">Duty Roster</button>
            </div>
        </div>
    </div>
    <div class="nrs-tab-panel" data-panel="dashboard">
        <div class="nrs-tab-body-dashboard"><div class="nrs-loading">Loading dashboard...</div></div>
    </div>
    <div class="nrs-tab-panel" data-panel="incidents" style="display:none">
        <div class="nrs-panel-toolbar"><button class="nrs-view-all" data-action="331">Open in full view &#8594;</button></div>
        <div class="nrs-tab-body-incidents"><div class="nrs-loading">Loading incidents...</div></div>
    </div>
    <div class="nrs-tab-panel" data-panel="guards" style="display:none">
        <div class="nrs-panel-toolbar"><button class="nrs-view-all" data-action="332">Open in full view &#8594;</button></div>
        <div class="nrs-tab-body-guards"><div class="nrs-loading">Loading guards...</div></div>
    </div>
    <div class="nrs-tab-panel" data-panel="access_logs" style="display:none">
        <div class="nrs-panel-toolbar"><button class="nrs-view-all" data-action="336">Open in full view &#8594;</button></div>
        <div class="nrs-tab-body-access_logs"><div class="nrs-loading">Loading access logs...</div></div>
    </div>
    <div class="nrs-tab-panel" data-panel="duty_roster" style="display:none">
        <div class="nrs-panel-toolbar"><button class="nrs-view-all" data-action="333">Open in full view &#8594;</button></div>
        <div class="nrs-tab-body-duty_roster"><div class="nrs-loading">Loading duty roster...</div></div>
    </div>
</div>
</t>

<!-- ══ Case Management ═══════════════════════════════════ -->
<t t-name="myservice_security.CaseManagement">
<div class="nrs-tabpage">
    <div class="nrs-tabbar">
        <div class="nrs-tabbar-header">
            <div class="nrs-tabbar-title">
                <span class="nrs-title-dot"/>Case Management
            </div>
            <div class="nrs-tabs">
                <button class="nrs-tab active" data-tab="incidents">Incidents</button>
            </div>
        </div>
    </div>
    <div class="nrs-tab-panel" data-panel="incidents">
        <div class="nrs-panel-toolbar"><button class="nrs-view-all" data-action="331">Open in full view &#8594;</button></div>
        <div class="nrs-tab-body-incidents"><div class="nrs-loading">Loading incidents...</div></div>
    </div>
</div>
</t>




</templates>
