<?xml version="1.0" encoding="utf-8"?>
<templates id="template" xml:space="preserve">
<t name="Security Operations Centre" t-name="myservice_security_dashboard.Dashboard">
<div class="ms-soc">

  <!-- Header -->
  <div class="ms-soc-header">
    <div class="ms-soc-brand">
      <div class="ms-soc-shield">S</div>
      <div>
        <div class="ms-soc-title">Security Operations Centre</div>
        <div class="ms-soc-sub">NRS Facilities Management — myservice.com.ng</div>
      </div>
    </div>
    <div class="ms-soc-statusbar">
      <div class="ms-soc-live"><div class="ms-soc-pulse"></div>LIVE FEED</div>
      <div class="ms-soc-time" id="soc-clock">--:--:--</div>
      <button class="ms-soc-btn ms-soc-refresh-btn">⟳ Refresh</button>
    </div>
  </div>

  <!-- KPI Strip -->
  <div class="ms-soc-kpis">
    <div class="ms-soc-kpi c-red" data-model="security.incident">
      <div class="ms-soc-kpi-val soc-kpi-open">0</div>
      <div class="ms-soc-kpi-lbl">Open Incidents</div>
    </div>
    <div class="ms-soc-kpi c-orange" data-model="security.incident">
      <div class="ms-soc-kpi-val soc-kpi-critical">0</div>
      <div class="ms-soc-kpi-lbl">Critical</div>
    </div>
    <div class="ms-soc-kpi c-yellow" data-model="security.incident">
      <div class="ms-soc-kpi-val soc-kpi-today">0</div>
      <div class="ms-soc-kpi-lbl">Today</div>
    </div>
    <div class="ms-soc-kpi c-green" data-model="security.duty.roster">
      <div class="ms-soc-kpi-val soc-kpi-guards">0</div>
      <div class="ms-soc-kpi-lbl">Guards on Duty</div>
    </div>
    <div class="ms-soc-kpi c-blue" data-model="security.access.log">
      <div class="ms-soc-kpi-val soc-kpi-access">0</div>
      <div class="ms-soc-kpi-lbl">Access Today</div>
    </div>
    <div class="ms-soc-kpi c-purple" data-model="security.watchlist">
      <div class="ms-soc-kpi-val soc-kpi-watchlist">0</div>
      <div class="ms-soc-kpi-lbl">Watchlist</div>
    </div>
  </div>

  <!-- Tab bar -->
  <div class="ms-soc-tab-bar">
    <button class="ms-soc-tab active" data-tab="soc">&#9632; SOC Overview</button>
    <button class="ms-soc-tab" data-tab="intel">&#9670; Intelligence Feed</button>
    <button class="ms-soc-tab" data-tab="watchlist">&#9632; Watchlist Board</button>
    <button class="ms-soc-tab" data-tab="reports">&#9650; Reports</button>
  </div>

  <!-- ── TAB 1: SOC Overview ──────────────────────────────────────── -->
  <div class="ms-soc-tab-panel" data-panel="soc">

    <!-- Main: Map + Right Column -->
    <div class="ms-soc-main">
      <div class="ms-soc-map-panel">
        <div class="ms-soc-map-toolbar">
          <div class="ms-soc-map-title">
            <svg width="12" height="12" viewBox="0 0 12 12"><circle cx="6" cy="6" r="5" stroke="#E85426" stroke-width="1.5" fill="none"/><circle cx="6" cy="6" r="2" fill="#E85426"/></svg>
            Geospatial Operations Map
          </div>
          <div class="ms-soc-map-filters">
            <button class="ms-soc-mf active" data-filter="all">All</button>
            <button class="ms-soc-mf" data-filter="incidents">Incidents</button>
            <button class="ms-soc-mf" data-filter="guards">Guards</button>
          </div>
        </div>
        <div id="ms-soc-map"><div style="display:flex;align-items:center;justify-content:center;height:100%;color:#7d8590;font-size:13px;gap:8px"><div style="width:16px;height:16px;border:2px solid #21262d;border-top-color:#E85426;border-radius:50%;animation:soc-spin .8s linear infinite"></div>Loading map...</div></div>
        <div class="ms-soc-map-legend">
          <div class="ms-soc-leg"><div class="ms-soc-leg-dot" style="background:#f85149"></div>Critical</div>
          <div class="ms-soc-leg"><div class="ms-soc-leg-dot" style="background:#E85426"></div>High</div>
          <div class="ms-soc-leg"><div class="ms-soc-leg-dot" style="background:#d29922"></div>Medium</div>
          <div class="ms-soc-leg"><div class="ms-soc-leg-dot" style="background:#3fb950"></div>Low/Guard</div>
          <div class="ms-soc-leg"><div class="ms-soc-leg-dot" style="background:#58a6ff"></div>FIRS Office</div>
        </div>
      </div>
      <div class="ms-soc-right">
        <div class="ms-soc-card">
          <div class="ms-soc-card-hdr">
            <span class="ms-soc-card-hdr-title">Watchlist</span>
            <span class="ms-soc-card-hdr-badge soc-watch-count">0 active</span>
          </div>
          <div class="soc-watch-list">
            <div class="ms-soc-watch-item">
              <div class="ms-soc-avatar medium">—</div>
              <div style="flex:1;min-width:0">
                <div class="ms-soc-wname">No entries yet</div>
                <div class="ms-soc-wmeta">Add via Security → Watchlist</div>
              </div>
            </div>
          </div>
        </div>
        <div class="ms-soc-card">
          <div class="ms-soc-card-hdr"><span class="ms-soc-card-hdr-title">Severity breakdown</span></div>
          <div class="ms-soc-sevbars">
            <div class="ms-soc-sevrow"><span class="ms-soc-sevlbl">Critical</span><div class="ms-soc-sevbg"><div class="ms-soc-sevfill soc-bar-critical" style="width:0%;background:#f85149"></div></div><span class="ms-soc-sevcount" style="color:#f85149" id="soc-sev-critical">0</span></div>
            <div class="ms-soc-sevrow"><span class="ms-soc-sevlbl">High</span><div class="ms-soc-sevbg"><div class="ms-soc-sevfill soc-bar-high" style="width:0%;background:#E85426"></div></div><span class="ms-soc-sevcount" style="color:#E85426" id="soc-sev-high">0</span></div>
            <div class="ms-soc-sevrow"><span class="ms-soc-sevlbl">Medium</span><div class="ms-soc-sevbg"><div class="ms-soc-sevfill soc-bar-medium" style="width:0%;background:#d29922"></div></div><span class="ms-soc-sevcount" style="color:#d29922" id="soc-sev-medium">0</span></div>
            <div class="ms-soc-sevrow"><span class="ms-soc-sevlbl">Low</span><div class="ms-soc-sevbg"><div class="ms-soc-sevfill soc-bar-low" style="width:0%;background:#3fb950"></div></div><span class="ms-soc-sevcount" style="color:#3fb950" id="soc-sev-low">0</span></div>
          </div>
        </div>
        <div class="ms-soc-card">
          <div class="ms-soc-card-hdr"><span class="ms-soc-card-hdr-title">Guard status</span></div>
          <div class="ms-soc-guard-grid">
            <div class="ms-soc-gstat"><div class="ms-soc-gstat-val" style="color:#3fb950" id="soc-g-duty">0</div><div class="ms-soc-gstat-lbl">On duty</div></div>
            <div class="ms-soc-gstat"><div class="ms-soc-gstat-val" style="color:#58a6ff" id="soc-g-total">0</div><div class="ms-soc-gstat-lbl">Total</div></div>
            <div class="ms-soc-gstat"><div class="ms-soc-gstat-val" style="color:#d29922" id="soc-g-access">0</div><div class="ms-soc-gstat-lbl">Access today</div></div>
            <div class="ms-soc-gstat"><div class="ms-soc-gstat-val" style="color:#f85149" id="soc-g-flagged">0</div><div class="ms-soc-gstat-lbl">Flagged</div></div>
          </div>
        </div>
        <div class="ms-soc-card" style="flex:1;overflow:hidden;display:flex;flex-direction:column">
          <div class="ms-soc-card-hdr">
            <span class="ms-soc-card-hdr-title">Recent incidents</span>
            <span class="ms-soc-card-hdr-badge soc-inc-count">0 open</span>
          </div>
          <div class="ms-soc-inc-list soc-inc-feed" style="overflow-y:auto;flex:1">
            <div style="padding:16px;text-align:center;color:#7d8590;font-size:12px">Loading...</div>
          </div>
        </div>
      </div>
    </div>

    <!-- OSINT Feed -->
    <div class="ms-soc-osint-section">
      <div class="ms-soc-osint-hdr">
        <div class="ms-soc-osint-title">Intelligence Feed — OSINT</div>
        <span style="font-size:10px;color:#7d8590" id="soc-osint-count">0 entries</span>
      </div>
      <div class="ms-soc-osint-grid soc-osint-grid">
        <div class="ms-soc-osint-empty">Loading...</div>
      </div>
    </div>

    <!-- State Threat Bar -->
    <div class="ms-soc-state-bar">
      <div class="ms-soc-state-hdr">State threat assessment — Nigeria</div>
      <div class="ms-soc-states soc-states-grid">
        <span class="ms-soc-state green">Loading...</span>
      </div>
    </div>

  </div>

  <!-- ── TAB 2: Intelligence Feed ─────────────────────────────────── -->
  <div class="ms-soc-tab-panel" data-panel="intel" style="display:none">
    <div class="ms-intel-toolbar">
      <div class="ms-intel-filters">
        <button class="ms-intel-filter active" data-threat="all">All</button>
        <button class="ms-intel-filter" data-threat="critical" style="color:#f85149">Critical</button>
        <button class="ms-intel-filter" data-threat="high" style="color:#E85426">High</button>
        <button class="ms-intel-filter" data-threat="medium" style="color:#d29922">Medium</button>
        <button class="ms-intel-filter" data-threat="low" style="color:#3fb950">Low</button>
        <button class="ms-intel-filter" data-threat="info" style="color:#58a6ff">Info</button>
      </div>
      <div class="ms-intel-source-filters">
        <button class="ms-intel-src active" data-source="all">All Sources</button>
        <button class="ms-intel-src" data-source="acled">ACLED</button>
        <button class="ms-intel-src" data-source="gdelt">GDELT</button>
        <button class="ms-intel-src" data-source="rss">RSS</button>
        <button class="ms-intel-src" data-source="manual">Manual</button>
        <button class="ms-intel-src" data-source="ai_pattern">AI Pattern</button>
      </div>
      <span class="ms-intel-count" id="intel-count">0 entries</span>
    </div>
    <div class="ms-intel-grid soc-intel-grid">
      <div class="ms-soc-osint-empty">Loading intelligence feed...</div>
    </div>
  </div>

  <!-- ── TAB 3: Watchlist Board ───────────────────────────────────── -->
  <div class="ms-soc-tab-panel" data-panel="watchlist" style="display:none">
    <div class="ms-wlb-toolbar">
      <div class="ms-wlb-filters">
        <button class="ms-wlb-filter active" data-threat="all">All</button>
        <button class="ms-wlb-filter" data-threat="critical">Critical</button>
        <button class="ms-wlb-filter" data-threat="high">High</button>
        <button class="ms-wlb-filter" data-threat="medium">Medium</button>
        <button class="ms-wlb-filter" data-threat="low">Low</button>
      </div>
      <div style="display:flex;align-items:center;gap:10px">
        <span class="ms-wlb-count" id="wlb-count">0 subjects</span>
        <button class="ms-soc-btn ms-wlb-fullscreen-btn">⛶ Full Screen</button>
        <button class="ms-soc-btn ms-wlb-autoplay-btn">▶ Auto-cycle</button>
      </div>
    </div>
    <div class="ms-wlb-grid soc-wlb-grid">
      <div class="ms-soc-osint-empty">Loading watchlist...</div>
    </div>
  </div>

  <!-- ── TAB 4: Reports ───────────────────────────────────────────── -->
  <div class="ms-soc-tab-panel" data-panel="reports" style="display:none">
    <div class="ms-rpt-grid">

      <!-- Incidents by type -->
      <div class="ms-rpt-card">
        <div class="ms-rpt-card-hdr">Incidents by type</div>
        <div class="ms-rpt-bars soc-rpt-by-type">
          <div class="ms-soc-osint-empty">Loading...</div>
        </div>
      </div>

      <!-- Incidents by state -->
      <div class="ms-rpt-card">
        <div class="ms-rpt-card-hdr">Incidents by state (top 10)</div>
        <div class="ms-rpt-bars soc-rpt-by-state">
          <div class="ms-soc-osint-empty">Loading...</div>
        </div>
      </div>

      <!-- Incidents by severity -->
      <div class="ms-rpt-card">
        <div class="ms-rpt-card-hdr">Severity distribution</div>
        <div class="ms-rpt-bars soc-rpt-by-severity">
          <div class="ms-soc-osint-empty">Loading...</div>
        </div>
      </div>

      <!-- Access log summary -->
      <div class="ms-rpt-card">
        <div class="ms-rpt-card-hdr">Access log — last 30 days</div>
        <div class="ms-rpt-stats soc-rpt-access">
          <div class="ms-soc-osint-empty">Loading...</div>
        </div>
      </div>

      <!-- Watchlist by category -->
      <div class="ms-rpt-card">
        <div class="ms-rpt-card-hdr">Watchlist by category</div>
        <div class="ms-rpt-bars soc-rpt-wl-cat">
          <div class="ms-soc-osint-empty">Loading...</div>
        </div>
      </div>

      <!-- AI Pattern alerts -->
      <div class="ms-rpt-card">
        <div class="ms-rpt-card-hdr">AI Pattern alerts</div>
        <div class="ms-rpt-alerts soc-rpt-ai-alerts">
          <div class="ms-soc-osint-empty">Loading...</div>
        </div>
      </div>

    </div>
  </div>

</div>
</t>
</templates>
