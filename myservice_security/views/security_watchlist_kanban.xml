<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_security_watchlist_kanban" model="ir.ui.view">
        <field name="name">security.watchlist.kanban</field>
        <field name="model">security.watchlist</field>
        <field name="arch" type="xml">
            <kanban default_order="threat_level desc" class="o_kanban_small_column">
                <field name="id"/>
                <field name="name"/>
                <field name="photo"/>
                <field name="threat_level"/>
                <field name="category"/>
                <field name="approval_state"/>
                <field name="last_sighted"/>
                <field name="last_sighted_location_id"/>
                <field name="vehicle_plate"/>
                <field name="incident_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="o_kanban_card wl-card wl-#{record.threat_level.raw_value}">

                            <!-- Threat level ribbon -->
                            <div t-attf-class="wl-ribbon wl-#{record.threat_level.raw_value}">
                                <t t-esc="record.threat_level.value"/>
                            </div>

                            <!-- Photo -->
                            <div class="wl-photo-wrap">
                                <t t-if="record.photo.raw_value">
                                    <img t-attf-src="data:image/png;base64,#{record.photo.raw_value}"
                                         class="wl-photo" alt="Subject photo"/>
                                </t>
                                <t t-else="">
                                    <div class="wl-photo-placeholder">
                                        <span t-esc="record.name.value[0].toUpperCase()"/>
                                    </div>
                                </t>
                            </div>

                            <!-- Identity -->
                            <div class="wl-body">
                                <div class="wl-name">
                                    <t t-esc="record.name.value"/>
                                </div>
                                <div class="wl-category">
                                    <t t-esc="record.category.value"/>
                                </div>

                                <!-- Last sighted -->
                                <t t-if="record.last_sighted.raw_value">
                                    <div class="wl-sighted">
                                        <svg width="10" height="10" viewBox="0 0 10 10">
                                            <circle cx="5" cy="4" r="2.5" fill="none" stroke="#888" stroke-width="1"/>
                                            <path d="M5 7 L5 9" stroke="#888" stroke-width="1"/>
                                        </svg>
                                        <t t-esc="record.last_sighted_location_id.value or 'Location unknown'"/>
                                    </div>
                                </t>

                                <!-- Vehicle -->
                                <t t-if="record.vehicle_plate.raw_value">
                                    <div class="wl-vehicle">
                                        🚗 <t t-esc="record.vehicle_plate.value"/>
                                    </div>
                                </t>

                                <!-- Incidents badge -->
                                <t t-if="record.incident_count.raw_value > 0">
                                    <div class="wl-inc-badge">
                                        <t t-esc="record.incident_count.value"/> incident<t t-if="record.incident_count.raw_value != 1">s</t>
                                    </div>
                                </t>

                                <!-- Approval state -->
                                <div t-attf-class="wl-status wl-status-#{record.approval_state.raw_value}">
                                    <t t-esc="record.approval_state.value"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Inject CSS via ir.ui.view asset override -->
    <record id="view_security_watchlist_kanban_style" model="ir.ui.view">
        <field name="name">security.watchlist.kanban.style</field>
        <field name="type">qweb</field>
        <field name="key">myservice_security.watchlist_kanban_style</field>
        <field name="arch" type="xml">
            <t t-name="myservice_security.watchlist_kanban_style">
                <style>
                .wl-card {
                    position: relative;
                    width: 180px;
                    border-radius: 10px;
                    overflow: hidden;
                    padding: 0 !important;
                    margin: 8px;
                    box-shadow: 0 2px 8px rgba(0,0,0,0.12);
                    border: none !important;
                    background: #1a1a2e;
                    transition: transform 0.2s, box-shadow 0.2s;
                }
                .wl-card:hover {
                    transform: translateY(-3px);
                    box-shadow: 0 6px 16px rgba(0,0,0,0.2);
                }
                .wl-card.wl-critical { border-top: 3px solid #dc3545 !important; }
                .wl-card.wl-high     { border-top: 3px solid #E85426 !important; }
                .wl-card.wl-medium   { border-top: 3px solid #ffc107 !important; }
                .wl-card.wl-low      { border-top: 3px solid #28a745 !important; }

                .wl-ribbon {
                    position: absolute;
                    top: 8px; right: 8px;
                    font-size: 9px;
                    font-weight: 700;
                    text-transform: uppercase;
                    padding: 2px 7px;
                    border-radius: 8px;
                    letter-spacing: 0.5px;
                    z-index: 2;
                }
                .wl-ribbon.wl-critical { background: #dc3545; color: #fff; }
                .wl-ribbon.wl-high     { background: #E85426; color: #fff; }
                .wl-ribbon.wl-medium   { background: #ffc107; color: #333; }
                .wl-ribbon.wl-low      { background: #28a745; color: #fff; }

                .wl-photo-wrap {
                    width: 100%;
                    height: 160px;
                    background: #0d1117;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    overflow: hidden;
                }
                .wl-photo {
                    width: 100%;
                    height: 160px;
                    object-fit: cover;
                    object-position: top center;
                }
                .wl-photo-placeholder {
                    width: 80px;
                    height: 80px;
                    border-radius: 50%;
                    background: #21262d;
                    border: 2px solid #30363d;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 32px;
                    font-weight: 700;
                    color: #8b949e;
                }
                .wl-body {
                    padding: 10px 12px 12px;
                    background: #161b22;
                }
                .wl-name {
                    font-size: 13px;
                    font-weight: 700;
                    color: #e6edf3;
                    margin-bottom: 2px;
                    white-space: nowrap;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }
                .wl-category {
                    font-size: 10px;
                    color: #8b949e;
                    text-transform: uppercase;
                    letter-spacing: 0.5px;
                    margin-bottom: 6px;
                }
                .wl-sighted {
                    font-size: 10px;
                    color: #8b949e;
                    margin-bottom: 3px;
                    display: flex;
                    align-items: center;
                    gap: 4px;
                    white-space: nowrap;
                    overflow: hidden;
                    text-overflow: ellipsis;
                }
                .wl-vehicle {
                    font-size: 10px;
                    color: #8b949e;
                    margin-bottom: 4px;
                }
                .wl-inc-badge {
                    display: inline-block;
                    background: rgba(232,84,38,0.15);
                    color: #E85426;
                    font-size: 10px;
                    font-weight: 600;
                    padding: 1px 7px;
                    border-radius: 8px;
                    margin-bottom: 4px;
                }
                .wl-status {
                    font-size: 9px;
                    text-transform: uppercase;
                    font-weight: 700;
                    letter-spacing: 0.5px;
                    margin-top: 4px;
                }
                .wl-status-approved  { color: #3fb950; }
                .wl-status-pending   { color: #d29922; }
                .wl-status-rejected  { color: #f85149; }

                /* Kanban container */
                .o_kanban_view .o_kanban_record.wl-card {
                    padding: 0 !important;
                }
                .o_kanban_view.o_kanban_small_column .o_kanban_group {
                    display: none !important;
                }
                /* Ungrouped kanban — show as grid */
                .o_kanban_view:not(.o_kanban_grouped) .o_kanban_record {
                    width: 180px !important;
                }
                </style>
            </t>
        </field>
    </record>

    <!-- Update the action to default to kanban -->
    <record id="action_security_watchlist" model="ir.actions.act_window">
        <field name="name">Watchlist</field>
        <field name="res_model">security.watchlist</field>
        <field name="view_mode">kanban,list,form</field>
        <field name="context">{'search_default_approved': 1}</field>
    </record>

</odoo>
