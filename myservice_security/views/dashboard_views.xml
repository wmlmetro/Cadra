<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- SOC Dashboard → Incident list (replaces broken JS dashboard) -->
    <record id="action_security_dashboard" model="ir.actions.act_window">
        <field name="name">Security Overview</field>
        <field name="res_model">security.incident</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state','not in',['closed'])]</field>
        <field name="context">{'search_default_group_by_state': 1}</field>
    </record>

    <!-- Security Operations → Guard list -->
    <record id="action_security_operations" model="ir.actions.act_window">
        <field name="name">Security Operations</field>
        <field name="res_model">security.guard</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Case Management → Incident list escalated -->
    <record id="action_case_management" model="ir.actions.act_window">
        <field name="name">Case Management</field>
        <field name="res_model">security.incident</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state','in',['escalated','investigating'])]</field>
    </record>

</odoo>
