<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_security_duty_roster_list" model="ir.ui.view">
        <field name="name">security.duty.roster.list</field>
        <field name="model">security.duty.roster</field>
        <field name="arch" type="xml">
            <list string="Duty Roster"
                  decoration-success="status=='active'"
                  decoration-muted="status in ('completed','absent')">
                <field name="date"/>
                <field name="guard_id"/>
                <field name="location_id"/>
                <field name="shift"/>
                <field name="status" widget="badge"
                    decoration-success="status=='active'"
                    decoration-info="status=='scheduled'"
                    decoration-muted="status=='completed'"
                    decoration-danger="status=='absent'"/>
                <field name="check_in"/>
                <field name="check_out"/>
                <button name="action_check_in" string="Check In" type="object"
                    class="btn-sm btn-success"
                    invisible="status != 'scheduled'"/>
                <button name="action_check_out" string="Check Out" type="object"
                    class="btn-sm btn-secondary"
                    invisible="status != 'active'"/>
            </list>
        </field>
    </record>

    <record id="view_security_duty_roster_form" model="ir.ui.view">
        <field name="name">security.duty.roster.form</field>
        <field name="model">security.duty.roster</field>
        <field name="arch" type="xml">
            <form string="Duty Roster">
                <header>
                    <button name="action_check_in" string="Check In" type="object"
                        class="btn-primary"
                        invisible="status != 'scheduled'"/>
                    <button name="action_check_out" string="Check Out" type="object"
                        class="btn-secondary"
                        invisible="status != 'active'"/>
                    <button name="action_mark_absent" string="Mark Absent" type="object"
                        invisible="status not in ['scheduled', 'active']"/>
                    <field name="status" widget="statusbar"
                        statusbar_visible="scheduled,active,completed"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="guard_id" options="{'no_create': True}"/>
                            <field name="location_id" options="{'no_create': True}"/>
                            <field name="date"/>
                            <field name="shift"/>
                        </group>
                        <group>
                            <field name="check_in"/>
                            <field name="check_out"/>
                        </group>
                    </group>
                    <group string="Checkpoint Log">
                        <field name="checkpoint_log" nolabel="1"
                            widget="text" placeholder="Checkpoint entries logged here..."/>
                        <button name="action_add_checkpoint" string="Add Checkpoint"
                            type="object" class="btn-sm btn-secondary"/>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_security_duty_roster" model="ir.actions.act_window">
        <field name="name">Duty Roster</field>
        <field name="res_model">security.duty.roster</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('date','=',context_today().strftime('%Y-%m-%d'))]</field>
    </record>

    <record id="action_security_duty_roster_all" model="ir.actions.act_window">
        <field name="name">All Rosters</field>
        <field name="res_model">security.duty.roster</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
