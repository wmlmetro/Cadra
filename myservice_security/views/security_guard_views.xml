<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_security_guard_list" model="ir.ui.view">
        <field name="name">security.guard.list</field>
        <field name="model">security.guard</field>
        <field name="arch" type="xml">
            <list string="Security Guards" decoration-muted="not is_active">
                <field name="badge_number"/>
                <field name="name"/>
                <field name="specialisation"/>
                <field name="home_location_id"/>
                <field name="phone"/>
                <field name="vendor_id"/>
                <field name="on_duty" widget="boolean_toggle"/>
                <field name="is_active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="view_security_guard_form" model="ir.ui.view">
        <field name="name">security.guard.form</field>
        <field name="model">security.guard</field>
        <field name="arch" type="xml">
            <form string="Security Guard">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_duties" type="object"
                            class="oe_stat_button" icon="fa-calendar">
                            <field name="duty_count" widget="statinfo" string="Duties"/>
                        </button>
                    </div>
                    <field name="photo" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                        <h2><field name="badge_number"/></h2>
                    </div>
                    <group>
                        <group string="Profile">
                            <field name="partner_id" options="{'no_create': True}"/>
                            <field name="phone"/>
                            <field name="email"/>
                            <field name="specialisation"/>
                            <field name="is_active" widget="boolean_toggle"/>
                            <field name="on_duty" widget="boolean_toggle"/>
                        </group>
                        <group string="Assignment">
                            <field name="home_location_id" options="{'no_create': True}"/>
                            <field name="vendor_id" options="{'no_create': True}"/>
                            <field name="contract_start"/>
                            <field name="contract_end"/>
                        </group>
                    </group>
                    <group string="Notes">
                        <field name="notes" nolabel="1"/>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_security_guard" model="ir.actions.act_window">
        <field name="name">Guards</field>
        <field name="res_model">security.guard</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

</odoo>
