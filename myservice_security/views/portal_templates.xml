<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_report_incident" name="Report Security Incident">
        <t t-call="website.layout">
            <div class="container mt-4">
                <h2>Report a Security Incident</h2>
                <t t-if="submitted">
                    <div class="alert alert-success">
                        <strong>Thank you.</strong> Your incident report has been submitted and will be reviewed by the security team.
                    </div>
                </t>
                <t t-elif="error">
                    <div class="alert alert-danger"><t t-esc="error"/></div>
                </t>
                <t t-if="not submitted">
                    <form method="POST" action="/security/incident/report">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <div class="form-group">
                            <label>Incident Type *</label>
                            <select name="incident_type" class="form-control" required="required">
                                <t t-foreach="incident_types" t-as="itype">
                                    <option t-att-value="itype[0]"><t t-esc="itype[1]"/></option>
                                </t>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Severity *</label>
                            <select name="severity" class="form-control" required="required">
                                <option value="low">Low</option>
                                <option value="medium" selected="selected">Medium</option>
                                <option value="high">High</option>
                                <option value="critical">Critical</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Location *</label>
                            <select name="location_id" class="form-control" required="required">
                                <option value="">— Select location —</option>
                                <t t-foreach="locations" t-as="loc">
                                    <option t-att-value="loc.id"><t t-esc="loc.name"/></option>
                                </t>
                            </select>
                        </div>
                        <div class="form-group">
                            <label>Your Name</label>
                            <input type="text" name="reporter_name" class="form-control" placeholder="Your full name"/>
                        </div>
                        <div class="form-group">
                            <label>Your Phone</label>
                            <input type="text" name="reporter_phone" class="form-control" placeholder="Your phone number"/>
                        </div>
                        <div class="form-group">
                            <label>Description *</label>
                            <textarea name="description" class="form-control" rows="5"
                                required="required" placeholder="Describe what happened..."/>
                        </div>
                        <div class="form-group">
                            <label>Suspect Description</label>
                            <textarea name="suspect_description" class="form-control" rows="3"
                                placeholder="Physical description, clothing, vehicle plate..."/>
                        </div>
                        <button type="submit" class="btn btn-danger">Submit Incident Report</button>
                    </form>
                </t>
            </div>
        </t>
    </template>
</odoo>
