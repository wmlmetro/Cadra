    <menuitem id="menu_security_access_all" name="All Access Logs"
        parent="menu_security_root" sequence="31"
        action="action_security_access_log_all"/>

    <menuitem id="menu_security_duty_today" name="Duty Roster — Today"
        parent="menu_security_root" sequence="40"
