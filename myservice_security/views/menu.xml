    <menuitem id="menu_security_guards" name="Guards"
        parent="menu_security_root" sequence="20"
        action="action_security_guard"/>

    <menuitem id="menu_security_access_today" name="Access Log — Today"
        parent="menu_security_root" sequence="30"
