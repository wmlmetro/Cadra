<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Root app menu — renamed via DB to "Security & Safety" -->
    <menuitem id="menu_security_root" name="Security"
        sequence="5"
        action="action_security_dashboard"
        web_icon="myservice_security,static/src/img/icon.svg"/>

    <!-- Sub-menus hidden: accessed via Security Command Center tabs instead -->
    <menuitem id="menu_security_dashboard" name="Dashboard"
        parent="menu_security_root" sequence="1"
        action="action_security_dashboard" active="0"/>

    <menuitem id="menu_security_incidents" name="Incidents"
        parent="menu_security_root" sequence="10"
        action="action_security_incident" active="0"/>

    <menuitem id="menu_security_access_today" name="Access Log — Today"
        parent="menu_security_root" sequence="20"
