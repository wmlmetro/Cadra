<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_security_osint_list" model="ir.ui.view">
        <field name="name">security.osint.feed.list</field>
        <field name="model">security.osint.feed</field>
        <field name="arch" type="xml">
            <tree string="OSINT Intelligence Feed">
                <field name="date"/>
                <field name="source_type"/>
                <field name="source_name"/>
                <field name="title"/>
                <field name="threat_level"/>
                <field name="state_name"/>
                <field name="location_id"/>
                <field name="is_verified"/>
                <field name="added_by"/>
            </tree>
        </field>
    </record>

    <record id="view_security_osint_form" model="ir.ui.view">
        <field name="name">security.osint.feed.form</field>
        <field name="model">security.osint.feed</field>
        <field name="arch" type="xml">
            <form string="OSINT Intelligence Entry">
                <sheet>
                    <group>
                        <group string="Source">
                            <field name="source_type"/>
                            <field name="source_name" placeholder="e.g. NPF, DSS, Internal"/>
                            <field name="url"/>
                            <field name="date"/>
                            <field name="is_verified"/>
                            <field name="added_by"/>
                        </group>
                        <group string="Threat Assessment">
                            <field name="threat_level"/>
                            <field name="location_id" options="{'no_create': True}"/>
                            <field name="state_name"/>
                        </group>
                    </group>
                    <group string="Intelligence Report">
                        <field name="title" nolabel="1" placeholder="Headline / Title..."/>
                        <field name="summary" nolabel="1" placeholder="Summary of intelligence..." widget="text"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_security_osint_search" model="ir.ui.view">
        <field name="name">security.osint.feed.search</field>
        <field name="model">security.osint.feed</field>
        <field name="arch" type="xml">
            <search>
                <field name="title"/>
                <field name="source_name"/>
                <field name="state_name"/>
                <filter name="critical" string="Critical" domain="[('threat_level','=','critical')]"/>
                <filter name="high" string="High" domain="[('threat_level','=','high')]"/>
                <filter name="verified" string="Verified" domain="[('is_verified','=',True)]"/>
                <filter name="manual" string="Manual Intel" domain="[('source_type','=','manual')]"/>
                <group expand="0" string="Group By">
                    <filter name="by_source" string="Source Type" context="{'group_by':'source_type'}"/>
                    <filter name="by_threat" string="Threat Level" context="{'group_by':'threat_level'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="view_security_state_threat_list" model="ir.ui.view">
        <field name="name">security.state.threat.list</field>
        <field name="model">security.state.threat</field>
        <field name="arch" type="xml">
            <tree string="State Threat Levels" editable="top">
                <field name="name"/>
                <field name="threat_level"/>
                <field name="notes"/>
                <field name="last_updated"/>
            </tree>
        </field>
    </record>

    <record id="action_security_osint" model="ir.actions.act_window">
        <field name="name">OSINT Feed</field>
        <field name="res_model">security.osint.feed</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_security_osint_search"/>
    </record>

    <record id="action_security_state_threats" model="ir.actions.act_window">
        <field name="name">State Threat Levels</field>
        <field name="res_model">security.state.threat</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
