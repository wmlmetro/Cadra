<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Handoff 64 §2. A photo taken for an asset that does not exist yet
         waits 24 hours for a save to claim it (`nrs.ai.pending.photo`);
         this deletes the ones nobody claimed. The suggestion made from one
         keeps the photo's hash. -->
    <data noupdate="1">
        <record id="cron_ai_pending_photo_purge" model="ir.cron">
            <field name="name">AI identification — delete unclaimed photos past their 24 hours</field>
            <field name="model_id" ref="model_nrs_ai_pending_photo"/>
            <field name="state">code</field>
            <field name="code">model._cron_purge_expired()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>
    </data>
</odoo>
