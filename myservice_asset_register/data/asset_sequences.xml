<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_nrs_asset" model="ir.sequence">
            <field name="name">NRS Asset Code</field>
            <field name="code">nrs.asset</field>
            <field name="prefix">NRS-AST-</field>
            <field name="padding">6</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="seq_nrs_asset_change_request" model="ir.sequence">
            <field name="name">NRS Asset Change Request</field>
            <field name="code">nrs.asset.change.request</field>
            <field name="prefix">CR/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_nrs_asset_transfer" model="ir.sequence">
            <field name="name">NRS Asset Transfer</field>
            <field name="code">nrs.asset.transfer</field>
            <field name="prefix">TRF/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
