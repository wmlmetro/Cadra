<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Handoff 63 §1. The SAP mirror's import runs as TICKS of this cron
         (`nrs.sap.import.run._cron_process_imports`): each reads for at most
         25 s of CPU, commits, and triggers the cron again while the run has
         more to read, so `limit_time_cpu` can kill a tick and never a run.
         The five-minute interval is the fallback that resumes a killed tick;
         with nothing queued a tick is one indexed query. -->
    <data noupdate="1">
        <record id="cron_sap_mirror_import" model="ir.cron">
            <field name="name">SAP mirror — read the queued asset-master import</field>
            <field name="model_id" ref="model_nrs_sap_import_run"/>
            <field name="state">code</field>
            <field name="code">model._cron_process_imports()</field>
            <field name="interval_number">5</field>
            <field name="interval_type">minutes</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>
    </data>
</odoo>
