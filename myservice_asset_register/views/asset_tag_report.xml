<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════
         SMALL LABEL — 50 x 25 mm — asset code + Code128 only
         ═══════════════════════════════════════════════════════════ -->
    <template id="report_asset_tag_label_small">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="tag">
                <div style="
                    width: 100%; height: 100%;
                    font-family: 'DM Mono', 'Courier New', monospace;
                    border: 1px solid #D0D0D0;
                    padding: 2mm;
                    box-sizing: border-box;
                    text-align: center;
                    page-break-after: always;
                    background: #fff;
                ">
                    <img t-attf-src="/report/barcode/?type=Code128&amp;value={{tag.name}}&amp;width=400&amp;height=80"
                         style="width: 100%; height: 12mm;" alt="barcode"/>
                    <div style="font-size: 8px; font-weight: bold; letter-spacing: 1px; margin-top: 1px;">
                        <t t-esc="tag.name"/>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <!-- ═══════════════════════════════════════════════════════════
         MEDIUM LABEL — 85 x 55 mm (default)
         NRS red header, company logo, asset code, name, Code128
         ═══════════════════════════════════════════════════════════ -->
    <template id="report_asset_tag_label">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="tag">
                <t t-set="company" t-value="tag.env['res.company'].sudo().search([], limit=1)"/>
                <div style="
                    width: 100%; height: 100%;
                    font-family: 'DM Sans', Arial, sans-serif;
                    border: 1px solid #D0D0D0;
                    box-sizing: border-box;
                    page-break-after: always;
                    background: #fff;
                ">
                    <!-- NRS Red header with logo -->
                    <div style="
                        background: #C8102E; color: #fff;
                        font-size: 7px; font-weight: 700;
                        padding: 3px 6px; letter-spacing: 0.5px;
                        display: flex; align-items: center;
                    ">
                        <t t-if="company.logo">
                            <img t-attf-src="data:image/png;base64,{{company.logo.decode('utf-8')}}"
                                 style="height: 12px; margin-right: 6px;" alt="logo"/>
                        </t>
                        <span style="font-weight: 900;">NRS</span>
                        <span style="margin-left: 4px; font-weight: 400;">FACILITIES MANAGEMENT</span>
                    </div>

                    <div style="padding: 2mm 3mm;">
                        <!-- Asset name -->
                        <div style="font-size: 9px; font-weight: 700; color: #1A1A1A; margin-bottom: 2px; line-height: 1.2;">
                            <t t-esc="(tag.asset_id.name or '')[:45]"/>
                        </div>

                        <!-- Code128 Barcode -->
                        <div style="text-align: center; margin: 2px 0;">
                            <img t-attf-src="/report/barcode/?type=Code128&amp;value={{tag.name}}&amp;width=600&amp;height=100"
                                 style="width: 100%; height: 14mm;" alt="barcode"/>
                            <div style="font-family: 'DM Mono', 'Courier New', monospace; font-size: 8px; font-weight: 700; letter-spacing: 1.5px; margin-top: 1px;">
                                <t t-esc="tag.name"/>
                            </div>
                        </div>

                        <!-- Details -->
                        <table style="width: 100%; font-size: 6.5px; border-collapse: collapse; margin-top: 2px;">
                            <tr>
                                <td style="color: #888; width: 30%;">Category</td>
                                <td style="color: #1A1A1A; font-weight: 600;">
                                    <t t-esc="tag.asset_id.category_id.name if tag.asset_id.category_id else ''"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="color: #888;">Location</td>
                                <td style="color: #1A1A1A; font-weight: 600;">
                                    <t t-esc="(tag.asset_id.location_id.name or '')[:30]"/>
                                </td>
                            </tr>
                        </table>

                        <!-- Footer -->
                        <div style="border-top: 0.5px solid #eee; margin-top: 2px; padding-top: 1px; font-size: 5.5px; color: #aaa;">
                            <span t-esc="tag.asset_id.asset_code"/>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <!-- ═══════════════════════════════════════════════════════════
         LARGE LABEL — 100 x 60 mm
         Full: NRS red header + logo, name, category, location,
         serial, Code128 + QR code
         ═══════════════════════════════════════════════════════════ -->
    <template id="report_asset_tag_label_large">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="tag">
                <t t-set="company" t-value="tag.env['res.company'].sudo().search([], limit=1)"/>
                <t t-set="qr_data" t-value="'%s|%s|%s' % (tag.asset_id.asset_code or '', tag.asset_id.serial_number or '', tag.asset_id.location_id.name if tag.asset_id.location_id else '')"/>
                <div style="
                    width: 100%; height: 100%;
                    font-family: 'DM Sans', Arial, sans-serif;
                    border: 1px solid #D0D0D0;
                    box-sizing: border-box;
                    page-break-after: always;
                    background: #fff;
                ">
                    <!-- NRS Red header with logo -->
                    <div style="
                        background: #C8102E; color: #fff;
                        font-size: 8px; font-weight: 700;
                        padding: 4px 8px; letter-spacing: 0.5px;
                        display: flex; align-items: center;
                    ">
                        <t t-if="company.logo">
                            <img t-attf-src="data:image/png;base64,{{company.logo.decode('utf-8')}}"
                                 style="height: 14px; margin-right: 8px;" alt="logo"/>
                        </t>
                        <span style="font-weight: 900; font-size: 10px;">NRS</span>
                        <span style="margin-left: 6px; font-weight: 400;">NIGERIA REVENUE SERVICE — FACILITIES MANAGEMENT</span>
                    </div>

                    <div style="padding: 2mm 3mm;">
                        <!-- Asset name -->
                        <div style="font-size: 11px; font-weight: 700; color: #1A1A1A; margin-bottom: 3px; line-height: 1.3;">
                            <t t-esc="(tag.asset_id.name or '')[:55]"/>
                        </div>

                        <!-- Barcodes row: Code128 left, QR right -->
                        <table style="width: 100%; margin: 3px 0;">
                            <tr>
                                <td style="text-align: center; vertical-align: top; width: 65%;">
                                    <img t-attf-src="/report/barcode/?type=Code128&amp;value={{tag.name}}&amp;width=600&amp;height=100"
                                         style="width: 100%; height: 16mm;" alt="barcode"/>
                                    <div style="font-family: 'DM Mono', 'Courier New', monospace; font-size: 9px; font-weight: 700; letter-spacing: 1.5px; margin-top: 1px;">
                                        <t t-esc="tag.name"/>
                                    </div>
                                </td>
                                <td style="text-align: center; vertical-align: top; width: 35%; padding-left: 4px;">
                                    <img t-attf-src="/report/barcode/?type=QR&amp;value={{qr_data}}&amp;width=150&amp;height=150"
                                         style="width: 18mm; height: 18mm;" alt="QR"/>
                                </td>
                            </tr>
                        </table>

                        <!-- Details grid -->
                        <table style="width: 100%; font-size: 7.5px; border-collapse: collapse; margin-top: 2px;">
                            <tr>
                                <td style="color: #888; width: 25%;">Category</td>
                                <td style="color: #1A1A1A; font-weight: 600; width: 25%;">
                                    <t t-esc="tag.asset_id.category_id.name if tag.asset_id.category_id else ''"/>
                                </td>
                                <td style="color: #888; width: 20%;">Serial No.</td>
                                <td style="font-family: 'DM Mono', monospace; color: #1A1A1A;">
                                    <t t-esc="tag.asset_id.serial_number or ''"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="color: #888;">Location</td>
                                <td style="color: #1A1A1A; font-weight: 600;" colspan="3">
                                    <t t-esc="(tag.asset_id.location_id.name or '')[:45]"/>
                                    <t t-if="tag.asset_id.floor_room">
                                        <span style="color: #888;"> / </span>
                                        <t t-esc="tag.asset_id.floor_room"/>
                                    </t>
                                </td>
                            </tr>
                            <tr>
                                <td style="color: #888;">Custodian</td>
                                <td style="color: #1A1A1A;" colspan="3">
                                    <t t-esc="(tag.asset_id.custodian_id.name or '')[:40]"/>
                                </td>
                            </tr>
                        </table>

                        <!-- Footer -->
                        <div style="border-top: 0.5px solid #eee; margin-top: 3px; padding-top: 1px; font-size: 6px; color: #aaa;">
                            <span>myservice.com.ng/a/<t t-esc="tag.asset_id.asset_code"/></span>
                            <span style="float: right;" t-esc="tag.asset_id.asset_code"/>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <!-- ═══════════════════════════════════════════════════════════
         A4 SHEET — 8 labels per page (2 cols x 4 rows)
         ═══════════════════════════════════════════════════════════ -->
    <template id="report_asset_tag_label_sheet">
        <t t-call="web.html_container">
            <t t-set="company" t-value="docs[0].env['res.company'].sudo().search([], limit=1) if docs else False"/>
            <t t-set="chunks" t-value="[docs[i:i+8] for i in range(0, len(docs), 8)]"/>
            <t t-foreach="chunks" t-as="chunk">
                <div style="
                    display: grid;
                    grid-template-columns: 1fr 1fr;
                    gap: 6px;
                    padding: 8px;
                    page-break-after: always;
                ">
                    <t t-foreach="chunk" t-as="tag">
                        <div style="
                            border: 1px solid #D0D0D0;
                            font-family: 'DM Sans', Arial, sans-serif;
                            height: 62mm;
                            box-sizing: border-box;
                            overflow: hidden;
                            background: #fff;
                        ">
                            <!-- NRS Red header -->
                            <div style="
                                background: #C8102E; color: #fff;
                                font-size: 6.5px; font-weight: 700;
                                padding: 2px 5px; letter-spacing: 0.4px;
                                display: flex; align-items: center;
                            ">
                                <t t-if="company and company.logo">
                                    <img t-attf-src="data:image/png;base64,{{company.logo.decode('utf-8')}}"
                                         style="height: 10px; margin-right: 4px;" alt="logo"/>
                                </t>
                                <span style="font-weight: 900;">NRS</span>
                                <span style="margin-left: 3px; font-weight: 400;">FACILITIES MANAGEMENT</span>
                            </div>

                            <div style="padding: 2mm 3mm;">
                                <!-- Name -->
                                <div style="font-size: 8px; font-weight: 700; color: #1A1A1A; margin-bottom: 2px; line-height: 1.2;">
                                    <t t-esc="(tag.asset_id.name or '')[:40]"/>
                                </div>
                                <!-- Barcode -->
                                <div style="text-align: center; margin: 2px 0;">
                                    <img t-attf-src="/report/barcode/?type=Code128&amp;value={{tag.name}}&amp;width=500&amp;height=80"
                                         style="width: 100%; height: 12mm;" alt="barcode"/>
                                    <div style="font-family: 'DM Mono', 'Courier New', monospace; font-size: 7px; font-weight: 700; letter-spacing: 1px; margin-top: 1px;">
                                        <t t-esc="tag.name"/>
                                    </div>
                                </div>
                                <!-- Details -->
                                <table style="width:100%; font-size:6px; border-collapse:collapse; margin-top:2px;">
                                    <tr>
                                        <td style="color:#888; width:30%;">Category</td>
                                        <td style="font-weight:600;">
                                            <t t-esc="tag.asset_id.category_id.name if tag.asset_id.category_id else ''"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="color:#888;">Location</td>
                                        <td style="font-weight:600;">
                                            <t t-esc="(tag.asset_id.location_id.name or '')[:30]"/>
                                        </td>
                                    </tr>
                                </table>
                                <div style="border-top:0.5px solid #eee; margin-top:2px; padding-top:1px; font-size:5px; color:#aaa;">
                                    <span t-esc="tag.asset_id.asset_code"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
