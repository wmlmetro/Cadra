<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════
         SMALL LABEL — 50 x 25 mm — asset code + Code128 only
         ═══════════════════════════════════════════════════════════ -->
    <template id="report_asset_tag_label_small">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="tag_val" t-value="o.asset_tag or ''"/>
                <div t-attf-style="
                    width: 100%; height: 100%;
                    font-family: 'DM Mono', 'Courier New', monospace;
                    border: 1px solid #D0D0D0;
                    padding: 2mm;
                    box-sizing: border-box;
                    text-align: center;
                    background: #fff;
                    {{ 'page-break-after: always;' if not o_last else '' }}
                ">
                    <img t-if="tag_val"
                         t-att-src="'data:image/png;base64,' + o.get_barcode_base64('Code128', tag_val, width=400, height=80, humanreadable=1)"
                         style="width: 100%; height: 12mm;" alt="barcode"/>
                    <div style="font-size: 8px; font-weight: bold; letter-spacing: 1px; margin-top: 1px;">
                        <t t-esc="tag_val"/>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <!-- ═══════════════════════════════════════════════════════════
         PRINT TAG — 50 x 30 mm  (Option C)
         Red left bar | NRS | name | labeled tag + asset codes |
         Code128 + QR barcodes | decoded legend
         ═══════════════════════════════════════════════════════════ -->
    <template id="report_asset_tag_label">
        <t t-call="web.html_container">
            <style>
                body.container { padding: 0 !important; margin: 0 !important; width: 100% !important; }
                #wrapwrap, #wrapwrap > main { padding: 0; margin: 0; }
            </style>
            <t t-set="company" t-value="env.company"/>
            <t t-foreach="docs" t-as="o">
                <t t-set="tag_val" t-value="o.asset_tag or ''"/>
                <div t-attf-style="
                    width: 100%; height: 28mm;
                    font-family: Arial, Helvetica, sans-serif;
                    box-sizing: border-box;
                    background: #fff;
                    overflow: hidden;
                    {{ 'page-break-after: always;' if not o_last else '' }}
                ">
                    <table style="width: 100%; height: 100%; border-collapse: collapse;" cellpadding="0" cellspacing="0">
                        <tr>
                            <!-- Red vertical bar -->
                            <td style="width: 5px; background: #C8102E;"/>
                            <!-- Content area -->
                            <td style="vertical-align: top; padding: 0.3mm 1mm 0 1.2mm;">

                                <!-- Company logo / NRS fallback -->
                                <div style="line-height: 1; margin: 0; padding: 0;">
                                    <img t-if="company.logo"
                                         t-att-src="'data:image/png;base64,' + (company.logo.decode('utf-8') if company.logo else '')"
                                         style="height: 14px; width: auto; object-fit: contain;"/>
                                    <span t-if="not company.logo"
                                          style="font-size: 8pt; font-weight: 900; color: #C8102E;">NRS</span>
                                </div>

                                <!-- TAG CODE label + value -->
                                <div style="font-size: 6pt; color: #999; text-transform: uppercase;
                                            letter-spacing: 0.5px; line-height: 1; margin: 0; padding: 0;">TAG CODE</div>
                                <div style="font-family: 'Courier New', monospace;
                                            font-size: 11pt; font-weight: 700;
                                            letter-spacing: 1px; color: #000;
                                            line-height: 1; margin: 0; padding: 0;">
                                    <t t-esc="tag_val"/>
                                </div>

                                <!-- ASSET CODE label + value -->
                                <div style="font-size: 6pt; color: #999; text-transform: uppercase;
                                            letter-spacing: 0.5px; line-height: 1; margin: 0; padding: 0;">ASSET CODE</div>
                                <div style="font-family: 'Courier New', monospace;
                                            font-size: 8pt; color: #666;
                                            line-height: 1; margin: 0; padding: 0;">
                                    <t t-esc="o.asset_code or ''"/>
                                </div>

                                <!-- Barcodes: Code128 left, QR right -->
                                <table style="width: 100%; margin-top: 0.2mm;" cellpadding="0" cellspacing="0">
                                    <tr>
                                        <td style="vertical-align: top; width: 70%;">
                                            <img t-if="tag_val"
                                                 t-att-src="'data:image/png;base64,' + o.get_barcode_base64('Code128', tag_val, width=400, height=80, humanreadable=0)"
                                                 style="width: 100%; height: 10mm; display: block;" alt="Code128"/>
                                            <div style="font-size: 6pt; color: #999; line-height: 1; margin: 0; padding: 0;">Code128</div>
                                        </td>
                                        <td style="vertical-align: top; text-align: right; width: 30%; padding-left: 1mm;">
                                            <img t-if="tag_val"
                                                 t-att-src="'data:image/png;base64,' + o.get_barcode_base64('QR', tag_val, width=80, height=80)"
                                                 style="width: 10mm; height: 10mm; display: block; margin-left: auto;" alt="QR"/>
                                            <div style="font-size: 6pt; color: #999; text-align: right; line-height: 1; margin: 0; padding: 0;">QR</div>
                                        </td>
                                    </tr>
                                </table>

                            </td>
                        </tr>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <!-- ═══════════════════════════════════════════════════════════
         LARGE LABEL — 100 x 60 mm
         Full: NRS red header + logo, name, category, location,
         serial, Code128 + QR code
         ═══════════════════════════════════════════════════════════ -->
    <template id="report_asset_tag_label_large">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-set="tag_val" t-value="o.asset_tag or ''"/>
                <t t-set="company" t-value="o.env['res.company'].sudo().search([], limit=1)"/>
                <t t-set="qr_data" t-value="'%s|%s|%s' % (o.asset_code or '', o.serial_number or '', o.location_id.name if o.location_id else '')"/>
                <div t-attf-style="
                    width: 100%; height: 100%;
                    font-family: 'DM Sans', Arial, sans-serif;
                    border: 1px solid #D0D0D0;
                    box-sizing: border-box;
                    background: #fff;
                    {{ 'page-break-after: always;' if not o_last else '' }}
                ">
                    <!-- NRS Red header with logo -->
                    <div style="
                        background: #C8102E; color: #fff;
                        font-size: 8px; font-weight: 700;
                        padding: 4px 8px; letter-spacing: 0.5px;
                        display: flex; align-items: center;
                    ">
                        <t t-if="company.logo">
                            <img t-attf-src="data:image/png;base64,{{company.logo.decode('utf-8')}}"
                                 style="height: 14px; margin-right: 8px;" alt="logo"/>
                        </t>
                        <span style="font-weight: 900; font-size: 10px;">NRS</span>
                        <span style="margin-left: 6px; font-weight: 400;">NIGERIA REVENUE SERVICE — FACILITIES MANAGEMENT</span>
                    </div>

                    <div style="padding: 2mm 3mm;">
                        <!-- Asset name -->
                        <div style="font-size: 11px; font-weight: 700; color: #1A1A1A; margin-bottom: 3px; line-height: 1.3;">
                            <t t-esc="(o.name or '')[:55]"/>
                        </div>

                        <!-- Barcodes row: Code128 left, QR right -->
                        <table style="width: 100%; margin: 3px 0;">
                            <tr>
                                <td style="text-align: center; vertical-align: top; width: 65%;">
                                    <img t-if="tag_val"
                                         t-att-src="'data:image/png;base64,' + o.get_barcode_base64('Code128', tag_val, width=600, height=100, humanreadable=1)"
                                         style="width: 100%; height: 16mm;" alt="barcode"/>
                                    <div style="font-family: 'DM Mono', 'Courier New', monospace; font-size: 9px; font-weight: 700; letter-spacing: 1.5px; margin-top: 1px;">
                                        <t t-esc="tag_val"/>
                                    </div>
                                </td>
                                <td style="text-align: center; vertical-align: top; width: 35%; padding-left: 4px;">
                                    <img t-if="qr_data"
                                         t-att-src="'data:image/png;base64,' + o.get_barcode_base64('QR', qr_data, width=150, height=150)"
                                         style="width: 18mm; height: 18mm;" alt="QR"/>
                                </td>
                            </tr>
                        </table>

                        <!-- Details grid -->
                        <table style="width: 100%; font-size: 7.5px; border-collapse: collapse; margin-top: 2px;">
                            <tr>
                                <td style="color: #888; width: 25%;">Category</td>
                                <td style="color: #1A1A1A; font-weight: 600; width: 25%;">
                                    <t t-esc="o.category_id.name if o.category_id else ''"/>
                                </td>
                                <td style="color: #888; width: 20%;">Serial No.</td>
                                <td style="font-family: 'DM Mono', monospace; color: #1A1A1A;">
                                    <t t-esc="o.serial_number or ''"/>
                                </td>
                            </tr>
                            <tr>
                                <td style="color: #888;">Location</td>
                                <td style="color: #1A1A1A; font-weight: 600;" colspan="3">
                                    <t t-esc="(o.location_id.name or '')[:45]"/>
                                    <t t-if="o.floor_room">
                                        <span style="color: #888;"> / </span>
                                        <t t-esc="o.floor_room"/>
                                    </t>
                                </td>
                            </tr>
                            <tr>
                                <td style="color: #888;">Custodian</td>
                                <td style="color: #1A1A1A;" colspan="3">
                                    <t t-esc="(o.custodian_id.name or '')[:40]"/>
                                </td>
                            </tr>
                        </table>

                        <!-- Footer -->
                        <div style="border-top: 0.5px solid #eee; margin-top: 3px; padding-top: 1px; font-size: 6px; color: #aaa;">
                            <span>myservice.com.ng/a/<t t-esc="o.asset_code"/></span>
                            <span style="float: right;" t-esc="o.asset_code"/>
                        </div>
                    </div>
                </div>
            </t>
        </t>
    </template>

    <!-- ═══════════════════════════════════════════════════════════
         A4 SHEET — 8 labels per page (2 cols x 4 rows)
         ═══════════════════════════════════════════════════════════ -->
    <template id="report_asset_tag_label_sheet">
        <t t-call="web.html_container">
            <t t-set="company" t-value="docs[0].env['res.company'].sudo().search([], limit=1) if docs else False"/>
            <t t-set="chunks" t-value="[docs[i:i+8] for i in range(0, len(docs), 8)]"/>
            <t t-foreach="chunks" t-as="chunk">
                <div style="
                    display: grid;
                    grid-template-columns: 1fr 1fr;
                    gap: 6px;
                    padding: 8px;
                    page-break-after: always;
                ">
                    <t t-foreach="chunk" t-as="o">
                        <t t-set="tag_val" t-value="o.asset_tag or ''"/>
                        <div style="
                            border: 1px solid #D0D0D0;
                            font-family: 'DM Sans', Arial, sans-serif;
                            height: 62mm;
                            box-sizing: border-box;
                            overflow: hidden;
                            background: #fff;
                        ">
                            <!-- NRS Red header -->
                            <div style="
                                background: #C8102E; color: #fff;
                                font-size: 6.5px; font-weight: 700;
                                padding: 2px 5px; letter-spacing: 0.4px;
                                display: flex; align-items: center;
                            ">
                                <t t-if="company and company.logo">
                                    <img t-attf-src="data:image/png;base64,{{company.logo.decode('utf-8')}}"
                                         style="height: 10px; margin-right: 4px;" alt="logo"/>
                                </t>
                                <span style="font-weight: 900;">NRS</span>
                                <span style="margin-left: 3px; font-weight: 400;">FACILITIES MANAGEMENT</span>
                            </div>

                            <div style="padding: 2mm 3mm;">
                                <!-- Name (truncated to 20 chars) -->
                                <div style="font-size: 8px; font-weight: 700; color: #1A1A1A; margin-bottom: 2px; line-height: 1.2;">
                                    <t t-esc="(o.name or '')[:20]"/>
                                </div>
                                <!-- Tag code (large) -->
                                <div style="font-family: 'Courier New', monospace;
                                            font-size: 9px; font-weight: 900;
                                            letter-spacing: 1px; color: #000;">
                                    <t t-esc="tag_val"/>
                                </div>
                                <!-- Asset code (small) -->
                                <div style="font-size: 5.5px; color: #888; margin-bottom: 2px;">
                                    <t t-esc="o.asset_code or ''"/>
                                </div>
                                <!-- Barcodes row: Code128 left, QR right -->
                                <table style="width: 100%; margin: 2px 0;" cellpadding="0" cellspacing="0">
                                    <tr>
                                        <td style="vertical-align: middle; width: 70%;">
                                            <img t-if="tag_val"
                                                 t-att-src="'data:image/png;base64,' + o.get_barcode_base64('Code128', tag_val, width=500, height=80, humanreadable=1)"
                                                 style="width: 100%; height: 12mm;" alt="barcode"/>
                                        </td>
                                        <td style="vertical-align: middle; text-align: right; width: 30%; padding-left: 2mm;">
                                            <img t-if="tag_val"
                                                 t-att-src="'data:image/png;base64,' + o.get_barcode_base64('QR', tag_val, width=100, height=100)"
                                                 style="width: 10mm; height: 10mm;" alt="QR"/>
                                        </td>
                                    </tr>
                                </table>
                                <!-- Floor / Room -->
                                <div t-if="o.floor_room"
                                     style="font-size: 5px; color: #666; margin-top: 1px;
                                            white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                    <t t-esc="o.floor_room"/>
                                </div>
                            </div>
                        </div>
                    </t>
                </div>
            </t>
        </t>
    </template>
</odoo>
