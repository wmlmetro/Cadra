<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- ═══════════════════════════════════════════════════════════
         ASSET TAG LABELS

         One artwork, rendered at four scales:

           ┌───────────────────────────────────────┐
           │ ▓▓▓▓▓▓▓   Apple M4                    │
           │ ▓▓ QR ▓   (GWSRW0S14)                 │
           │ ▓▓▓▓▓▓▓   NRS-AST-011933              │
           │ ‖‖‖‖‖‖‖‖‖‖‖‖‖‖‖‖‖‖‖‖‖‖‖‖‖‖‖‖‖‖‖‖‖‖‖‖‖ │
           │      [logo] Nigeria Revenue Service   │
           └───────────────────────────────────────┘

         The footer is the tenant's logo (cadra.brand_logo, else the
         company's) and the company's name. The serial line is left off when the asset has none (a `tag_id` or
         `record_only` class). The Code 128 has a row of its own across the
         whole content box: a 14-character tag is ~209 modules with its quiet
         zones, so beside the QR a module printed at ~0.14 mm — below what a
         phone camera reads; across 46 mm it is ~0.22 mm.

         Kept in step with the SPA's client-side labels
         (Frontend/artifacts/nrs-asset-register/src/lib/labels.ts) so a label
         printed from the Odoo backend matches one printed from the app, and
         with the geometry e2e/corpus/run54.mjs measures.

         LAYOUT IS TABLE-BASED ON PURPOSE. These render through wkhtmltopdf
         0.12.6, i.e. Qt WebKit — `display: flex` and CSS grid do not work
         there, and silently collapse to a stacked mess. Anything positional
         has to be a table cell with an explicit width/valign.

         Sizes are the paper format's CONTENT box, not the label's nominal
         size: the paperformats in data/asset_tag_report.xml carry margins
         (e.g. 50x30mm less 2mm sides and 1mm top/bottom = 46x28mm usable),
         and overflowing that silently pushes a second blank page per label.
         ═══════════════════════════════════════════════════════════ -->

    <template id="asset_tag_label_styles">
        <style>
            .lbl { border-collapse: collapse; width: 100%; height: 100%;
                   background: #fff; font-family: Arial, Helvetica, sans-serif;
                   color: #000; line-height: 1.2; }
            .lbl td { padding: 0; }
            .lbl-qr { display: block; }
            .lbl-name { white-space: nowrap; overflow: hidden; }
            .lbl-serial { white-space: nowrap; overflow: hidden; }
            .lbl-tag { letter-spacing: .3px; white-space: nowrap; }
            .lbl-bc { display: block; width: 100%; }
            .lbl-foot { border-collapse: collapse; margin: 0 auto; }
            .lbl-foot td { vertical-align: middle; white-space: nowrap; }
            .lbl-foot-name { font-weight: 700; }
            .lbl-cell { border: 0.3mm dashed #c8c8c8; vertical-align: top; }
        </style>
    </template>

    <!-- ── Shared body. Expects `o` (an nrs.asset) and `size`. ── -->
    <template id="asset_tag_label_body">
        <!-- Per-scale metrics. Every value is tuned against the content box
             quoted above; changing a page margin means revisiting these.
             Height: qr + bcgap + bc + footgap + foot fits the box (standard
             13 + 1 + 9 + 0.8 + 3 = 26.8 of 28 mm). The text column is what is left beside the QR
             (standard 46 − 13 − 1.5 = 31.5 mm). `bcw` is a high source width
             so the bars are not resampled unevenly on the way to 46 mm. -->
        <t t-set="cfg" t-value="{
            'small':    {'qr': '11mm', 'gap': '1.5mm', 'namefs': '6pt', 'serialfs': '5pt',
                         'tagpt': 6.5, 'bc': '7mm', 'bcgap': '0.8mm',
                         'foot': '2.6mm', 'footgap': '0.6mm', 'footfs': '4.5pt',
                         'tagmax': 23, 'bcw': 1000, 'bch': 80, 'qrpx': 200},
            '2x1':      {'qr': '11mm', 'gap': '1.5mm', 'namefs': '6pt', 'serialfs': '5pt',
                         'tagpt': 6.5, 'bc': '7mm', 'bcgap': '0.8mm',
                         'foot': '2.6mm', 'footgap': '0.6mm', 'footfs': '4.5pt',
                         'tagmax': 23, 'bcw': 1000, 'bch': 80, 'qrpx': 200},
            'standard': {'qr': '13mm', 'gap': '1.5mm', 'namefs': '7pt', 'serialfs': '5.5pt',
                         'tagpt': 7.5, 'bc': '9mm', 'bcgap': '1mm',
                         'foot': '3mm', 'footgap': '0.8mm', 'footfs': '5.25pt',
                         'tagmax': 19, 'bcw': 1000, 'bch': 80, 'qrpx': 200},
            'large':    {'qr': '26mm', 'gap': '3mm',   'namefs': '13pt', 'serialfs': '10pt',
                         'tagpt': 14.0, 'bc': '18mm', 'bcgap': '2mm',
                         'foot': '5.5mm', 'footgap': '1.5mm', 'footfs': '9.75pt',
                         'tagmax': 21, 'bcw': 1600, 'bch': 110, 'qrpx': 360}
            }[size]"/>

        <!-- Tag codes vary in length (NRS-AST-011933 vs LASG-3F-WRD-IT-042).
             `tagmax` is how many characters fit the text column at full size;
             anything longer is scaled down to fit. Shrinking is the only
             acceptable answer here — clipping or wrapping a tag code makes
             the printed label disagree with the barcode under it. -->
        <t t-set="taglen" t-value="len(o.asset_tag or '') or 1"/>
        <t t-set="tagscale" t-value="1.0 if taglen &lt;= cfg['tagmax'] else (cfg['tagmax'] * 1.0 / taglen)"/>
        <t t-set="tag_pt" t-value="round(cfg['tagpt'] * tagscale, 2)"/>
        <t t-set="tag_val" t-value="o.asset_tag or ''"/>
        <t t-set="serial" t-value="(o.serial_number or '').strip()"/>
        <t t-set="foot_name" t-value="env.company.name or ''"/>
        <!-- cadra.brand_logo is already a data: URI; company.logo is raw base64. -->
        <t t-set="brand_logo" t-value="env['ir.config_parameter'].sudo().get_param('cadra.brand_logo') or ''"/>
        <t t-set="foot_logo" t-value="brand_logo or (('data:image/png;base64,' + env.company.logo.decode('utf-8')) if env.company.logo else '')"/>

        <table class="lbl">
            <tr>
                <td t-attf-style="width: {{ cfg['qr'] }}; padding-right: {{ cfg['gap'] }};
                                  vertical-align: middle;">
                    <img t-if="tag_val"
                         t-att-src="'data:image/png;base64,' + o.get_barcode_base64('QR', tag_val, width=cfg['qrpx'], height=cfg['qrpx'])"
                         class="lbl-qr"
                         t-attf-style="width: {{ cfg['qr'] }}; height: {{ cfg['qr'] }};"
                         alt="QR"/>
                </td>
                <td style="vertical-align: middle;">
                    <div class="lbl-name" t-attf-style="font-size: {{ cfg['namefs'] }};"
                         t-out="(o.name or '')[:40]"/>
                    <div t-if="serial" class="lbl-serial" t-attf-style="font-size: {{ cfg['serialfs'] }};"
                         t-out="'(%s)' % serial"/>
                    <div class="lbl-tag" t-attf-style="font-size: {{ tag_pt }}pt;"
                         t-out="tag_val"/>
                </td>
            </tr>
            <tr>
                <td colspan="2" t-attf-style="padding-top: {{ cfg['bcgap'] }}; vertical-align: top;">
                    <img t-if="tag_val"
                         t-att-src="'data:image/png;base64,' + o.get_barcode_base64('Code128', tag_val, width=cfg['bcw'], height=cfg['bch'], humanreadable=0)"
                         class="lbl-bc" t-attf-style="height: {{ cfg['bc'] }};"
                         alt="Code128"/>
                </td>
            </tr>
            <tr t-if="foot_name or foot_logo">
                <td colspan="2" t-attf-style="padding-top: {{ cfg['footgap'] }}; height: {{ cfg['foot'] }}; vertical-align: middle;">
                    <table class="lbl-foot">
                        <tr>
                            <td t-if="foot_logo" t-attf-style="padding-right: 0.8mm;">
                                <img t-att-src="foot_logo" alt=""
                                     t-attf-style="height: {{ cfg['foot'] }}; max-width: 14mm;"/>
                            </td>
                            <td t-if="foot_name" class="lbl-foot-name"
                                t-attf-style="font-size: {{ cfg['footfs'] }};" t-out="foot_name"/>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </template>

    <!-- ═══ SMALL — 50 x 25 mm stock, 46 x 23 mm usable ═══ -->
    <template id="report_asset_tag_label_small">
        <t t-call="web.html_container">
            <t t-call="myservice_asset_register.asset_tag_label_styles"/>
            <t t-foreach="docs" t-as="o">
                <div t-attf-style="width: 100%; height: 23mm; overflow: hidden;
                                   {{ 'page-break-after: always;' if not o_last else '' }}">
                    <t t-call="myservice_asset_register.asset_tag_label_body">
                        <t t-set="size" t-value="'small'"/>
                    </t>
                </div>
            </t>
        </t>
    </template>

    <!-- ═══ 2 x 1 in — 50.8 x 25.4 mm roll (the Zebra ZT231's stock), 46.8 x 23.4 mm usable ═══ -->
    <template id="report_asset_tag_label_2x1">
        <t t-call="web.html_container">
            <t t-call="myservice_asset_register.asset_tag_label_styles"/>
            <t t-foreach="docs" t-as="o">
                <div t-attf-style="width: 100%; height: 23.4mm; overflow: hidden;
                                   {{ 'page-break-after: always;' if not o_last else '' }}">
                    <t t-call="myservice_asset_register.asset_tag_label_body">
                        <t t-set="size" t-value="'2x1'"/>
                    </t>
                </div>
            </t>
        </t>
    </template>

    <!-- ═══ STANDARD ("Print Tag") — 50 x 30 mm stock, 46 x 28 mm usable ═══ -->
    <template id="report_asset_tag_label">
        <t t-call="web.html_container">
            <t t-call="myservice_asset_register.asset_tag_label_styles"/>
            <style>
                body.container { padding: 0 !important; margin: 0 !important; width: 100% !important; }
                #wrapwrap, #wrapwrap > main { padding: 0; margin: 0; }
            </style>
            <t t-foreach="docs" t-as="o">
                <div t-attf-style="width: 100%; height: 28mm; overflow: hidden;
                                   {{ 'page-break-after: always;' if not o_last else '' }}">
                    <t t-call="myservice_asset_register.asset_tag_label_body">
                        <t t-set="size" t-value="'standard'"/>
                    </t>
                </div>
            </t>
        </t>
    </template>

    <!-- ═══ LARGE — 100 x 60 mm stock, 92 x 54 mm usable ═══ -->
    <template id="report_asset_tag_label_large">
        <t t-call="web.html_container">
            <t t-call="myservice_asset_register.asset_tag_label_styles"/>
            <t t-foreach="docs" t-as="o">
                <div t-attf-style="width: 100%; height: 54mm; overflow: hidden;
                                   {{ 'page-break-after: always;' if not o_last else '' }}">
                    <t t-call="myservice_asset_register.asset_tag_label_body">
                        <t t-set="size" t-value="'large'"/>
                    </t>
                </div>
            </t>
        </t>
    </template>

    <!-- ═══ A4 SHEET — 8 per page (2 x 4) on plain paper, cut to size ═══
         A4 less the 8mm paperformat margins leaves 194 x 281mm; with a 2mm
         gutter each cell is ~95 x 66mm, which the large artwork fits. -->
    <template id="report_asset_tag_label_sheet">
        <t t-call="web.html_container">
            <t t-call="myservice_asset_register.asset_tag_label_styles"/>
            <t t-set="chunks" t-value="[docs[i:i+8] for i in range(0, len(docs), 8)]"/>
            <t t-foreach="chunks" t-as="chunk">
                <div t-attf-style="{{ 'page-break-after: always;' if not chunk_last else '' }}">
                    <table style="width: 100%; border-collapse: separate; border-spacing: 2mm;">
                        <t t-foreach="[chunk[i:i+2] for i in range(0, len(chunk), 2)]" t-as="pair">
                            <tr>
                                <t t-foreach="pair" t-as="o">
                                    <td class="lbl-cell" style="width: 50%;">
                                        <!-- Explicit height on a div, not the cell: a
                                             percentage height inside a table cell does
                                             not resolve in Qt WebKit, and the artwork
                                             would collapse to its content. -->
                                        <div style="height: 66mm; overflow: hidden;">
                                            <t t-call="myservice_asset_register.asset_tag_label_body">
                                                <t t-set="size" t-value="'large'"/>
                                            </t>
                                        </div>
                                    </td>
                                </t>
                                <!-- Keep the final row's cell at half width when
                                     the page ends on an odd label. -->
                                <td t-if="len(pair) == 1" style="width: 50%;"/>
                            </tr>
                        </t>
                    </table>
                </div>
            </t>
        </t>
    </template>
</odoo>
