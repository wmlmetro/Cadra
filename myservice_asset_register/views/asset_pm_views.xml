<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nrs_asset_pm_tree" model="ir.ui.view">
        <field name="name">nrs.asset.pm.tree</field>
        <field name="model">nrs.asset.pm</field>
        <field name="arch" type="xml">
            <list decoration-danger="is_overdue"
                  decoration-warning="next_due_date and next_due_date &lt;= (context_today() + datetime.timedelta(days=7)).strftime('%Y-%m-%d')">
                <field name="asset_id"/>
                <field name="name"/>
                <field name="interval_days"/>
                <field name="last_done_date"/>
                <field name="next_due_date"/>
                <field name="is_overdue" widget="boolean"/>
                <field name="request_type_id"/>
                <field name="team_id"/>
                <field name="auto_create" widget="boolean"/>
                <field name="last_request_id"/>
                <button name="action_mark_done" string="Mark Done"
                        type="object" icon="fa-check"/>
            </list>
        </field>
    </record>

    <record id="view_nrs_asset_pm_form" model="ir.ui.view">
        <field name="name">nrs.asset.pm.form</field>
        <field name="model">nrs.asset.pm</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group string="Schedule">
                            <field name="name"/>
                            <field name="asset_id"/>
                            <field name="interval_days"/>
                            <field name="last_done_date"/>
                            <field name="next_due_date" readonly="1"/>
                            <field name="is_overdue" readonly="1"/>
                        </group>
                        <group string="Auto-Request">
                            <field name="auto_create"/>
                            <field name="advance_days"/>
                            <field name="request_type_id"/>
                            <field name="team_id"/>
                            <field name="service_id"/>
                            <field name="last_request_id" readonly="1"/>
                        </group>
                    </group>
                    <field name="notes" placeholder="PM notes..."/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_nrs_asset_pm" model="ir.actions.act_window">
        <field name="name">PM Schedules</field>
        <field name="res_model">nrs.asset.pm</field>
        <field name="view_mode">list,form</field>
        <field name="context">{'search_default_active': 1}</field>
    </record>

    <record id="action_nrs_asset_pm_overdue" model="ir.actions.act_window">
        <field name="name">Overdue PM Schedules</field>
        <field name="res_model">nrs.asset.pm</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('is_overdue','=',True)]</field>
    </record>

    <!-- Extend request.request form to show asset -->
    <record id="view_request_request_asset_inherit" model="ir.ui.view">
        <field name="name">request.request.asset.inherit</field>
        <field name="model">request.request</field>
        <field name="inherit_id" ref="myservice_request_core.view_request_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet//group[1]" position="after">
                <group string="Asset">
                    <field name="nrs_asset_id"/>
                    <field name="asset_code" readonly="1"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
