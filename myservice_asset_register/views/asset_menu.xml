<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Top-level menu -->
    <menuitem id="menu_asset_root"
              name="Asset Register"
              sequence="30"/>

    <menuitem id="menu_asset_register"
              name="All Assets"
              parent="menu_asset_root"
              action="action_nrs_asset"
              sequence="10"/>

    <menuitem id="menu_asset_missing"
              name="Missing / Unverified"
              parent="menu_asset_root"
              action="action_nrs_asset_missing"
              sequence="20"/>

    <menuitem id="menu_asset_transfers"
              name="Asset Transfers"
              parent="menu_asset_root"
              action="action_nrs_asset_transfer"
              sequence="30"/>

    <menuitem id="menu_asset_pm"
              name="PM Schedules"
              parent="menu_asset_root"
              action="action_nrs_asset_pm"
              sequence="40"/>

    <menuitem id="menu_asset_pm_overdue"
              name="Overdue PM"
              parent="menu_asset_root"
              action="action_nrs_asset_pm_overdue"
              sequence="50"/>

    <menuitem id="menu_asset_tags"
              name="Asset Tags"
              parent="menu_asset_root"
              action="action_nrs_asset_tags"
              sequence="60"/>

    <menuitem id="menu_asset_import"
              name="Import Assets"
              parent="menu_asset_root"
              action="action_nrs_asset_import"
              sequence="70"
              groups="myservice_asset_register.group_asset_manager"/>

    <menuitem id="menu_asset_categories"
              name="Categories"
              parent="menu_asset_root"
              action="action_nrs_asset_category"
              sequence="80"
              groups="myservice_asset_register.group_asset_manager"/>
</odoo>
