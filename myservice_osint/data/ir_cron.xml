<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_osint_fetch" model="ir.cron">
            <field name="name">OSINT — Fetch All Sources</field>
            <field name="model_id" ref="model_osint_collector"/>
            <field name="state">code</field>
            <field name="code">model.cron_fetch_all_sources()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
        <record id="cron_threat_recompute" model="ir.cron">
            <field name="name">OSINT — Recompute State Threat Scores</field>
            <field name="model_id" ref="model_osint_collector"/>
            <field name="state">code</field>
            <field name="code">model.cron_recompute_threat_scores()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
    </data>
</odoo>
