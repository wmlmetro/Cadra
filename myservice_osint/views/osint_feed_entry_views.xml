<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_osint_feed_list" model="ir.ui.view">
        <field name="name">osint.feed.entry.list</field>
        <field name="model">osint.feed.entry</field>
        <field name="arch" type="xml">
            <tree string="Intelligence Feed"
                decoration-danger="threat_level in ('critical','high')"
                decoration-warning="threat_level in ('elevated','medium')"
                decoration-info="threat_level == 'info'">
                <field name="event_date"/>
                <field name="title"/>
                <field name="source_type"/>
                <field name="source_name"/>
                <field name="state_name"/>
                <field name="threat_level" widget="badge"
                    decoration-danger="threat_level in ('critical','high')"
                    decoration-warning="threat_level in ('elevated','medium')"
                    decoration-info="threat_level == 'info'"/>
                <field name="fatalities"/>
                <field name="is_verified" widget="boolean"/>
            </tree>
        </field>
    </record>

    <record id="view_osint_feed_form" model="ir.ui.view">
        <field name="name">osint.feed.entry.form</field>
        <field name="model">osint.feed.entry</field>
        <field name="arch" type="xml">
            <form string="Intelligence Entry">
                <sheet>
                    <group>
                        <group>
                            <field name="source_type"/>
                            <field name="source_name"/>
                            <field name="threat_level"/>
                            <field name="event_type"/>
                            <field name="fatalities"/>
                        </group>
                        <group>
                            <field name="state_name"/>
                            <field name="event_date"/>
                            <field name="is_verified" widget="boolean_toggle"/>
                            <field name="source_url" widget="url"/>
                        </group>
                    </group>
                    <field name="title"/>
                    <field name="summary"/>
                    <group string="Linked Records">
                        <field name="linked_incident_id"
                            options="{'no_create':True}"/>
                        <field name="linked_watchlist_id"
                            options="{'no_create':True}"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_osint_feed_search" model="ir.ui.view">
        <field name="name">osint.feed.entry.search</field>
        <field name="model">osint.feed.entry</field>
        <field name="arch" type="xml">
            <search>
                <field name="title"/>
                <field name="state_name"/>
                <field name="source_name"/>
                <filter name="critical" string="Critical" domain="[('threat_level','=','critical')]"/>
                <filter name="high" string="High" domain="[('threat_level','=','high')]"/>
                <filter name="acled" string="ACLED" domain="[('source_type','=','acled')]"/>
                <filter name="gdelt" string="GDELT" domain="[('source_type','=','gdelt')]"/>
                <filter name="rss" string="News RSS" domain="[('source_type','=','rss')]"/>
                <filter name="unverified" string="Unverified" domain="[('is_verified','=',False)]"/>
                <group expand="0" string="Group By">
                    <filter name="by_state" string="State" context="{'group_by':'state_name'}"/>
                    <filter name="by_source" string="Source" context="{'group_by':'source_type'}"/>
                    <filter name="by_threat" string="Threat Level" context="{'group_by':'threat_level'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_osint_feed_entries" model="ir.actions.act_window">
        <field name="name">Intelligence Feed</field>
        <field name="res_model">osint.feed.entry</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_osint_feed_search"/>
    </record>
</odoo>
