<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_resource_role_link_hr_employee_form" model="ir.ui.view">
    <field name="name">resource.role.link.hr.employee.form</field>
    <field name="model">hr.employee</field>
    <field name="inherit_id" ref="hr.view_employee_form"/>
    <field name="arch" type="xml">
        <xpath expr="//div[@name='button_box']" position="inside">
            <field name="user_id" invisible="1"/>
                <button name="action_view_resource_role_links"
                        type="object"
                        class="oe_stat_button"
                        groups="generic_resource.group_generic_resource_user"
                        icon="fa-cubes"
                        attrs="{'invisible': [('user_id', '=', False)]}">
                <field name="resource_role_link_count"
                       widget="statinfo"
                       string="Resources"/>
            </button>
        </xpath>
    </field>
    </record>
</odoo>
