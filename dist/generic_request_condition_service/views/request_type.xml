<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--Form-->
    <record model="ir.ui.view" id="view_request_condition_service_request_type_form">
        <field name="name">view.request.condition.service.request.type.form</field>
        <field name="model">request.type</field>
        <field name="inherit_id" ref="generic_request_condition.view_request_condition_request_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='page_write_control']/group/field[@name='change_category_condition_ids']" position="after">
                <field name="change_service_condition_ids"
                        domain="[('model_id.model', '=', 'request.request')]"
                        context="{'default_based_on': 'request.request'}"
                        options="{'no_quick_create': True, 'open': True}"
                        widget="many2many_tags"
                        groups="generic_request.group_request_use_services"/>
            </xpath>
        </field>
    </record>
</odoo>
