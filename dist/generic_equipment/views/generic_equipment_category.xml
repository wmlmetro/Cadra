<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_generic_equipment_category_tree" model="ir.ui.view">
        <field name="model">generic.equipment.category</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="code"/>
                <field name="parent_id"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="view_generic_equipment_category_form" model="ir.ui.view">
        <field name="model">generic.equipment.category</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                    </div>
                    <field name="active" invisible="1"/>
                    <widget name="web_ribbon" title="Archived"
                            bg_color="bg-danger"
                            attrs="{'invisible': [('active', '=', True)]}"/>
                    <div class="oe_title">
                        <h1>
                            <field name="name" string="Name" placeholder="Name"/>
                        </h1>
                    </div>
                    <group name="group_root">
                        <group name="group_root_left">
                            <field name="code"/>
                            <field name="parent_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.ui.view" id="view_generic_equipment_category_search">
        <field name="model">generic.equipment.category</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="code"/>
                <field name="parent_id"/>
            </search>
        </field>
    </record>

    <record id="generic_equipment_category_action_window" model="ir.actions.act_window">
        <field name="name">Equipment Categories</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">generic.equipment.category</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_generic_equipment_categories"
              name="Categories"
              parent="menu_generic_equipment_configuration_root"
              action="generic_equipment_category_action_window"/>
</odoo>
