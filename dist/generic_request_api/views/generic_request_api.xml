<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="request_api_endpoint_tree" model="ir.ui.view">
        <field name="model">request.api.endpoint</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="slug"/>
                <field name="url"/>
                <field name="type"/>
                <field name="request_creation_template_id"/>
                <field name="request_type_id"/>
                <field name="active"/>
            </tree>
        </field>
    </record>

    <record id="request_api_endpoint_form" model="ir.ui.view">
        <field name="model">request.api.endpoint</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_button_show_api_requests"
                                type="object"
                                class="oe_stat_button" icon="fa-sitemap">
                            <field string="Requests" name="request_count"
                                   widget="statinfo"/>
                        </button>
                    </div>
                    <field name="active" invisible='True'/>
                        <widget name="web_ribbon"
                                title="Archived"
                                bg_color="bg-danger"
                                attrs="{'invisible': [('active', '=', True)]}"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Name"/></h1>
                        <h2><field name="slug" placeholder="Slug"/></h2>
                    </div>
                    <notebook>
                        <page string="Endpoint" name="page_endpoint">
                            <group>
                                <group name="group_left">
                                    <field name="url_full" widget="CopyClipboardChar"/>
                                    <field name="url_api_help"
                                           string="API Docs"
                                           text="View Docs"
                                           options="{'website_path': True}"
                                           attrs="{'invisible': [('type', '!=', 'rest')]}"
                                           widget="url"/>
                                    <field name="type"/>
                                    <field name="public_sudo_user_id"
                                           string="Sudo User"
                                           attrs="{'required': [('type', '=', 'public')]}"/>
                                    <field name="on_success"
                                           attrs="{'required': [('type', 'in', ['internal', 'public'])], 'invisible': [('type', '=', 'rest')]}"/>
                                    <field name="on_success_redirect_url"
                                           attrs="{'invisible': [('on_success', '!=', 'redirect_url')], 'required': [('on_success', '=', 'redirect_url')]}"/>
                                </group>
                                <group name="group_right">
                                </group>
                            </group>
                        </page>
                        <page string="Request Data" name="page_request">
                            <group>
                                <field name="request_creation_template_id"/>
                                <field name="request_type_id"/>
                            </group>
                        </page>
                        <page string="Authorization" name="page_authorization"
                              attrs="{'invisible': [('type', '!=', 'rest')]}">
                            <div class="alert alert-warning"
                                 name="alert_message"
                                 role="alert"
                                 attrs="{'invisible': [('api_key_ids', '!=', [])]}">
                                If there are no api_keys defined, then endpoint is treated as publicly available.
                                Add access keys to make this endpoint secure.
                            </div>
                            <button title="Add Access Key"
                                    string="Add Access Key"
                                    class="btn-secondary mx-1 mb-3"
                                    type="object"
                                    name="action_add_access_key"
                                    icon="fa-key"/>
                            <group name="api_keys">
                                <div attrs="{'invisible': [('api_key_ids', '=', [])]}">
                                    <field name="api_key_ids"
                                           nolabel="1"
                                           mode="tree">
                                        <tree create="false">
                                            <field name="name"/>
                                            <field name="use_sudo"/>
                                            <field name="sudo_user_id"/>
                                        </tree>
                                        <form create="false">
                                            <group>
                                                <field name="name"/>
                                                <field name="use_sudo"/>
                                                <field name="sudo_user_id"
                                                       password="True"
                                                       attrs="{'invisible': [('use_sudo', '=', False)]}"/>
                                            </group>
                                        </form>
                                    </field>
                                </div>
                            </group>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="request_api_endpoint_search" model="ir.ui.view">
        <field name="model">request.api.endpoint</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="slug"/>

                <filter name="filter_archived"
                        string="Archived"
                        domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_request_api_endpoint_view" model="ir.actions.act_window">
        <field name="name">API Endpoint</field>
        <field name="res_model">request.api.endpoint</field>
        <field name="view_mode">search,tree,form</field>
    </record>

    <menuitem id="menu_request_api_endpoint_view"
              parent="generic_request.menu_configuration_other"
              action="action_request_api_endpoint_view"/>

</odoo>
