<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Module category -->
    <record model="ir.module.category" id="base.module_category_generic_contract">
        <field name="name">Generic Contract</field>
        <field name="sequence">100</field>
        <field name="visible" eval="1"/>
    </record>

    <!--User Groups -->
    <record id="group_generic_contract_user_implicit" model="res.groups">
        <field name="name">Generic Contract User (implicit)</field>
        <field name="category_id" ref="base.module_category_generic_contract"/>
    </record>

    <record id="group_generic_contract_user_readonly" model="res.groups">
        <field name="name">Generic Contract User (readonly)</field>
        <field name="category_id" ref="base.module_category_generic_contract"/>
        <field name="implied_ids"
               eval="[(4, ref('generic_contract.group_generic_contract_user_implicit'))]"/>
    </record>

    <record id="group_generic_contract_user" model="res.groups">
        <field name="name">Generic Contract User</field>
        <field name="implied_ids"
               eval="[(4, ref('generic_contract.group_generic_contract_user_readonly'))]"/>
        <field name="category_id" ref="base.module_category_generic_contract"/>
    </record>

    <record id="group_generic_contract_manager" model="res.groups">
        <field name="name">Generic Contract Manager</field>
        <field name="implied_ids"
               eval="[(4, ref('generic_contract.group_generic_contract_user'))]"/>
        <field name="category_id" ref="base.module_category_generic_contract"/>
        <field name="users" eval="[(4, ref('base.user_root')), (4, ref('base.user_admin'))]"/>
    </record>

    <!-- Access rules for wizards -->
    <record id="rule_wizard_contract_create" model="ir.rule">
        <field name="name">access for wizard generic contract create</field>
        <field name="model_id" ref="generic_contract.model_generic_contract_wizard_create"/>
        <field name="domain_force">[
                ('create_uid', '=', user.id),
            ]</field>
        <field name="groups" eval="[(4, ref('generic_contract.group_generic_contract_user'))]"/>
        <field eval="1" name="perm_unlink"/>
        <field eval="1" name="perm_write"/>
        <field eval="1" name="perm_read"/>
        <field eval="1" name="perm_create"/>
    </record>

    <!-- Access rules -->
    <record id="contract_comp_rule" model="ir.rule">
        <field name="name">Contract multi-company</field>
        <field name="model_id" ref="model_generic_contract"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False),
                                    ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="contract_template_comp_rule" model="ir.rule">
        <field name="name">Contract Template multi-company</field>
        <field name="model_id" ref="model_generic_contract_template"/>
        <field name="global" eval="True"/>
        <field name="domain_force">['|', ('company_id', '=', False),
                                    ('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
