    <record id="contract_basic_support" model="generic.contract">
        <field name="name">Basic support contract</field>
        <field name="partner_type">customer</field>
        <field name="partner_id" ref="base.res_partner_2"/>
        <field name="date_start"
               eval="(DateTime.today() - timedelta(weeks=12)).strftime('%Y-%m-%d 00:00:00')"/>
        <field name="date_end"
               eval="(DateTime.today() + timedelta(weeks=20)).strftime('%Y-%m-%d 00:00:00')"/>
    </record>

