<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Extended form view for generic.service -->
    <record id="inherited_res_partner_view_form" model="ir.ui.view">
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button"
                        type="object"
                        name="action_show_partner_contracts"
                        groups="generic_contract.group_generic_contract_user"
                        icon="fa-file-o">
                    <field string="Contracts" name="generic_contract_count" widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
