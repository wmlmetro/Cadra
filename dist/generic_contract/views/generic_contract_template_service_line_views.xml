<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_generic_contract_template_service_line_tree" model="ir.ui.view">
        <field name="model">generic.contract.template.service.line</field>
        <field name="arch" type="xml">
            <tree>
                <field name="contract_template_id"/>
                <field name="service_id"/>
                <field name="service_level_id" groups="generic_service.group_use_service_level"/>
            </tree>
        </field>
    </record>

    <record id="view_generic_contract_template_service_line_form" model="ir.ui.view">
        <field name="model">generic.contract.template.service.line</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <group>
                        <field name="contract_template_id"/>
                        <field name="service_id"/>
                        <field name="service_level_id" groups="generic_service.group_use_service_level"/>
                    </group>
                </group>
            </form>
        </field>
    </record>
</odoo>
