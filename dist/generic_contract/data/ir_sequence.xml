<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Sequences for customer contracts -->
    <record id="seq_generic_contract_customer_contracts" model="ir.sequence">
        <field name="name">Customer Contracts Seq</field>
        <field name="code">generic.contract.customer.contracts</field>
        <field name="prefix">CS%(year)s%(month)s-</field>
        <field name="padding">3</field>
        <field name="company_id" eval="False"/>
    </record>

    <!-- Sequences for supplier contracts -->
    <record id="seq_generic_contract_supplier_contracts" model="ir.sequence">
        <field name="name">Supplier Contracts Seq</field>
        <field name="code">generic.contract.supplier.contracts</field>
        <field name="prefix">SS%(year)s%(month)s-</field>
        <field name="padding">3</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
