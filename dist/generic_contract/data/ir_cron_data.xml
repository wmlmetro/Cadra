<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- Creating scheduler -->
    <record id="activate_pending_contracts" model="ir.cron">
        <field name="name">Activate Pending Contracts</field>
        <field name="active" eval="True"/>
        <field name="state">code</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="model_id" ref="generic_contract.model_generic_contract"/>
        <field name="code">model.scheduler_activate_contracts()</field>
    </record>

    <record id="close_reached_contracts" model="ir.cron">
        <field name="name">Close Reached Contracts</field>
        <field name="active" eval="True"/>
        <field name="state">code</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="numbercall">-1</field>
        <field name="doall" eval="False"/>
        <field name="model_id" ref="generic_contract.model_generic_contract"/>
        <field name="code">model.scheduler_close_contracts()</field>
    </record>
</odoo>
