<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="rule_wsd_contract_service_user" model="ir.rule">
        <field name="name">Website Service Desk User: Contract Services</field>
        <field name="model_id" ref="generic_service.model_generic_service"/>
        <field name="domain_force">[
            ('active_contract_ids.partner_id', 'parent_of', user.partner_id.id),
        ]</field>
        <field name="groups" eval="[(4, ref('crnd_wsd.group_service_desk_website_user'))]"/>
        <field eval="0" name="perm_unlink"/>
        <field eval="0" name="perm_write"/>
        <field eval="1" name="perm_read"/>
        <field eval="0" name="perm_create"/>
    </record>
    <record id="rule_wsd_contract_service_categs_user" model="ir.rule">
        <field name="name">Website Service Desk User: Contract Service Categories</field>
        <field name="model_id" ref="generic_request.model_request_category"/>
        <field name="domain_force">[
            ('active_contract_ids.partner_id', 'parent_of', user.partner_id.id),
        ]</field>
        <field name="groups" eval="[(4, ref('crnd_wsd.group_service_desk_website_user'))]"/>
        <field eval="0" name="perm_unlink"/>
        <field eval="0" name="perm_write"/>
        <field eval="1" name="perm_read"/>
        <field eval="0" name="perm_create"/>
    </record>


    <!--Add to Service Desk Website User group Generic Contract User (implicit)-->
    <record id="crnd_wsd.group_service_desk_website_user" model="res.groups">
        <field name="implied_ids"
               eval="[(4, ref('generic_contract.group_generic_contract_user_implicit'))]"/>
    </record>
</odoo>
