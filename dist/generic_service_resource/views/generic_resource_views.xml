<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view for generic.resource -->
    <record id="inherited_generic_resource_view_form_inherit_service_resource" model="ir.ui.view">
        <field name="model">generic.resource</field>
        <field name="inherit_id" ref="generic_resource.generic_resource_view_form_base"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button"
                        type="object"
                        name="action_show_resource_services"
                        icon="fa-bars">
                    <field string="Services" name="service_count" widget="statinfo"/>
                </button>
            </xpath>
            <xpath expr="//group[@name='group_resource_info_right']" position="inside">
                <field name="service_ids"
                       widget="many2many_tags"/>
            </xpath>
        </field>
    </record>
</odoo>
