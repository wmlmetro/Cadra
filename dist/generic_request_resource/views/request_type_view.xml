<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="inherited_view_request_type_form_inherit_request_resource">
        <field name="model">request.type</field>
        <field name="inherit_id" ref="generic_request.view_request_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_settings']" position="inside">
                <group name="group_settings_resource" string="Resource">
                    <field name="resource_type_ids"
                           widget="many2many_tags"/>
                    <field name="resource_required" widget="boolean_toggle"/>
                    <field name="resource_invisible" widget="boolean_toggle"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
