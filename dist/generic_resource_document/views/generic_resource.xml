<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Form view for generic.resource -->
    <record id="generic_resource_view_form" model="ir.ui.view">
        <field name="model">generic.resource</field>
        <field name="inherit_id" ref="generic_resource.generic_resource_view_form_base"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button"
                        type="object"
                        name="action_show_resource_attachments"
                        icon="fa-file-text">
                    <field string="Documents"
                           name="resource_attachment_count"
                           widget="statinfo"/>
                </button>
            </xpath>
        </field>
    </record>
</odoo>

