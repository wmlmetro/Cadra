<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_generic_contract_service_line_tree" model="ir.ui.view">
        <field name="model">generic.contract.service.line</field>
        <field name="inherit_id" ref="generic_contract.view_generic_contract_service_line_tree"/>
        <field name="arch" type="xml">
            <field name="service_id" position="after">
                <field name="request_category_ids"
                       domain="[('service_ids.id', '=', service_id)]"
                       widget="many2many_tags"/>
            </field>
        </field>
    </record>

    <record id="view_generic_contract_service_line_form" model="ir.ui.view">
        <field name="model">generic.contract.service.line</field>
        <field name="inherit_id" ref="generic_contract.view_generic_contract_service_line_form"/>
        <field name="arch" type="xml">
            <field name="service_id" position="after">
                <field name="request_category_ids"
                       domain="[('service_ids.id', '=', service_id)]"
                       widget="many2many_tags"/>
            </field>
        </field>
    </record>
</odoo>
