<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="view_generic_contract_form">
        <field name="model">generic.contract</field>
        <field name="inherit_id" ref="generic_contract.view_generic_contract_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" type="object"
                        name="action_view_contract_requests"
                        icon="fa-comments-o">
                    <div class="o_stat_info">
                        <span class="o_stat_value">
                            <field name="contract_request_open_count" class="oe_inline"/>
                            <span class="oe_form_field oe_inline">/</span>
                            <field name="contract_request_count" class="oe_inline"/>
                        </span>
                        <span class="o_stat_text">Requests</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//form//notebook//page[@name='page_service_lines']//field[@name='service_contract_line_ids']/tree/field[@name='service_id']"
                   position="after">
                <field name="request_category_ids"
                       domain="[('service_ids.id', '=', service_id)]"
                       widget="many2many_tags"/>
            </xpath>
        </field>
    </record>

    <record model="ir.ui.view" id="view_generic_contract_tree">
        <field name="model">generic.contract</field>
        <field name="inherit_id" ref="generic_contract.view_generic_contract_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//tree//field[@name='state']" position="after">
                <field name="contract_request_count"/>
            </xpath>
        </field>
    </record>
</odoo>
