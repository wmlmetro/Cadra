<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="request_type_resource_question" model="request.type">
        <field name="name">Resource Question</field>
        <field name="code">resource_question</field>
        <field name="description">Generic questions about resources</field>
        <field name="note_html"><![CDATA[
            <p align="left" style="color: #BB7733>Do not forget to select resource.</p>
        ]]></field>
        <field name="resource_type_ids"
              eval="[(4, ref('generic_resource.generic_resource_type_default'))]"/>
    </record>

    <!--Add request.classifier-->
    <record id="classifier_request_type_res_question_demo_website_support" model="request.classifier">
        <field name="category_id" ref="crnd_wsd.request_category_demo_website_support"/>
        <field name="type_id" ref="crnd_wsd_resource.request_type_resource_question"/>
    </record>
    <record id="classifier_request_type_res_question_demo_website_general" model="request.classifier">
        <field name="category_id" ref="crnd_wsd.request_category_demo_website_general"/>
        <field name="type_id" ref="crnd_wsd_resource.request_type_resource_question"/>
        <field name="website_published" eval="True"/>
    </record>
    <!--Classifiers for "test_tour_request_new"-->
    <record id="classifier_request_type_incident_demo_website_support" model="request.classifier">
        <field name="category_id" ref="crnd_wsd.request_category_demo_website_support"/>
        <field name="type_id" ref="crnd_service_desk.request_type_incident"/>
        <field name="website_published" eval="True"/>
    </record>
    <record id="classifier_request_type_res_question_demo_website_support_support_config" model="request.classifier">
        <field name="service_id" ref="generic_service.generic_service_support_configuration"/>
        <field name="category_id" ref="crnd_wsd.request_category_demo_website_support"/>
        <field name="type_id" ref="crnd_wsd_resource.request_type_resource_question"/>
        <field name="website_published" eval="True"/>
    </record>
    <record id="classifier_request_type_res_question_demo_website_support_default" model="request.classifier">
        <field name="service_id" ref="generic_service.generic_service_default"/>
        <field name="category_id" ref="crnd_wsd.request_category_demo_website_support"/>
        <field name="type_id" ref="crnd_wsd_resource.request_type_resource_question"/>
        <field name="website_published" eval="True"/>
    </record>
    <record id="classifier_request_type_res_question_demo_website_support_rent_notebook" model="request.classifier">
        <field name="service_id" ref="generic_service.generic_service_rent_notebook"/>
        <field name="category_id" ref="crnd_wsd.request_category_demo_website_support"/>
        <field name="type_id" ref="crnd_wsd_resource.request_type_resource_question"/>
        <field name="website_published" eval="True"/>
    </record>
    <record id="classifier_request_type_res_question_demo_website_tech" model="request.classifier">
        <field name="service_id" ref="generic_service.generic_service_default"/>
        <field name="category_id" ref="crnd_wsd.request_category_demo_website_tech"/>
        <field name="type_id" ref="crnd_wsd_resource.request_type_resource_question"/>
        <field name="website_published" eval="True"/>
    </record>

    <!-- Generic request type stages -->
    <record id="request_stage_type_resource_question_new" model="request.stage">
        <field name="sequence" eval="1"/>
        <field name="name">New</field>
        <field name="code">new</field>
        <field name="request_type_id" ref="request_type_resource_question"/>
    </record>
    <record id="request_stage_type_resource_question_closed" model="request.stage">
        <field name="sequence" eval="2"/>
        <field name="name">Closed</field>
        <field name="code">closed</field>
        <field name="closed" eval="True"/>
        <field name="request_type_id" ref="request_type_resource_question"/>
    </record>

    <!-- Generic request type routes -->
    <record id="request_stage_route_type_resource_question_new_to_closed"
            model="request.stage.route">
        <field name="stage_from_id" ref="request_stage_type_resource_question_new"/>
        <field name="stage_to_id" ref="request_stage_type_resource_question_closed"/>
        <field name="request_type_id" ref="request_type_resource_question"/>
    </record>
</odoo>
