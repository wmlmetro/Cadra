<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record model="ir.ui.view" id="view_request_type_form">
        <field name="model">request.type</field>
        <field name="inherit_id" ref="generic_request.view_request_type_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_settings_resource']" position="inside">
                <field name="resource_label"
                       string="Label"/>
                <field name="resource_placeholder"
                       string="Placeholder"/>
                <field name="resource_help"
                       string="Help message"/>
            </xpath>
        </field>
    </record>
</odoo>
