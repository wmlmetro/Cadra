# ─────────────────────────────────────────────────────────────────────
# Cadra / myservicenrs — environment configuration
# ─────────────────────────────────────────────────────────────────────
#
# Copy this file to `.env` (gitignored) and edit values for your deployment.
#
# Local dev: the defaults are fine.
#   cp .env.example .env
#   docker compose -f docker-compose.yml -f docker-compose.19.yml up -d
#
# Production:  EVERY VALUE below must be overridden with a strong secret, and
#              that is now an ASSERTION rather than this sentence. The prod
#              bring-up (docker-compose.prod.yml) REFUSES TO START if
#              POSTGRES_PASSWORD, ODOO_MASTER_PASSWORD or CADRA_JWT_SECRET
#              still holds one of the placeholder values this file ships —
#              because a security position that rests on somebody having read
#              a comment is the thing a rule exists to replace.
#              Never commit your `.env` to git.
#
# The two credential defaults below are a WAIVED exception in
# tests/test_source_guards.py, which otherwise refuses a credential that
# defaults to a value anywhere in this repository. They are kept because this
# is a template whose whole job is to be edited, and because changing them
# changes the local bring-up for every checkout while buying nothing. The
# waiver names these exact variables and FAILS if it stops matching them, so
# it cannot outlive its reason or quietly widen.
#

# ─── Postgres ─────────────────────────────────────────────────────────
POSTGRES_DB=odoo
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo

# ─── Odoo ─────────────────────────────────────────────────────────────
# The Odoo "master password" — used by the database manager UI to
# create/duplicate/drop databases. For dev, `admin` is fine. For prod it is
# not optional: `openssl rand -base64 32`, and the prod container refuses to
# start while this still reads `admin`.
ODOO_MASTER_PASSWORD=admin

# Worker count. 2 is the dev default. For prod, target (2 * cpu_count + 1).
ODOO_WORKERS=2
ODOO_MAX_CRON_THREADS=1

# Which databases Odoo EXPOSES over HTTP. This used to be allowed to fall back
# to `db_name = odoo` in the conf file — but db_name also pins the cron worker
# (`cron_database_list()` is `config['db_name'] or list_dbs(True)`), so that
# fallback silently meant no ir.cron ran on any tenant but one. db_name is gone
# from config/odoo.19.conf; this variable now carries
# the exposure decision on its own, and cron always sees every database.
#
#   ^odoo$  — single-database mode, the committed default. Exposes only the DB
#             named `odoo` (POSTGRES_DB above) on every host, so plain
#             http://localhost:8069 and CI work exactly as they did.
#   ^%d$    — multi-tenant host routing: each host's first label selects the DB
#             of the same name (nrs19.localhost→nrs19, gtb19.localhost→gtb19).
#             Prefer a shell override (`export ODOO_DBFILTER='^%d$'`) so the
#             committed default stays single-database.
#
# Never set on prod/staging — k8s/dev/10-configmap-odoo-19.yaml has its own
# (`dbfilter = ^%d$`, and it has always correctly omitted db_name).
ODOO_DBFILTER=^odoo$

# Comma-separated modules installed on bootstrap. Edit ONLY if you need to
# drop or add a module from the canonical kept-set.
CADRA_BOOTSTRAP_MODULES=myservice_api,myservice_asset_register,myservice_barcode_station,myservice_dashboard,myservice_email_relay,myservice_fleet_maintenance,myservice_fm_dashboard,myservice_identity,myservice_nrs_base,myservice_request_fields,myservice_security,myservice_staff_bus,myservice_theme_v5,myservice_website_theme,myservice_workflow,web_responsive

# ─── Email relay (HTTPS bridge — bypasses DO SMTP egress block) ───────
# When both are set, myservice_email_relay overrides ir.mail_server.send_email
# to POST through this URL instead of opening SMTP. Leave blank to keep
# native SMTP (recommended for local dev — your Mac isn't SMTP-blocked).
CADRA_EMAIL_RELAY_URL=
CADRA_EMAIL_RELAY_SECRET=

# ─── Cadra API ────────────────────────────────────────────────────────
# JWT signing secret. MUST be ≥16 chars; production should be ≥48 chars
# (openssl rand -base64 48). Leave blank and bootstrap generates one, stores
# it per database in ir.config_parameter, and captures it into
# docs/api/.creds.<db>. (This used to promise a `.env.runtime` file. Nothing
# has ever written one.)
CADRA_JWT_SECRET=

# Cloudflare Turnstile secret key (optional). If set, Turnstile protection
# is enforced on the login endpoint. If empty, Turnstile is bypassed.
CADRA_TURNSTILE_SECRET=

# Provider key for *Identify from photo* (optional, the owner's). The server
# reads it from its environment on every call and keeps it in NO database;
# one key serves every tenant on this server, and each tenant's own switch
# (Settings -> Identify from photo, off by default) decides whether it is
# used. Set it with `scripts/set_ai_key.sh` (prompts, nothing echoed), then
# recreate the odoo container. Never commit a value here.
CADRA_AI_API_KEY=

# The smoke-test API client credentials are created by bootstrap.
# Leave blank to let bootstrap generate. Captured to docs/api/.creds.<db>.
CADRA_TEST_CLIENT_ID=test_client
CADRA_TEST_CLIENT_SECRET=

# ─── Production-only (Caddy TLS) ──────────────────────────────────────
# Public hostname this deployment serves. Caddy will obtain a Let's
# Encrypt cert for this domain automatically.
CADRA_DOMAIN=cadra.example.com
# Email for ACME (Let's Encrypt) registration / cert renewal notices.
CADRA_ACME_EMAIL=ops@example.com

# ─── Bootstrap behavior ───────────────────────────────────────────────
# Seeds to run during bootstrap. "core" = ITSM structure + locations +
# offices. "fleet" adds the master fleet seed (slow). Empty = no seeds.
CADRA_SEED_PROFILE=core
