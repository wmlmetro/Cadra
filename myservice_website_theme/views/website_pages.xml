<?xml version="1.0" encoding="utf-8"?>
<odoo>

<record id="nrs_homepage_view" model="ir.ui.view">
    <field name="name">NRS Homepage</field>
    <field name="type">qweb</field>
    <field name="key">myservice_website_theme.nrs_homepage</field>
    <field name="arch" type="xml">
        <t t-name="myservice_website_theme.nrs_homepage">
            <t t-call="website.layout">
                <div id="wrap">

                <!-- ── Top announcement bar ── -->
                <div style="background:#1A1A1A;color:#9CA3AF;font-size:12px;padding:8px 24px;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap;gap:8px;">
                    <div style="display:flex;align-items:center;gap:8px;">
                        <span style="width:6px;height:6px;background:var(--nrs-red);border-radius:50%;display:inline-block;"></span>
                        <t t-out="res_company.name"/> — Facilities Management Division
                    </div>
                    <div style="display:flex;align-items:center;gap:20px;">
                        <span>Emergency: <strong style="color:#fff;">0800-NRS-HELP</strong></span>
                        <a href="/web/login" style="color:#9CA3AF;text-decoration:none;">Staff Login</a>
                        <a href="/service-request" style="color:#9CA3AF;text-decoration:none;">Contact Us</a>
                    </div>
                </div>

                <!-- ── Custom navbar ── -->
                <nav style="background:#fff;border-bottom:1px solid #E5E7EB;padding:0 32px;height:70px;display:flex;align-items:center;justify-content:space-between;position:sticky;top:0;z-index:999;">
                    <div style="display:flex;align-items:center;gap:48px;">
                        <a href="/" style="text-decoration:none;">
                            <img src="/web/image/res.company/1/logo" alt="NRS" style="height:44px;width:auto;object-fit:contain;" onerror="this.style.display='none';this.nextSibling.style.display='flex'" />
                            <div style="display:none;align-items:center;gap:6px;">
                                <span style="font-size:22px;font-weight:900;color:#6B7280;letter-spacing:1px;">NRS</span>
                                <div style="width:1px;height:16px;background:#D1D5DB;"></div>
                                <div style="font-size:8px;color:#9CA3AF;font-weight:600;line-height:1.3;text-transform:uppercase;">Nigeria<br/>Revenue<br/>Service</div>
                            </div>
                        </a>
                        <div style="display:flex;gap:32px;" class="d-none d-md-flex">
                            <a href="#services" style="font-size:14px;color:#374151;text-decoration:none;font-weight:500;">Services</a>
                            <a href="#how-it-works" style="font-size:14px;color:#374151;text-decoration:none;font-weight:500;">How It Works</a>
                            <a href="/my/requests" style="font-size:14px;color:#374151;text-decoration:none;font-weight:500;">Track Request</a>
                        </div>
                    </div>
                    <div style="display:flex;align-items:center;gap:12px;">
                        <a href="/service-request" style="background:var(--nrs-red);color:#fff;padding:10px 22px;border-radius:6px;font-size:14px;font-weight:700;text-decoration:none;display:flex;align-items:center;gap:6px;">
                            + Submit a Request
                        </a>
                        <a href="/web/login" style="border:1.5px solid #E5E7EB;color:#374151;padding:10px 20px;border-radius:6px;font-size:14px;font-weight:600;text-decoration:none;">
                            Staff Login &#x2192;
                        </a>
                    </div>
                </nav>

                <!-- ── Hero ── -->
                <section style="background:#FAFAF9;padding:80px 0 0;min-height:520px;display:flex;align-items:center;">
                    <div style="max-width:1200px;margin:0 auto;padding:0 40px;width:100%;display:flex;align-items:center;justify-content:space-between;gap:40px;flex-wrap:wrap;">
                        <div style="max-width:560px;">
                            <div style="display:inline-flex;align-items:center;gap:8px;background:#fff;border:1px solid #E5E7EB;border-radius:20px;padding:6px 16px;margin-bottom:28px;">
                                <span style="width:6px;height:6px;background:#10B981;border-radius:50%;display:inline-block;"></span>
                                <span style="font-size:11px;font-weight:700;color:#374151;text-transform:uppercase;letter-spacing:1px;">Portal Active — 24/7 Service</span>
                            </div>
                            <h1 style="font-size:52px;font-weight:900;color:#1A1A1A;line-height:1.1;margin-bottom:20px;letter-spacing:-1px;">
                                Facilities Support,<br/>
                                <em style="color:var(--nrs-red);font-style:italic;font-weight:900;">When You Need It</em>
                            </h1>
                            <p style="font-size:17px;color:#6B7280;line-height:1.7;margin-bottom:36px;max-width:480px;">
                                Submit maintenance requests, track resolution progress, and access all NRS facility services — building, fleet, security and more — in one unified portal.
                            </p>
                            <div style="display:flex;gap:14px;flex-wrap:wrap;">
                                <a href="/service-request" style="background:var(--nrs-red);color:#fff;padding:14px 28px;border-radius:7px;font-size:15px;font-weight:700;text-decoration:none;display:inline-flex;align-items:center;gap:8px;">
                                    Submit a Request &#x2192;
                                </a>
                                <a href="#how-it-works" style="background:#fff;border:1.5px solid #E5E7EB;color:#374151;padding:14px 28px;border-radius:7px;font-size:15px;font-weight:600;text-decoration:none;">
                                    How It Works
                                </a>
                            </div>
                        </div>
                        <div style="flex:1;min-width:280px;display:flex;justify-content:flex-end;" class="d-none d-lg-flex">
                            <div style="width:340px;height:340px;background:linear-gradient(135deg,#FBE9EC,#fff);border-radius:50%;display:flex;align-items:center;justify-content:center;border:1px solid #F0D0D6;">
                                <svg width="140" height="140" viewBox="0 0 24 24" fill="none" stroke="#C8102E" stroke-width="0.8" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/>
                                </svg>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ── Stats bar ── -->
                <section style="background:#A0522D;padding:48px 0;">
                    <div style="max-width:1200px;margin:0 auto;padding:0 40px;">
                        <div class="row" style="text-align:center;">
                            <div class="col-6 col-md-3" style="padding:20px;border-right:1px solid rgba(255,255,255,0.1);">
                                <div style="font-size:48px;font-weight:900;color:#fff;line-height:1;">6</div>
                                <div style="font-size:13px;color:rgba(255,255,255,0.7);margin-top:6px;font-weight:500;">Service Domains</div>
                            </div>
                            <div class="col-6 col-md-3" style="padding:20px;border-right:1px solid rgba(255,255,255,0.1);">
                                <div style="font-size:48px;font-weight:900;color:#fff;line-height:1;">83</div>
                                <div style="font-size:13px;color:rgba(255,255,255,0.7);margin-top:6px;font-weight:500;">Request Types</div>
                            </div>
                            <div class="col-6 col-md-3" style="padding:20px;border-right:1px solid rgba(255,255,255,0.1);">
                                <div style="font-size:48px;font-weight:900;color:#fff;line-height:1;">1,617</div>
                                <div style="font-size:13px;color:rgba(255,255,255,0.7);margin-top:6px;font-weight:500;">Fleet Vehicles</div>
                            </div>
                            <div class="col-6 col-md-3" style="padding:20px;">
                                <div style="font-size:48px;font-weight:900;color:#fff;line-height:1;">24/7</div>
                                <div style="font-size:13px;color:rgba(255,255,255,0.7);margin-top:6px;font-weight:500;">Portal Availability</div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ── Services grid ── -->
                <section id="services" style="padding:80px 0;background:#fff;">
                    <div style="max-width:1200px;margin:0 auto;padding:0 40px;">
                        <div style="text-align:center;margin-bottom:52px;">
                            <div style="font-size:10px;font-weight:700;color:var(--nrs-red);text-transform:uppercase;letter-spacing:1.5px;margin-bottom:10px;">What We Manage</div>
                            <h2 style="font-size:34px;font-weight:900;color:#1A1A1A;margin:0;">Facilities Services</h2>
                        </div>
                        <div class="row g-4">
                            <div class="col-md-4">
                                <div style="border:1px solid #E5E7EB;border-radius:10px;padding:28px;height:100%;transition:border-color .2s;">
                                    <div style="width:44px;height:44px;background:#FBE9EC;border-radius:9px;display:flex;align-items:center;justify-content:center;margin-bottom:18px;">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C8102E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 9l9-7 9 7v11a2 2 0 01-2 2H5a2 2 0 01-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
                                    </div>
                                    <h5 style="font-size:16px;font-weight:700;color:#1A1A1A;margin-bottom:8px;">Building Services</h5>
                                    <p style="font-size:13px;color:#6B7280;line-height:1.6;margin:0;">Plumbing, electrical, HVAC, civil works and general maintenance across all NRS offices.</p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div style="border:1px solid #E5E7EB;border-radius:10px;padding:28px;height:100%;">
                                    <div style="width:44px;height:44px;background:#FBE9EC;border-radius:9px;display:flex;align-items:center;justify-content:center;margin-bottom:18px;">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C8102E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="1" y="3" width="15" height="13" rx="2"/><path d="M16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
                                    </div>
                                    <h5 style="font-size:16px;font-weight:700;color:#1A1A1A;margin-bottom:8px;">Fleet Management</h5>
                                    <p style="font-size:13px;color:#6B7280;line-height:1.6;margin:0;">Vehicle scheduling, maintenance tracking and driver management for the NRS national fleet.</p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div style="border:1px solid #E5E7EB;border-radius:10px;padding:28px;height:100%;">
                                    <div style="width:44px;height:44px;background:#FBE9EC;border-radius:9px;display:flex;align-items:center;justify-content:center;margin-bottom:18px;">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C8102E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                                    </div>
                                    <h5 style="font-size:16px;font-weight:700;color:#1A1A1A;margin-bottom:8px;">Security Operations</h5>
                                    <p style="font-size:13px;color:#6B7280;line-height:1.6;margin:0;">Access control, CCTV monitoring, incident reporting and watchlist management.</p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div style="border:1px solid #E5E7EB;border-radius:10px;padding:28px;height:100%;">
                                    <div style="width:44px;height:44px;background:#FBE9EC;border-radius:9px;display:flex;align-items:center;justify-content:center;margin-bottom:18px;">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C8102E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/><line x1="7" y1="7" x2="7.01" y2="7"/></svg>
                                    </div>
                                    <h5 style="font-size:16px;font-weight:700;color:#1A1A1A;margin-bottom:8px;">Asset Management</h5>
                                    <p style="font-size:13px;color:#6B7280;line-height:1.6;margin:0;">Asset tagging, QR-code verification, maintenance scheduling and lifecycle tracking.</p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div style="border:1px solid #E5E7EB;border-radius:10px;padding:28px;height:100%;">
                                    <div style="width:44px;height:44px;background:#FBE9EC;border-radius:9px;display:flex;align-items:center;justify-content:center;margin-bottom:18px;">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C8102E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M17 21v-2a4 4 0 00-4-4H5a4 4 0 00-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 00-3-3.87"/><path d="M16 3.13a4 4 0 010 7.75"/></svg>
                                    </div>
                                    <h5 style="font-size:16px;font-weight:700;color:#1A1A1A;margin-bottom:8px;">Staff Transport</h5>
                                    <p style="font-size:13px;color:#6B7280;line-height:1.6;margin:0;">Staff bus route management, scheduling and commute coordination across NRS offices.</p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div style="border:1px solid #E5E7EB;border-radius:10px;padding:28px;height:100%;">
                                    <div style="width:44px;height:44px;background:#FBE9EC;border-radius:9px;display:flex;align-items:center;justify-content:center;margin-bottom:18px;">
                                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="#C8102E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 00-2 2v16a2 2 0 002 2h12a2 2 0 002-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
                                    </div>
                                    <h5 style="font-size:16px;font-weight:700;color:#1A1A1A;margin-bottom:8px;">Service Requests</h5>
                                    <p style="font-size:13px;color:#6B7280;line-height:1.6;margin:0;">Log, track and resolve maintenance requests with full SLA monitoring and escalation.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ── How it works ── -->
                <section id="how-it-works" style="padding:80px 0;background:#F5F5F5;">
                    <div style="max-width:1200px;margin:0 auto;padding:0 40px;text-align:center;">
                        <div style="font-size:10px;font-weight:700;color:var(--nrs-red);text-transform:uppercase;letter-spacing:1.5px;margin-bottom:10px;">Simple Process</div>
                        <h2 style="font-size:34px;font-weight:900;color:#1A1A1A;margin-bottom:48px;">How It Works</h2>
                        <div class="row g-4">
                            <div class="col-md-4">
                                <div style="background:#fff;border-radius:10px;padding:32px 24px;border:1px solid #E5E7EB;">
                                    <div style="width:40px;height:40px;background:var(--nrs-red);border-radius:50%;color:#fff;font-size:16px;font-weight:800;display:flex;align-items:center;justify-content:center;margin:0 auto 18px;">1</div>
                                    <h5 style="font-size:16px;font-weight:700;color:#1A1A1A;margin-bottom:8px;">Submit Request</h5>
                                    <p style="font-size:13px;color:#6B7280;line-height:1.6;margin:0;">Fill in the request form with details of the issue, your location and contact information.</p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div style="background:#fff;border-radius:10px;padding:32px 24px;border:1px solid #E5E7EB;">
                                    <div style="width:40px;height:40px;background:var(--nrs-red);border-radius:50%;color:#fff;font-size:16px;font-weight:800;display:flex;align-items:center;justify-content:center;margin:0 auto 18px;">2</div>
                                    <h5 style="font-size:16px;font-weight:700;color:#1A1A1A;margin-bottom:8px;">Team Assignment</h5>
                                    <p style="font-size:13px;color:#6B7280;line-height:1.6;margin:0;">Our FM team reviews and assigns the request to the appropriate technician within SLA.</p>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div style="background:#fff;border-radius:10px;padding:32px 24px;border:1px solid #E5E7EB;">
                                    <div style="width:40px;height:40px;background:var(--nrs-red);border-radius:50%;color:#fff;font-size:16px;font-weight:800;display:flex;align-items:center;justify-content:center;margin:0 auto 18px;">3</div>
                                    <h5 style="font-size:16px;font-weight:700;color:#1A1A1A;margin-bottom:8px;">Resolution</h5>
                                    <p style="font-size:13px;color:#6B7280;line-height:1.6;margin:0;">Issue resolved and closed. Track progress at any time using your reference number.</p>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>

                <!-- ── CTA ── -->
                <section style="padding:80px 0;background:#1A1A1A;text-align:center;">
                    <div style="max-width:600px;margin:0 auto;padding:0 40px;">
                        <h2 style="font-size:32px;font-weight:900;color:#fff;margin-bottom:14px;">Ready to submit a request?</h2>
                        <p style="font-size:15px;color:#9CA3AF;margin-bottom:32px;">Our facilities team is on standby. Average response time under 2 hours.</p>
                        <a href="/service-request" style="background:var(--nrs-red);color:#fff;padding:14px 36px;border-radius:7px;font-size:15px;font-weight:700;text-decoration:none;display:inline-block;">Submit a Request &#x2192;</a>
                    </div>
                </section>

                </div>
            </t>
        </t>
    </field>
</record>

<record id="nrs_homepage" model="website.page">
    <field name="name">NRS myservice Home</field>
    <field name="url">/</field>
    <field name="is_published">True</field>
    <field name="view_id" ref="nrs_homepage_view"/>
</record>

</odoo>
