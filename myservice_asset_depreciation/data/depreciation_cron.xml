<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Book value moves with the calendar, not with the database: nothing
             changes in a record when a month passes, so there is no ORM
             dependency that could trigger a recompute. This cron is what keeps
             the stored figures honest. ERP-managed assets are excluded. -->
        <record id="cron_asset_depreciation" model="ir.cron">
            <field name="name">NRS Asset Depreciation — Recompute book values</field>
            <field name="model_id" ref="myservice_asset_register.model_nrs_asset"/>
            <field name="state">code</field>
            <field name="code">model._cron_recompute_depreciation()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>
    </data>
</odoo>
