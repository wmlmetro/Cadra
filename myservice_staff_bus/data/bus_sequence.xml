<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_bus_schedule" model="ir.sequence">
            <field name="name">Staff Bus Schedule</field>
            <field name="code">bus.schedule</field>
            <field name="prefix">SCHED/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_bus_route" model="ir.sequence">
            <field name="name">Staff Bus Route</field>
            <field name="code">bus.route</field>
            <field name="prefix">RT/</field>
            <field name="padding">3</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
