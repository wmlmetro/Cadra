<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="module_category_staff_bus" model="ir.module.category">
            <field name="name">Staff Bus</field>
            <field name="sequence">30</field>
        </record>

        <record id="group_bus_user" model="res.groups">
            <field name="name">Staff Bus User</field>
            <field name="category_id" ref="module_category_staff_bus"/>
            <field name="comment">Can view routes, book seats, and log fuel.</field>
        </record>

        <record id="group_bus_manager" model="res.groups">
            <field name="name">Staff Bus Manager</field>
            <field name="category_id" ref="module_category_staff_bus"/>
            <field name="implied_ids" eval="[(4, ref('group_bus_user'))]"/>
            <field name="comment">Full access — routes, schedules, manifests, fuel, compliance.</field>
        </record>
    </data>
</odoo>
