<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_barcode_station" name="NRS Barcode Portal">
        <t t-call="website.layout">
            <div class="ms-portal">
                <div class="ms-portal-header">
                    <div class="ms-portal-header-title">
                        <span>NRS</span> Asset Barcode Scanner
                    </div>
                    <div style="color:#888;font-size:11px">Field Portal</div>
                </div>

                <div class="ms-portal-body">

                    <!-- Scan card -->
                    <div class="ms-portal-scan-card">
                        <div class="ms-portal-scan-top">Scan or enter asset tag number</div>
                        <div class="ms-portal-scan-body">

                            <!-- Camera box -->
                            <div class="ms-portal-camera-box" id="portal-camera-box">
                                <video id="portal-video" class="ms-portal-video" autoplay="autoplay" playsinline="playsinline"/>
                                <div class="ms-portal-scan-line" id="portal-scan-line" style="display:none"/>
                                <div id="portal-cam-placeholder" style="color:#888;font-size:12px;text-align:center;padding:16px">
                                    <div style="font-size:32px;margin-bottom:8px">▦</div>
                                    Camera not started
                                </div>
                            </div>

                            <!-- Camera buttons -->
                            <button id="portal-cam-start" class="ms-portal-cam-btn">Start Camera Scan</button>
                            <button id="portal-cam-stop" class="ms-portal-cam-btn stop" style="display:none">Stop Camera</button>
                            <div id="portal-status" class="ms-portal-status"></div>

                            <!-- Manual input -->
                            <div style="margin-top:12px;margin-bottom:4px;font-size:11px;color:#888;text-transform:uppercase;letter-spacing:0.4px">
                                Or type / scan with USB reader
                            </div>
                            <div class="ms-portal-input-row">
                                <input id="portal-search-input" class="ms-portal-input"
                                       placeholder="NRS-PLT-00042..."
                                       autocomplete="off"
                                       autofocus="autofocus"/>
                                <button id="portal-search-btn" class="ms-portal-search-btn">Go</button>
                            </div>
                        </div>
                    </div>

                    <!-- Not found -->
                    <div id="portal-not-found" class="ms-portal-not-found">
                        Tag not found. Check the number and try again.
                    </div>

                    <!-- Result -->
                    <div id="portal-result" class="ms-portal-result">
                        <div class="ms-portal-result-top">
                            <div class="ms-portal-result-tag" id="p-tag-number">—</div>
                            <div class="ms-portal-result-name" id="p-asset-name">—</div>
                        </div>
                        <div class="ms-portal-result-body">
                            <div class="ms-portal-result-row">
                                <span class="ms-portal-result-label">Category</span>
                                <span class="ms-portal-result-val" id="p-category">—</span>
                            </div>
                            <div class="ms-portal-result-row">
                                <span class="ms-portal-result-label">Location</span>
                                <span class="ms-portal-result-val" id="p-location">—</span>
                            </div>
                            <div class="ms-portal-result-row">
                                <span class="ms-portal-result-label">Condition</span>
                                <span class="ms-portal-result-val" id="p-condition">—</span>
                            </div>
                            <div class="ms-portal-result-row">
                                <span class="ms-portal-result-label">Status</span>
                                <span class="ms-portal-result-val" id="p-state">—</span>
                            </div>
                            <div class="ms-portal-result-row">
                                <span class="ms-portal-result-label">Last serviced</span>
                                <span class="ms-portal-result-val" id="p-last-pm">—</span>
                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </t>
    </template>
</odoo>
