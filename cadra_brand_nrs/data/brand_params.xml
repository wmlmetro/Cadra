<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- noupdate so a hand-edited value survives module upgrades. -->
    <data noupdate="1">
        <!-- The short brand code shown in dashboard titles ("NRS FM
             Operations Dashboard", "NRS Office Locations", ...). For a new
             client, change this value (e.g. "MoH", "Jizzy"). -->
        <record id="param_brand_short_name" model="ir.config_parameter">
            <field name="key">cadra.brand_short_name</field>
            <field name="value">NRS</field>
        </record>
        <!-- Surfaced to the React frontend via GET /api/v1/brand. Keep in sync
             with static/src/css/brand.css. No logo param → the frontend falls
             back to its bundled NRS logo. -->
        <record id="param_brand_primary" model="ir.config_parameter">
            <field name="key">cadra.brand_primary</field>
            <field name="value">#C8102E</field>
        </record>
        <record id="param_brand_primary_dark" model="ir.config_parameter">
            <field name="key">cadra.brand_primary_dark</field>
            <field name="value">#A00D24</field>
        </record>
    </data>
</odoo>
