# Dev server (required to run `npm run dev`)
PORT=5173
BASE_PATH=/

# Cadra API — leave VITE_API_BASE empty to use mocks only.
# Set to "" (empty) and configure VITE_API_PROXY to route /api/* through Vite.
# For talking directly (e.g. prod build), set VITE_API_BASE=https://staging.app.cadra.ng
VITE_API_BASE=

# Vite dev proxy target. When set, /api/* on the dev server is forwarded here
# (sidesteps CORS in development). Leave unset to disable the proxy.
VITE_API_PROXY=https://staging.app.cadra.ng

# JWT bearer token for the Cadra API. Obtain via:
#   curl -X POST $VITE_API_PROXY/api/v1/auth/token \
#     -H "Content-Type: application/json" \
#     -d '{"client_id":"...","client_secret":"..."}'
# Then paste only the raw access_token here (no "Bearer " prefix).
VITE_API_TOKEN=
