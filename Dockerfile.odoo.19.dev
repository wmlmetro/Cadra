# Cadra Odoo 19 dev image — greenfield rebuild target (branch feat/rebuild-odoo-19).
#
# Paired with docker-compose.19.yml, which bind-mounts the repo into
# /mnt/extra-addons for hot-reload. It is now the ONLY dev image — the Odoo 15
# one it was modelled on was deleted in handoff 20, because a Dockerfile nothing
# references is the thing the next compose overlay points at.
#
#   docker compose -f docker-compose.yml -f docker-compose.19.yml up -d
FROM odoo:19.0

USER root
RUN pip3 install --no-cache-dir --break-system-packages html2text openpyxl
# Handoff 64 — the Anthropic SDK for *Identify from photo* (R11). Two of its
# dependencies are Debian-owned in the base image and cannot be uninstalled
# by pip, so newer copies are installed beside them first.
# Handoff 68 — and the OpenAI SDK beside it, the second provider, pinned the
# same way (it needs typing_extensions >= 4.14, hence the floor below).
RUN pip3 install --no-cache-dir --break-system-packages --ignore-installed \
        idna "typing_extensions>=4.14" \
 && pip3 install --no-cache-dir --break-system-packages anthropic==1.14.0 \
        openai==3.26.1
USER odoo
