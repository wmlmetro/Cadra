<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="cron_ai_detectors" model="ir.cron">
            <field name="name">AI Pattern — Run All Detectors</field>
            <field name="model_id" ref="model_ai_pattern_engine"/>
            <field name="state">code</field>
            <field name="code">model.cron_run_detectors()</field>
            <field name="interval_number">6</field>
            <field name="interval_type">hours</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
        <record id="cron_ai_daily_brief" model="ir.cron">
            <field name="name">AI Pattern — Generate Daily Brief</field>
            <field name="model_id" ref="model_ai_daily_brief"/>
            <field name="state">code</field>
            <field name="code">model.generate_daily_brief()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="active">True</field>
        </record>
        <record id="seq_ai_pattern_alert" model="ir.sequence">
            <field name="name">AI Pattern Alert</field>
            <field name="code">ai.pattern.alert</field>
            <field name="prefix">APA-%(year)s-</field>
            <field name="padding">4</field>
        </record>
    </data>
</odoo>
