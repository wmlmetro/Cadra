<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ai_alert_list" model="ir.ui.view">
        <field name="name">ai.pattern.alert.list</field>
        <field name="model">ai.pattern.alert</field>
        <field name="arch" type="xml">
            <tree string="AI Pattern Alerts"
                  decoration-danger="severity in ('critical','high') and state == 'new'"
                  decoration-warning="severity == 'medium' and state == 'new'"
                  decoration-muted="state in ('dismissed')">
                <field name="name"/>
                <field name="create_date" string="Detected"/>
                <field name="pattern_type" widget="badge"/>
                <field name="severity" widget="badge"
                    decoration-danger="severity in ('critical','high')"
                    decoration-warning="severity == 'medium'"/>
                <field name="confidence" string="Confidence %"
                    widget="progressbar"/>
                <field name="title"/>
                <field name="affected_states"/>
                <field name="incident_count"/>
                <field name="state" widget="badge"
                    decoration-danger="state == 'new'"
                    decoration-success="state in ('confirmed','actioned')"
                    decoration-muted="state == 'dismissed'"/>
                <button name="action_confirm" string="Confirm"
                    type="object" icon="fa-check"
                    attrs="{'invisible': [('state','!=','new')]}"/>
                <button name="action_dismiss" string="Dismiss"
                    type="object" icon="fa-times"
                    attrs="{'invisible': [('state','!=','new')]}"/>
            </tree>
        </field>
    </record>

    <record id="view_ai_alert_form" model="ir.ui.view">
        <field name="name">ai.pattern.alert.form</field>
        <field name="model">ai.pattern.alert</field>
        <field name="arch" type="xml">
            <form string="AI Pattern Alert">
                <header>
                    <button name="action_confirm" string="Confirm Pattern"
                        type="object" class="btn-primary"
                        attrs="{'invisible': [('state','!=','new')]}"/>
                    <button name="action_mark_actioned" string="Mark Actioned"
                        type="object" class="btn-success"
                        attrs="{'invisible': [('state','not in',['new','confirmed'])]}"/>
                    <button name="action_dismiss" string="Dismiss"
                        type="object" class="btn-secondary"
                        attrs="{'invisible': [('state','!=','new')]}"/>
                    <field name="state" widget="statusbar"
                        statusbar_visible="new,confirmed,actioned"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_incidents" type="object"
                            class="oe_stat_button" icon="fa-shield"
                            attrs="{'invisible': [('incident_count','=',0)]}">
                            <field name="incident_count" widget="statinfo" string="Incidents"/>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="title"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="name" readonly="1"/>
                            <field name="pattern_type"/>
                            <field name="severity"/>
                            <field name="confidence" widget="progressbar"/>
                        </group>
                        <group>
                            <field name="affected_states"/>
                            <field name="affected_locations"/>
                            <field name="date_range_start"/>
                            <field name="date_range_end"/>
                        </group>
                    </group>

                    <div class="alert alert-warning" role="alert"
                         attrs="{'invisible': [('state','!=','new')]}">
                        <strong>⚠ Unreviewed AI Alert</strong> — Please review the AI assessment below and confirm or dismiss.
                    </div>

                    <notebook>
                        <page string="AI Assessment">
                            <group string="Intelligence Summary">
                                <field name="ai_summary" nolabel="1"
                                    widget="text" readonly="1"/>
                            </group>
                            <group string="Recommended Actions">
                                <field name="ai_recommended_actions" nolabel="1"
                                    widget="text" readonly="1"/>
                            </group>
                        </page>
                        <page string="Route Risk"
                            attrs="{'invisible': [('pattern_type','!=','route')]}">
                            <group>
                                <field name="route_origin"/>
                                <field name="route_destination"/>
                                <field name="route_risk_score"/>
                            </group>
                        </page>
                        <page string="Analyst Review">
                            <group>
                                <field name="analyst_note"/>
                                <field name="reviewed_by" readonly="1"/>
                                <field name="reviewed_at" readonly="1"/>
                            </group>
                        </page>
                        <page string="Linked Data">
                            <field name="linked_incident_ids" widget="many2many_list"
                                readonly="1"/>
                            <field name="auto_created_incident_id" readonly="1"/>
                        </page>
                        <page string="Raw AI Response" groups="base.group_system">
                            <field name="ai_raw_response" widget="code" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="message_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="view_ai_alert_search" model="ir.ui.view">
        <field name="name">ai.pattern.alert.search</field>
        <field name="model">ai.pattern.alert</field>
        <field name="arch" type="xml">
            <search>
                <field name="title"/>
                <field name="affected_states"/>
                <filter name="unreviewed" string="Unreviewed" domain="[('state','=','new')]"/>
                <filter name="critical" string="Critical" domain="[('severity','=','critical')]"/>
                <filter name="high" string="High" domain="[('severity','=','high')]"/>
                <filter name="cluster" string="Clusters" domain="[('pattern_type','=','cluster')]"/>
                <filter name="escalation" string="Escalation" domain="[('pattern_type','=','escalation')]"/>
                <filter name="watchlist" string="Watchlist" domain="[('pattern_type','=','watchlist')]"/>
                <group expand="0" string="Group By">
                    <filter name="by_type" string="Pattern Type" context="{'group_by':'pattern_type'}"/>
                    <filter name="by_severity" string="Severity" context="{'group_by':'severity'}"/>
                    <filter name="by_state" string="Status" context="{'group_by':'state'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ai_pattern_alerts" model="ir.actions.act_window">
        <field name="name">AI Pattern Alerts</field>
        <field name="res_model">ai.pattern.alert</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_ai_alert_search"/>
        <field name="context">{'search_default_unreviewed': 1}</field>
    </record>

</odoo>
