<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ── List View ──────────────────────────────────────────────────────────── -->
<record id="view_ai_daily_brief_list" model="ir.ui.view">
    <field name="name">ai.daily.brief.list</field>
    <field name="model">ai.daily.brief</field>
    <field name="arch" type="xml">
        <tree string="Intelligence Briefs" decoration-danger="state == 'recalled'"
              decoration-success="state == 'released'"
              decoration-warning="state == 'pending_approval'">
            <field name="date"/>
            <field name="ref"/>
            <field name="name"/>
            <field name="brief_format"/>
            <field name="classification"
                   decoration-danger="classification in ('secret','top_secret')"
                   decoration-warning="classification == 'confidential'"
                   decoration-info="classification == 'restricted'"/>
            <field name="threat_level"
                   decoration-danger="threat_level in ('high','critical')"
                   decoration-warning="threat_level == 'moderate'"/>
            <field name="state"/>
            <field name="prepared_by"/>
            <field name="approved_by"/>
            <field name="download_count"/>
        </tree>
    </field>
</record>

<!-- ── Form View ──────────────────────────────────────────────────────────── -->
<record id="view_ai_daily_brief_form" model="ir.ui.view">
    <field name="name">ai.daily.brief.form</field>
    <field name="model">ai.daily.brief</field>
    <field name="arch" type="xml">
        <form string="Intelligence Brief">

            <!-- Status bar -->
            <header>
                <button name="action_generate_ai" string="Generate with AI"
                        type="object" class="btn-primary"
                        attrs="{'invisible': [('state', 'not in', ['draft'])]}"/>
                <button name="action_submit_for_approval" string="Submit for Approval"
                        type="object"
                        attrs="{'invisible': [('state', 'not in', ['draft'])]}"/>
                <button name="action_approve" string="Approve"
                        type="object" class="btn-primary"
                        groups="myservice_security.group_security_manager"
                        attrs="{'invisible': [('state', '!=', 'pending_approval')]}"/>
                <button name="action_release" string="Release Brief"
                        type="object" class="btn-success"
                        groups="myservice_security.group_security_manager"
                        attrs="{'invisible': [('state', '!=', 'approved')]}"/>
                <button name="action_recall" string="Recall"
                        type="object" class="btn-danger"
                        groups="myservice_security.group_security_manager"
                        attrs="{'invisible': [('state', 'not in', ['released'])]}"/>
                <button name="action_reset_draft" string="Reset to Draft"
                        type="object"
                        attrs="{'invisible': [('state', 'not in', ['recalled'])]}"/>
                <!-- Download button — calls secure controller -->
                <button string="Download PDF"
                        type="object"
                        name="action_download_brief"
                        class="btn-secondary"
                        attrs="{'invisible': [('state', '!=', 'released')]}"/>
                <field name="state" widget="statusbar"
                       statusbar_visible="draft,pending_approval,approved,released"/>
            </header>

            <sheet>
                <!-- Classification banner -->
                <div class="alert alert-danger" role="alert"
                     attrs="{'invisible': [('classification', 'not in', ['secret','top_secret'])]}">
                    <strong>
                        <field name="classification_label" readonly="1"/>
                        — Handle with extreme care. Unauthorised disclosure is a criminal offence.
                    </strong>
                </div>

                <div class="oe_title">
                    <h1><field name="name" placeholder="Brief Title"/></h1>
                    <h4 style="color:#C8102E;"><field name="ref" readonly="1"/></h4>
                </div>

                <group>
                    <group string="Identification">
                        <field name="date"/>
                        <field name="time_of_issue"/>
                        <field name="brief_format"/>
                        <field name="threat_level" widget="priority"/>
                        <field name="threat_colour" invisible="1"/>
                    </group>
                    <group string="Classification &amp; Distribution">
                        <field name="classification"/>
                        <field name="classification_colour" invisible="1"/>
                        <field name="distribution_caveat"/>
                        <field name="distribution_list" widget="many2many_tags"
                               attrs="{'invisible': [('distribution_caveat', 'not in', ['need_to_know','eyes_only','limited'])],
                                       'required': [('distribution_caveat', 'in', ['need_to_know','eyes_only'])]}"/>
                    </group>
                </group>

                <group>
                    <group string="Approval">
                        <field name="prepared_by"/>
                        <field name="approved_by" readonly="1"/>
                        <field name="approved_date" readonly="1"/>
                        <field name="released_by" readonly="1"/>
                        <field name="released_date" readonly="1"/>
                    </group>
                    <group string="Statistics">
                        <field name="download_count" readonly="1"/>
                        <field name="acled_entry_count" readonly="1"/>
                    </group>
                </group>

                <notebook>
                    <page string="Executive Summary">
                        <field name="exec_summary" placeholder="AI will generate this section..."/>
                    </page>
                    <page string="Threat Landscape"
                          attrs="{'invisible': [('brief_format', '=', 'tactical')]}">
                        <field name="threat_landscape" placeholder="AI will generate this section..."/>
                    </page>
                    <page string="Intel Entries Summary"
                          attrs="{'invisible': [('brief_format', '!=', 'strategic')]}">
                        <field name="intel_entries_summary" placeholder="AI will generate this section..."/>
                        <field name="osint_entry_ids" widget="many2many_tags"/>
                    </page>
                    <page string="Watchlist"
                          attrs="{'invisible': [('brief_format', '=', 'tactical')]}">
                        <field name="watchlist_summary" placeholder="AI will generate this section..."/>
                        <field name="watchlist_ids" widget="many2many_tags"/>
                    </page>
                    <page string="Recommendations">
                        <field name="recommendations" placeholder="AI will generate this section..."/>
                    </page>
                    <page string="Handling Instructions"
                          attrs="{'invisible': [('brief_format', '=', 'tactical')]}">
                        <field name="handling_instructions"/>
                    </page>
                    <page string="Download Log" groups="myservice_security.group_security_manager">
                        <field name="download_log_ids" readonly="1">
                            <tree>
                                <field name="download_ref"/>
                                <field name="user_id"/>
                                <field name="download_datetime"/>
                                <field name="ip_address"/>
                                <field name="brief_format"/>
                                <field name="classification"/>
                            </tree>
                        </field>
                    </page>
                    <page string="Sources" attrs="{'invisible': [('brief_format', '!=', 'strategic')]}">
                        <field name="incident_ids" widget="many2many_tags"/>
                    </page>
                </notebook>
            </sheet>
            <div class="oe_chatter">
                <field name="message_follower_ids"/>
                <field name="activity_ids"/>
                <field name="message_ids"/>
            </div>
        </form>
    </field>
</record>

<!-- ── Kanban View ────────────────────────────────────────────────────────── -->
<record id="view_ai_daily_brief_kanban" model="ir.ui.view">
    <field name="name">ai.daily.brief.kanban</field>
    <field name="model">ai.daily.brief</field>
    <field name="arch" type="xml">
        <kanban default_group_by="brief_format" class="o_kanban_small_column">
            <field name="name"/>
            <field name="date"/>
            <field name="ref"/>
            <field name="classification"/>
            <field name="classification_colour"/>
            <field name="classification_label"/>
            <field name="threat_level"/>
            <field name="threat_colour"/>
            <field name="state"/>
            <field name="download_count"/>
            <templates>
                <t t-name="kanban-box">
                    <div class="oe_kanban_global_click o_kanban_record"
                         t-attf-style="border-top: 4px solid #{record.classification_colour.value}">
                        <div class="o_kanban_record_top">
                            <div class="o_kanban_record_headings">
                                <strong class="o_kanban_record_title">
                                    <t t-esc="record.name.value"/>
                                </strong>
                            </div>
                        </div>
                        <div class="o_kanban_record_body">
                            <div>
                                <span t-attf-style="background:#{record.classification_colour.value};
                                      color:#fff; padding:1px 6px; border-radius:3px;
                                      font-size:10px; font-weight:bold;">
                                    <t t-esc="record.classification_label.value"/>
                                </span>
                                <span t-attf-style="background:#{record.threat_colour.value};
                                      color:#fff; padding:1px 6px; border-radius:3px;
                                      font-size:10px; font-weight:bold; margin-left:4px;">
                                    <t t-esc="record.threat_level.value.toUpperCase()"/>
                                </span>
                            </div>
                            <div style="margin-top:6px; font-size:11px; color:#666;">
                                <t t-esc="record.date.value"/> |
                                <t t-esc="record.ref.value"/>
                            </div>
                            <div style="margin-top:4px; font-size:11px;">
                                Downloads: <strong><t t-esc="record.download_count.value"/></strong>
                            </div>
                        </div>
                        <div class="o_kanban_record_bottom">
                            <div class="oe_kanban_bottom_left">
                                <span t-attf-class="badge #{{'draft':'badge-secondary','pending_approval':'badge-warning','approved':'badge-info','released':'badge-success','recalled':'badge-danger'}.get(record.state.value,'badge-secondary')}">
                                    <t t-esc="record.state.value.replace('_',' ').title()"/>
                                </span>
                            </div>
                        </div>
                    </div>
                </t>
            </templates>
        </kanban>
    </field>
</record>

<!-- ── Search View ────────────────────────────────────────────────────────── -->
<record id="view_ai_daily_brief_search" model="ir.ui.view">
    <field name="name">ai.daily.brief.search</field>
    <field name="model">ai.daily.brief</field>
    <field name="arch" type="xml">
        <search string="Search Intelligence Briefs">
            <field name="name"/>
            <field name="ref"/>
            <filter name="filter_today" string="Today" domain="[('date','=',context_today().strftime('%Y-%m-%d'))]"/>
            <filter name="filter_released" string="Released" domain="[('state','=','released')]"/>
            <filter name="filter_pending" string="Pending Approval" domain="[('state','=','pending_approval')]"/>
            <filter name="filter_tactical" string="Tactical" domain="[('brief_format','=','tactical')]"/>
            <filter name="filter_operational" string="Operational" domain="[('brief_format','=','operational')]"/>
            <filter name="filter_strategic" string="Strategic" domain="[('brief_format','=','strategic')]"/>
            <filter name="filter_high_threat" string="High / Critical Threat"
                    domain="[('threat_level','in',['high','critical'])]"/>
            <separator/>
            <filter name="filter_secret" string="Secret +" domain="[('classification','in',['secret','top_secret'])]"/>
            <group expand="0" string="Group By">
                <filter name="group_format" string="Format" context="{'group_by':'brief_format'}"/>
                <filter name="group_classification" string="Classification" context="{'group_by':'classification'}"/>
                <filter name="group_date" string="Date" context="{'group_by':'date'}"/>
                <filter name="group_state" string="Status" context="{'group_by':'state'}"/>
            </group>
        </search>
    </field>
</record>

<!-- ── Action Window ──────────────────────────────────────────────────────── -->
<record id="action_ai_daily_brief" model="ir.actions.act_window">
    <field name="name">Intelligence Briefs</field>
    <field name="res_model">ai.daily.brief</field>
    <field name="view_mode">kanban,list,form</field>
    <field name="search_view_id" ref="view_ai_daily_brief_search"/>
    <field name="context">{'search_default_filter_today': 1}</field>
</record>

<!-- ── Download Log Action ────────────────────────────────────────────────── -->
<record id="action_brief_download_log" model="ir.actions.act_window">
    <field name="name">Brief Download Log</field>
    <field name="res_model">ai.brief.download.log</field>
    <field name="view_mode">list</field>
    <field name="groups_id" eval="[(4, ref('myservice_security.group_security_manager'))]"/>
</record>

</odoo>
