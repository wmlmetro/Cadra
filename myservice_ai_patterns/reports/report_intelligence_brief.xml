<?xml version="1.0" encoding="utf-8"?>
<odoo>

<!-- ════════════════════════════════════════════════════════════════════════
     NRS DAILY INTELLIGENCE BRIEF — QWeb PDF Report Template
     Supports: Tactical (1p) / Operational (2p) / Strategic (4-6p)
     Security: Dynamic per-user watermark, classification banner, legal footer
     Paper format: A4 Portrait, all margins 15mm
════════════════════════════════════════════════════════════════════════ -->

<template id="report_intelligence_brief_document">
<t t-call="web.html_container">
<t t-foreach="docs" t-as="o">

<!-- ── Inline CSS ────────────────────────────────────────────────────── -->
<style>
  * { box-sizing: border-box; margin: 0; padding: 0; font-family: Arial, sans-serif; }
  body { font-size: 10pt; color: #1A1A1A; }

  /* Classification banner */
  .cls-banner {
    width: 100%; padding: 5px 12px; text-align: center;
    font-size: 11pt; font-weight: bold; letter-spacing: 2px;
    color: #FFFFFF; margin-bottom: 0;
  }

  /* Page header */
  .brief-header {
    display: table; width: 100%; border: 1.5px solid #1A1A1A;
    border-top: none; margin-bottom: 12px;
  }
  .brief-header-logo { display: table-cell; width: 20%; padding: 8px; vertical-align: middle; }
  .brief-header-title { display: table-cell; width: 60%; padding: 8px; text-align: center; vertical-align: middle; }
  .brief-header-threat { display: table-cell; width: 20%; padding: 8px; text-align: center; vertical-align: middle; }
  .brief-org { font-size: 8pt; color: #555; margin-top: 2px; }
  .brief-title-main { font-size: 14pt; font-weight: bold; color: #1A1A1A; }
  .brief-title-sub { font-size: 9pt; color: #555; margin-top: 3px; }

  /* Threat indicator */
  .threat-box { padding: 6px; border-radius: 3px; }
  .threat-label { font-size: 8pt; color: #fff; font-weight: bold; letter-spacing: 1px; }
  .threat-level { font-size: 13pt; font-weight: bold; color: #fff; }

  /* Metadata bar */
  .meta-bar {
    display: table; width: 100%; background: #F4F4F4;
    border: 0.5px solid #C8C5BC; padding: 5px 10px;
    font-size: 8.5pt; margin-bottom: 12px;
  }
  .meta-cell { display: table-cell; padding: 2px 8px; }
  .meta-label { color: #666; font-size: 7.5pt; }
  .meta-value { font-weight: bold; color: #1A1A1A; }

  /* Sections */
  .section { margin-bottom: 12px; }
  .section-header {
    background: #1A1A1A; color: #FFFFFF; padding: 4px 10px;
    font-size: 9pt; font-weight: bold; letter-spacing: 1px;
    margin-bottom: 6px;
  }
  .section-header.restricted { background: #1565C0; }
  .section-header.confidential { background: #E65100; }
  .section-header.secret { background: #B71C1C; }
  .section-header.top_secret { background: #0D0D0D; }
  .section-body { padding: 0 10px; font-size: 9.5pt; line-height: 1.5; }
  .section-body ul { margin: 4px 0 4px 16px; }
  .section-body li { margin-bottom: 3px; }

  /* Bullet items converted from newlines */
  .intel-bullet { padding: 3px 0; border-bottom: 0.5px solid #ECEAE4; font-size: 9pt; }
  .intel-bullet:last-child { border-bottom: none; }

  /* Two-column layout for tactical */
  .two-col { display: table; width: 100%; }
  .col-left { display: table-cell; width: 50%; padding-right: 8px; vertical-align: top; }
  .col-right { display: table-cell; width: 50%; padding-left: 8px; vertical-align: top; }

  /* Distribution box */
  .dist-box {
    border: 1px solid #C8102E; padding: 6px 10px;
    margin-bottom: 10px; font-size: 8.5pt;
  }
  .dist-label { font-weight: bold; color: #C8102E; font-size: 9pt; }

  /* Watermark — diagonal, semi-transparent */
  .watermark {
    position: fixed; top: 35%; left: -5%;
    width: 110%; text-align: center;
    font-size: 13pt; font-weight: bold;
    color: rgba(150, 0, 0, 0.12);
    transform: rotate(-35deg);
    line-height: 2.2;
    letter-spacing: 1px;
    pointer-events: none;
    z-index: 0;
    white-space: pre-line;
  }

  /* Source count badge */
  .badge {
    display: inline-block; padding: 1px 6px; border-radius: 3px;
    font-size: 8pt; font-weight: bold; margin-left: 6px;
  }
  .badge-red { background: #FCE4EC; color: #C8102E; }
  .badge-blue { background: #E3F2FD; color: #0C447C; }
  .badge-amber { background: #FFF8E1; color: #E65100; }

  /* Page footer (handled by report layout) */
  .page-footer {
    font-size: 7.5pt; color: #555; border-top: 1px solid #1A1A1A;
    padding-top: 4px; margin-top: 10px;
  }
  .footer-cls { font-weight: bold; }
  .footer-legal { color: #B71C1C; font-style: italic; }
</style>

<!-- ════════════════════════════════════════════════════════════════ -->
<!-- PAGE WRAPPER                                                     -->
<!-- ════════════════════════════════════════════════════════════════ -->
<div class="page">

  <!-- ── Watermark (diagonal, per-user) ──────────────────────────── -->
  <div class="watermark">
    <t t-esc="watermark_line1"/>
    <br/>
    <t t-esc="watermark_line2"/>
    <br/>
    <t t-esc="watermark_line3"/>
  </div>

  <!-- ── Classification Banner (top) ────────────────────────────── -->
  <div class="cls-banner" t-attf-style="background-color: #{o.classification_colour};">
    <t t-esc="o.classification_label"/> — <t t-esc="dict(o.fields_get(['distribution_caveat'], ['selection'])['distribution_caveat']['selection']).get(o.distribution_caveat, 'NRS INTERNAL ONLY')"/>
  </div>

  <!-- ── Document Header ─────────────────────────────────────────── -->
  <div class="brief-header">
    <div class="brief-header-logo">
      <strong style="font-size:18pt; color:#C8102E;">NRS</strong>
      <div class="brief-org">Nigeria Revenue Service</div>
      <div class="brief-org">Security Intelligence Unit</div>
    </div>
    <div class="brief-header-title">
      <div class="brief-title-main">DAILY INTELLIGENCE BRIEF</div>
      <div class="brief-title-sub">
        <t t-if="o.brief_format == 'tactical'">TACTICAL — FIELD SECURITY TEAMS</t>
        <t t-elif="o.brief_format == 'operational'">OPERATIONAL — SECURITY OFFICERS</t>
        <t t-else="">STRATEGIC — SENIOR MANAGEMENT</t>
      </div>
    </div>
    <div class="brief-header-threat">
      <div class="threat-box" t-attf-style="background-color: #{o.threat_colour};">
        <div class="threat-label">THREAT LEVEL</div>
        <div class="threat-level"><t t-esc="(o.threat_level or '').upper()"/></div>
      </div>
    </div>
  </div>

  <!-- ── Metadata Bar ─────────────────────────────────────────────── -->
  <div class="meta-bar">
    <div class="meta-cell">
      <div class="meta-label">BRIEF REF</div>
      <div class="meta-value"><t t-esc="o.ref or 'PENDING'"/></div>
    </div>
    <div class="meta-cell">
      <div class="meta-label">DATE OF ISSUE</div>
      <div class="meta-value"><t t-esc="o.date"/></div>
    </div>
    <div class="meta-cell">
      <div class="meta-label">TIME OF ISSUE</div>
      <div class="meta-value"><t t-esc="o.time_of_issue or '—'"/></div>
    </div>
    <div class="meta-cell">
      <div class="meta-label">CLASSIFICATION</div>
      <div class="meta-value" t-attf-style="color: #{o.classification_colour}">
        <t t-esc="o.classification_label"/>
      </div>
    </div>
    <div class="meta-cell">
      <div class="meta-label">SOURCES ANALYSED</div>
      <div class="meta-value"><t t-esc="o.acled_entry_count"/> OSINT entries</div>
    </div>
    <div class="meta-cell">
      <div class="meta-label">PREPARED BY</div>
      <div class="meta-value"><t t-esc="o.prepared_by.name or '—'"/></div>
    </div>
    <div class="meta-cell">
      <div class="meta-label">APPROVED BY</div>
      <div class="meta-value"><t t-esc="o.approved_by.name or 'PENDING'"/></div>
    </div>
  </div>

  <!-- ── Distribution Box ─────────────────────────────────────────── -->
  <div class="dist-box">
    <span class="dist-label">DISTRIBUTION: </span>
    <t t-if="o.distribution_list">
      <t t-foreach="o.distribution_list" t-as="u"><t t-esc="u.name"/><t t-if="not u_last">, </t></t>
    </t>
    <t t-else="">
      <t t-esc="dict(o.fields_get(['distribution_caveat'], ['selection'])['distribution_caveat']['selection']).get(o.distribution_caveat, 'NRS INTERNAL ONLY')"/>
    </t>
  </div>

  <!-- ══════════════════════════════════════════════════════════════ -->
  <!-- SECTION 1 — EXECUTIVE SUMMARY (all formats)                   -->
  <!-- ══════════════════════════════════════════════════════════════ -->
  <div class="section">
    <div t-attf-class="section-header #{o.classification}">SECTION 1 — EXECUTIVE SUMMARY</div>
    <div class="section-body">
      <ul>
        <t t-foreach="(o.exec_summary or 'No summary generated.').split('\n')" t-as="line">
          <li t-if="line.strip()"><t t-esc="line.strip().lstrip('- •')"/></li>
        </t>
      </ul>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════════════════════ -->
  <!-- SECTION 2 — THREAT LANDSCAPE (operational + strategic)        -->
  <!-- ══════════════════════════════════════════════════════════════ -->
  <t t-if="o.brief_format in ('operational', 'strategic')">
    <div class="section">
      <div t-attf-class="section-header #{o.classification}">SECTION 2 — THREAT LANDSCAPE</div>
      <div class="section-body">
        <t t-foreach="(o.threat_landscape or 'No threat landscape generated.').split('\n')" t-as="line">
          <div t-if="line.strip()" class="intel-bullet"><t t-esc="line.strip()"/></div>
        </t>
      </div>
    </div>
  </t>

  <!-- ══════════════════════════════════════════════════════════════ -->
  <!-- SECTION 3 — INTELLIGENCE ENTRIES (strategic only)             -->
  <!-- ══════════════════════════════════════════════════════════════ -->
  <t t-if="o.brief_format == 'strategic'">
    <div class="section">
      <div t-attf-class="section-header #{o.classification}">
        SECTION 3 — INTELLIGENCE ENTRIES
        <span class="badge badge-red"><t t-esc="len(o.osint_entry_ids)"/> entries</span>
      </div>
      <div class="section-body">
        <t t-if="o.intel_entries_summary">
          <t t-foreach="o.intel_entries_summary.split('\n')" t-as="line">
            <div t-if="line.strip()" class="intel-bullet"><t t-esc="line.strip()"/></div>
          </t>
        </t>
        <t t-if="o.osint_entry_ids">
          <table style="width:100%; font-size:8.5pt; border-collapse:collapse; margin-top:6px;">
            <tr style="background:#F4F4F4;">
              <th style="padding:3px 6px; border:0.5px solid #CCC; text-align:left;">Date</th>
              <th style="padding:3px 6px; border:0.5px solid #CCC; text-align:left;">Title</th>
              <th style="padding:3px 6px; border:0.5px solid #CCC; text-align:left;">Location</th>
              <th style="padding:3px 6px; border:0.5px solid #CCC; text-align:left;">Source</th>
              <th style="padding:3px 6px; border:0.5px solid #CCC; text-align:left;">Threat</th>
            </tr>
            <t t-foreach="o.osint_entry_ids[:20]" t-as="e">
              <tr>
                <td style="padding:3px 6px; border:0.5px solid #E0E0E0;"><t t-esc="e.event_date"/></td>
                <td style="padding:3px 6px; border:0.5px solid #E0E0E0;"><t t-esc="e.title[:60] if e.title else '—'"/></td>
                <td style="padding:3px 6px; border:0.5px solid #E0E0E0;"><t t-esc="e.state_name or '—'"/></td>
                <td style="padding:3px 6px; border:0.5px solid #E0E0E0;"><t t-esc="e.source_name or '—'"/></td>
                <td style="padding:3px 6px; border:0.5px solid #E0E0E0; font-weight:bold;
                  " t-attf-style="color: #{{'critical':'#B71C1C','high':'#E65100','moderate':'#633806','info':'#0C447C'}.get(e.threat_level,'#333')}">
                  <t t-esc="(e.threat_level or '').upper()"/>
                </td>
              </tr>
            </t>
          </table>
        </t>
      </div>
    </div>
  </t>

  <!-- ══════════════════════════════════════════════════════════════ -->
  <!-- SECTION 4 — WATCHLIST (operational + strategic)               -->
  <!-- ══════════════════════════════════════════════════════════════ -->
  <t t-if="o.brief_format in ('operational', 'strategic')">
    <div class="section">
      <div t-attf-class="section-header #{o.classification}">
        SECTION 4 — WATCHLIST UPDATES
        <span class="badge badge-blue"><t t-esc="len(o.watchlist_ids)"/> active</span>
      </div>
      <div class="section-body">
        <t t-foreach="(o.watchlist_summary or 'No watchlist entries.').split('\n')" t-as="line">
          <div t-if="line.strip()" class="intel-bullet"><t t-esc="line.strip()"/></div>
        </t>
      </div>
    </div>
  </t>

  <!-- ══════════════════════════════════════════════════════════════ -->
  <!-- SECTION 5 — RECOMMENDATIONS (all formats)                     -->
  <!-- ══════════════════════════════════════════════════════════════ -->
  <div class="section">
    <div t-attf-class="section-header #{o.classification}">SECTION 5 — RECOMMENDATIONS</div>
    <div class="section-body">
      <ol style="margin-left:16px;">
        <t t-foreach="(o.recommendations or 'No recommendations generated.').split('\n')" t-as="line">
          <li t-if="line.strip()" style="margin-bottom:3px;"><t t-esc="line.strip().lstrip('0123456789.-) ')"/></li>
        </t>
      </ol>
    </div>
  </div>

  <!-- ══════════════════════════════════════════════════════════════ -->
  <!-- SECTION 6 — HANDLING INSTRUCTIONS (operational + strategic)   -->
  <!-- ══════════════════════════════════════════════════════════════ -->
  <t t-if="o.brief_format in ('operational', 'strategic')">
    <div class="section">
      <div t-attf-class="section-header #{o.classification}">SECTION 6 — HANDLING INSTRUCTIONS</div>
      <div class="section-body">
        <t t-foreach="(o.handling_instructions or '').split('\n')" t-as="line">
          <div t-if="line.strip()" class="intel-bullet"><t t-esc="line.strip()"/></div>
        </t>
        <div class="intel-bullet">
          <strong>Classification Authority:</strong>
          <t t-esc="o.approved_by.name or o.prepared_by.name or 'NRS Security Manager'"/>
        </div>
        <div class="intel-bullet">
          <strong>Approved:</strong>
          <t t-esc="o.approved_date or 'Pending approval'"/>
        </div>
      </div>
    </div>
  </t>

  <!-- ── Download Log Reference ──────────────────────────────────── -->
  <div style="margin-top:12px; font-size:7.5pt; color:#888; border-top:0.5px solid #CCC; padding-top:4px;">
    Download Reference: <strong><t t-esc="download_ref"/></strong> |
    Downloaded by: <t t-esc="downloaded_by"/> |
    Date/Time: <t t-esc="download_datetime"/>
  </div>

  <!-- ── Classification Banner (bottom) ─────────────────────────── -->
  <div class="cls-banner" style="margin-top:8px;"
    t-attf-style="background-color: #{o.classification_colour};">
    <t t-esc="o.classification_label"/> — UNAUTHORISED DISCLOSURE IS AN OFFENCE UNDER THE OFFICIAL SECRETS ACT (CAP O3 LFN 2004)
  </div>

</div>
</t>
</t>
</template>

<!-- ── Report Action ──────────────────────────────────────────────── -->
<record id="action_report_intelligence_brief" model="ir.actions.report">
    <field name="name">Intelligence Brief</field>
    <field name="model">ai.daily.brief</field>
    <field name="report_type">qweb-pdf</field>
    <field name="report_name">myservice_ai_patterns.report_intelligence_brief_document</field>
    <field name="report_file">myservice_ai_patterns.report_intelligence_brief_document</field>
    <field name="binding_model_id" ref="model_ai_daily_brief"/>
    <field name="binding_type">report</field>
    <field name="paper_format_id" ref="base.paperformat_euro"/>
</record>

</odoo>
