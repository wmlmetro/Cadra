<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- ── Extend fleet.vehicle form ── -->
    <record id="view_fleet_vehicle_form_maintenance" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.maintenance</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">

            <!-- Add stat button for maintenance tickets -->
            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_maintenance_tickets"
                    type="object"
                    class="oe_stat_button"
                    icon="fa-wrench"
                    attrs="{'invisible': [('open_maintenance_ticket_count', '=', 0)]}">
                    <field name="open_maintenance_ticket_count"
                        widget="statinfo"
                        string="Maint. Tickets"/>
                </button>
            </xpath>

            <!-- Add maintenance status badge next to vehicle name -->
            <xpath expr="//div[@class='oe_title']" position="after">
                <div class="alert alert-warning mb0"
                    attrs="{'invisible': [('maintenance_status', 'not in', ['due_soon','overdue'])]}">
                    <strong>
                        <span attrs="{'invisible': [('maintenance_status','!=','overdue')]}">
                            ⚠️ Maintenance OVERDUE — service required immediately.
                        </span>
                        <span attrs="{'invisible': [('maintenance_status','!=','due_soon')]}">
                            🔔 Maintenance due soon — please schedule service.
                        </span>
                    </strong>
                </div>
            </xpath>

            <!-- Add NRS Fleet fields page -->
            <xpath expr="//page[@name='information']" position="after">
                <page name="nrs_maintenance" string="Maintenance Schedule">
                    <group>
                        <group string="Assignment">
                            <field name="home_location_id"
                                options="{'no_create': True}"
                                placeholder="Select FIRS office…"/>
                            <field name="driver_id"
                                options="{'no_create': True}"
                                placeholder="Assigned driver…"/>
                            <field name="fleet_manager_id"
                                placeholder="Fleet manager…"/>
                            <field name="preferred_vendor_id"
                                options="{'no_create': True}"
                                placeholder="Preferred service vendor…"/>
                        </group>
                        <group string="Maintenance Status">
                            <field name="maintenance_status"
                                widget="badge"
                                decoration-success="maintenance_status == 'ok'"
                                decoration-warning="maintenance_status == 'due_soon'"
                                decoration-danger="maintenance_status == 'overdue'"
                                decoration-info="maintenance_status == 'no_schedule'"/>
                            <field name="next_service_date"/>
                            <field name="next_service_odometer"/>
                        </group>
                    </group>
                    <group>
                        <group string="Service Intervals">
                            <field name="service_interval_days"/>
                            <field name="service_interval_km"/>
                            <field name="alert_before_days"/>
                            <field name="alert_before_km"/>
                            <field name="manual_next_service_date"/>
                        </group>
                        <group string="Last Service">
                            <field name="last_service_date"/>
                            <field name="last_service_odometer"/>
                        </group>
                    </group>
                    <div class="text-center mt16">
                        <button name="action_log_service_complete"
                            type="object"
                            string="Log Service Completion"
                            class="btn btn-primary"
                            icon="fa-check-circle"/>
                    </div>
                </page>
            </xpath>

        </field>
    </record>

    <!-- ── Extend fleet.vehicle list ── -->
    <record id="view_fleet_vehicle_list_maintenance" model="ir.ui.view">
        <field name="name">fleet.vehicle.list.maintenance</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_list"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state_id']" position="after">
                <field name="maintenance_status"
                    widget="badge"
                    decoration-success="maintenance_status == 'ok'"
                    decoration-warning="maintenance_status == 'due_soon'"
                    decoration-danger="maintenance_status == 'overdue'"
                    optional="show"/>
                <field name="next_service_date" optional="show"/>
                <field name="home_location_id" optional="show"/>
            </xpath>
        </field>
    </record>

    <!-- ── Extend request form for maintenance fields ── -->
    <record id="view_request_maintenance_fields" model="ir.ui.view">
        <field name="name">request.request.form.maintenance</field>
        <field name="model">request.request</field>
        <field name="inherit_id" ref="generic_request.view_request_request_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='vehicle_id']" position="after">
                <field name="is_maintenance_ticket" invisible="1"/>
                <field name="service_completion_date"
                    attrs="{'invisible': [('is_maintenance_ticket','=',False)]}"/>
                <field name="service_odometer_reading"
                    attrs="{'invisible': [('is_maintenance_ticket','=',False)]}"/>
                <field name="service_vendor_id"
                    attrs="{'invisible': [('is_maintenance_ticket','=',False)]}"
                    options="{'no_create': True}"/>
                <field name="service_notes"
                    attrs="{'invisible': [('is_maintenance_ticket','=',False)]}"/>
            </xpath>
        </field>
    </record>

    <!-- ── Maintenance Dashboard action ── -->
    <record id="action_fleet_maintenance_dashboard" model="ir.actions.act_window">
        <field name="name">Maintenance Dashboard</field>
        <field name="res_model">fleet.vehicle</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('maintenance_status', 'in', ['due_soon', 'overdue'])]</field>
        <field name="context">{'search_default_due': 1}</field>
    </record>

</odoo>
