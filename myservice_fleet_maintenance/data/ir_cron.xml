<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- maintenance_status is a stored compute measured against today's
             date, so it goes wrong the day next_service_date passes and no
             @api.depends can ever fire for it. See the docstring on
             fleet.vehicle._cron_refresh_maintenance_status.

             priority 1 puts this ahead of the ticket-creating cron below
             (default 5) in the same pass — ir.cron orders ready jobs by
             failure_count, priority, id — because that cron decides what to
             raise a ticket for by reading this very column. -->
        <record id="ir_cron_fleet_refresh_maintenance_status" model="ir.cron">
            <field name="name">Fleet: Refresh Maintenance Status</field>
            <field name="model_id" ref="fleet.model_fleet_vehicle"/>
            <field name="state">code</field>
            <field name="code">model._cron_refresh_maintenance_status()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="priority">1</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>

        <record id="ir_cron_fleet_preventive_maintenance" model="ir.cron">
            <field name="name">Fleet: Check Preventive Maintenance Due</field>
            <field name="model_id" ref="fleet.model_fleet_vehicle"/>
            <field name="state">code</field>
            <field name="code">model._cron_check_preventive_maintenance()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active">True</field>
            <field name="user_id" ref="base.user_root"/>
        </record>
    </data>
</odoo>
