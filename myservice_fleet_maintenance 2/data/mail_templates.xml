<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="email_template_maintenance_alert" model="mail.template">
            <field name="name">Fleet: Preventive Maintenance Alert</field>
            <field name="model_id" ref="generic_request.model_request_request"/>
            <field name="subject">⚠️ Maintenance Due — {{ctx.get('vehicle').name}} [{{ctx.get('vehicle').license_plate or ctx.get('vehicle').vin_sn or 'N/A'}}]</field>
            <field name="email_to">{{ctx.get('email_to', '')}}</field>
            <field name="email_from">{{(object.company_id.email or user.email or '') | safe}}</field>
            <field name="body_html" type="html">
<div style="font-family: Arial, sans-serif; max-width: 600px; margin: 0 auto; border: 1px solid #e0e0e0; border-radius: 8px; overflow: hidden;">
    <div style="background-color: #1A1A1A; padding: 24px; text-align: center;">
        <h1 style="color: #E85426; margin: 0; font-size: 22px;">NRS Fleet Maintenance Alert</h1>
        <p style="color: #ffffff; margin: 8px 0 0 0; font-size: 14px;">myservice.com.ng</p>
    </div>
    <div style="padding: 24px;">
        <p style="font-size: 16px; color: #1C1C1C;">A vehicle under your responsibility requires <strong>preventive maintenance</strong>.</p>

        <table style="width: 100%; border-collapse: collapse; margin: 16px 0;">
            <tr style="background: #F4F4F4;">
                <td style="padding: 10px 12px; font-weight: bold; width: 40%;">Vehicle</td>
                <td style="padding: 10px 12px;">{{ctx.get('vehicle').name}}</td>
            </tr>
            <tr>
                <td style="padding: 10px 12px; font-weight: bold;">License Plate</td>
                <td style="padding: 10px 12px;">{{ctx.get('vehicle').license_plate or 'N/A'}}</td>
            </tr>
            <tr style="background: #F4F4F4;">
                <td style="padding: 10px 12px; font-weight: bold;">Chassis Number</td>
                <td style="padding: 10px 12px;">{{ctx.get('vehicle').vin_sn or 'N/A'}}</td>
            </tr>
            <tr>
                <td style="padding: 10px 12px; font-weight: bold;">Status</td>
                <td style="padding: 10px 12px; color: #E85426; font-weight: bold;">
                    {{ctx.get('vehicle').maintenance_status|upper}}
                </td>
            </tr>
            <tr style="background: #F4F4F4;">
                <td style="padding: 10px 12px; font-weight: bold;">Next Service Date</td>
                <td style="padding: 10px 12px;">{{ctx.get('vehicle').next_service_date or 'Not set'}}</td>
            </tr>
            <tr>
                <td style="padding: 10px 12px; font-weight: bold;">Next Service Odometer</td>
                <td style="padding: 10px 12px;">{{'{:,.0f}'.format(ctx.get('vehicle').next_service_odometer or 0)}} km</td>
            </tr>
            <tr style="background: #F4F4F4;">
                <td style="padding: 10px 12px; font-weight: bold;">Home Location</td>
                <td style="padding: 10px 12px;">{{ctx.get('vehicle').home_location_id.name if ctx.get('vehicle').home_location_id else 'N/A'}}</td>
            </tr>
            <tr>
                <td style="padding: 10px 12px; font-weight: bold;">Preferred Vendor</td>
                <td style="padding: 10px 12px;">{{ctx.get('vehicle').preferred_vendor_id.name if ctx.get('vehicle').preferred_vendor_id else 'Not assigned'}}</td>
            </tr>
            <tr style="background: #F4F4F4;">
                <td style="padding: 10px 12px; font-weight: bold;">Ticket Reference</td>
                <td style="padding: 10px 12px;">{{ctx.get('ticket').name if ctx.get('ticket') else 'N/A'}}</td>
            </tr>
        </table>

        <div style="background: #fdf1ed; border-left: 4px solid #E85426; padding: 12px 16px; margin: 16px 0;">
            <p style="margin: 0; color: #1C1C1C; font-size: 14px;">
                <strong>Action Required:</strong> Please coordinate to schedule and complete this maintenance.
                The service ticket will remain open until maintenance is confirmed and logged in the system.
            </p>
        </div>

        <p style="text-align: center; margin-top: 24px;">
            <a href="https://myservice.com.ng/web"
               style="background-color: #E85426; color: white; padding: 12px 28px;
                      text-decoration: none; border-radius: 6px; font-weight: bold;
                      display: inline-block;">
                View Ticket in myservice
            </a>
        </p>
    </div>
    <div style="background: #F4F4F4; padding: 16px; text-align: center; font-size: 12px; color: #666;">
        <p style="margin: 0;">NRS Facilities Management Platform | myservice.com.ng</p>
        <p style="margin: 4px 0 0 0;">This is an automated alert. Do not reply to this email.</p>
    </div>
</div>
            </field>
            <field name="auto_delete" eval="True"/>
        </record>

    </data>
</odoo>
