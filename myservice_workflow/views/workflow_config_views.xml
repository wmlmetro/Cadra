<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_workflow_config_form" model="ir.ui.view">
        <field name="name">workflow.config.form</field>
        <field name="model">workflow.config</field>
        <field name="arch" type="xml">
            <form string="WorkSpace Integration Configuration">
                <header>
                    <button name="action_test_connection" string="Test Connection"
                        type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Adapter">
                            <field name="adapter_type"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Callback / Webhook">
                            <field name="callback_enabled" widget="boolean_toggle"/>
                            <field name="callback_token"
                                attrs="{'invisible': [('callback_enabled','=',False)]}"/>
                            <field name="callback_url_hint"
                                attrs="{'invisible': [('callback_enabled','=',False)]}"
                                widget="url"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="REST API Settings"
                            attrs="{'invisible': [('adapter_type','!=','rest')]}">
                            <group>
                                <group>
                                    <field name="rest_base_url" placeholder="https://workflow.nrs.gov.ng/api/v1"/>
                                    <field name="rest_endpoint_submit"/>
                                    <field name="rest_timeout"/>
                                </group>
                                <group string="Authentication">
                                    <field name="rest_auth_type"/>
                                    <field name="rest_api_key_header"
                                        attrs="{'invisible': [('rest_auth_type','not in',['apikey'])]}"/>
                                    <field name="rest_api_key"
                                        attrs="{'invisible': [('rest_auth_type','not in',['apikey','bearer'])]}"
                                        password="True"/>
                                    <field name="rest_username"
                                        attrs="{'invisible': [('rest_auth_type','!=','basic')]}"/>
                                    <field name="rest_password"
                                        attrs="{'invisible': [('rest_auth_type','!=','basic')]}"
                                        password="True"/>
                                </group>
                            </group>
                        </page>
                        <page string="Email Settings"
                            attrs="{'invisible': [('adapter_type','!=','email')]}">
                            <group>
                                <field name="email_to" placeholder="workflow-inbox@nrs.gov.ng"/>
                                <field name="email_subject_prefix"/>
                            </group>
                        </page>
                        <page string="Stage Mapping">
                            <group>
                                <field name="trigger_stage_ids" widget="many2many_tags"
                                    options="{'no_create': True}"/>
                                <field name="approved_stage_id" options="{'no_create': True}"/>
                                <field name="rejected_stage_id" options="{'no_create': True}"/>
                            </group>
                        </page>
                        <page string="Payload Options">
                            <group>
                                <field name="include_attachments" widget="boolean_toggle"/>
                                <field name="payload_template" widget="code"/>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="notes" nolabel="1"
                                placeholder="Integration notes for the NRS IT team..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_workflow_config_list" model="ir.ui.view">
        <field name="name">workflow.config.list</field>
        <field name="model">workflow.config</field>
        <field name="arch" type="xml">
            <tree string="Workflow Configurations">
                <field name="name"/>
                <field name="adapter_type"/>
                <field name="callback_enabled"/>
                <field name="active" widget="boolean_toggle"/>
            </tree>
        </field>
    </record>

    <record id="action_workflow_config" model="ir.actions.act_window">
        <field name="name">WorkSpace Integration</field>
        <field name="res_model">workflow.config</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
