<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_workflow_config_form" model="ir.ui.view">
        <field name="name">workflow.config.form</field>
        <field name="model">workflow.config</field>
        <field name="arch" type="xml">
            <form string="WorkSpace Integration Configuration">
                <header>
                    <button name="action_test_connection" string="Test Connection"
                        type="object" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name"/></h1>
                    </div>
                    <group>
                        <group string="Adapter">
                            <field name="purpose"/>
                            <field name="adapter_type"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Callback / Webhook"
                            invisible="purpose != 'workspace'">
                            <field name="callback_enabled" widget="boolean_toggle"/>
                            <field name="callback_token"
                                invisible="callback_enabled == False"/>
                            <field name="callback_url_hint"
                                invisible="callback_enabled == False"
                                widget="url"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="REST API Settings"
                            invisible="adapter_type != 'rest'">
                            <group>
                                <group>
                                    <field name="rest_base_url" placeholder="https://workflow.nrs.gov.ng/api/v1"/>
                                    <field name="rest_endpoint_submit"
                                        invisible="purpose != 'workspace'"
                                        required="purpose == 'workspace'"/>
                                    <!-- Shown for BOTH event purposes: INT-05
                                         carries asset.tag.affixed to Vendra and
                                         INT-09 carries lifecycle changes to SAP,
                                         and both resolve through this field. -->
                                    <field name="rest_endpoint_event"
                                        invisible="purpose == 'workspace'"
                                        placeholder="/api/method/vendra_network.api.tag_event"/>
                                    <!-- Handoff 62: asset.register_state.changed
                                         goes to its own receiver on the same
                                         Vendra. Blank: nothing is queued. -->
                                    <field name="rest_endpoint_register_state"
                                        invisible="purpose != 'asset_events'"
                                        placeholder="/api/method/vendra_network.api.cadra.register_state_event"/>
                                    <field name="rest_endpoint_asset_master"
                                        invisible="purpose != 'sap_assets'"
                                        required="purpose == 'sap_assets' and adapter_type == 'rest'"
                                        placeholder="/fixed-assets"/>
                                    <field name="sap_company_code"
                                        invisible="purpose != 'sap_assets'"
                                        placeholder="NRS1"/>
                                    <field name="rest_timeout"/>
                                </group>
                                <group string="Authentication">
                                    <field name="rest_auth_type"/>
                                    <field name="rest_api_key_header"
                                        invisible="rest_auth_type not in ['apikey']"/>
                                    <field name="rest_api_key"
                                        invisible="rest_auth_type not in ['apikey', 'bearer']"
                                        password="True"/>
                                    <field name="rest_username"
                                        invisible="rest_auth_type != 'basic'"/>
                                    <field name="rest_password"
                                        invisible="rest_auth_type != 'basic'"
                                        password="True"/>
                                </group>
                            </group>
                        </page>
                        <page string="Email Settings"
                            invisible="adapter_type != 'email'">
                            <group>
                                <field name="email_to" placeholder="workflow-inbox@nrs.gov.ng"/>
                                <field name="email_subject_prefix"/>
                            </group>
                        </page>
                        <page string="Event Delivery"
                            invisible="purpose == 'workspace'">
                            <div class="alert alert-info" role="alert">
                                Asset lifecycle events are queued, not sent
                                inline: an affix confirmation is recorded in
                                Cadra whether or not the receiver is up, and
                                the queue keeps trying. Delivery state lives
                                in the Dispatch Log; abandoned events appear
                                under Failed Deliveries.
                            </div>
                            <group>
                                <group string="Delivery">
                                    <field name="event_enabled" widget="boolean_toggle"/>
                                </group>
                                <group string="Retry Policy">
                                    <field name="retry_max_attempts"/>
                                    <field name="retry_base_seconds"/>
                                    <field name="retry_cap_seconds"/>
                                </group>
                            </group>
                        </page>
                        <page string="Stage Mapping"
                            invisible="purpose != 'workspace'">
                            <group>
                                <field name="trigger_stage_ids" widget="many2many_tags"
                                    options="{'no_create': True}"/>
                                <field name="approved_stage_id" options="{'no_create': True}"/>
                                <field name="rejected_stage_id" options="{'no_create': True}"/>
                            </group>
                        </page>
                        <page string="Payload Options"
                            invisible="purpose != 'workspace'">
                            <group>
                                <field name="include_attachments" widget="boolean_toggle"/>
                                <field name="payload_template" widget="code"/>
                            </group>
                        </page>
                        <page string="Notes">
                            <field name="notes" nolabel="1"
                                placeholder="Integration notes for the NRS IT team..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_workflow_config_list" model="ir.ui.view">
        <field name="name">workflow.config.list</field>
        <field name="model">workflow.config</field>
        <field name="arch" type="xml">
            <list string="Workflow Configurations">
                <field name="name"/>
                <field name="purpose"/>
                <field name="adapter_type"/>
                <field name="callback_enabled"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <record id="action_workflow_config" model="ir.actions.act_window">
        <field name="name">WorkSpace Integration</field>
        <field name="res_model">workflow.config</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>
