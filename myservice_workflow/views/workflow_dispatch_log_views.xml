<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_workflow_dispatch_log_list" model="ir.ui.view">
        <field name="name">workflow.dispatch.log.list</field>
        <field name="model">workflow.dispatch.log</field>
        <field name="arch" type="xml">
            <!-- `error` is warning, not danger for an event: the queue will
                 try again. `dead` is the one that needs a person, so it is
                 the only red row. `sent` stays INFO rather than success —
                 on a request-approval row it means "awaiting a human
                 decision", and green there would read as resolved. -->
            <list string="WorkSpace Dispatch Log"
                  decoration-success="status in ('approved','acknowledged')"
                  decoration-danger="status in ('rejected','dead')"
                  decoration-warning="status in ('queried','error')"
                  decoration-info="status in ('pending','sent')">
                <!-- Handoff 62 §5: a day without Vendra dead-letters a day's
                     events, and re-sending them one form at a time is not a
                     recovery. Select them (Dead Letters + Asset Events) and
                     retry together; each keeps its event id. -->
                <header>
                    <button name="action_retry_now" type="object"
                        string="Retry Delivery"/>
                </header>
                <field name="name"/>
                <field name="event_type" optional="show"/>
                <field name="request_id" optional="show"/>
                <field name="asset_id" optional="show"/>
                <field name="direction" optional="hide"/>
                <field name="status" widget="badge"
                    decoration-success="status in ('approved','acknowledged')"
                    decoration-danger="status in ('rejected','dead')"
                    decoration-warning="status in ('queried','error')"
                    decoration-info="status in ('pending','sent')"/>
                <field name="attempts" optional="show"/>
                <field name="max_attempts" optional="hide"/>
                <field name="next_attempt_at" optional="show"/>
                <field name="http_status" optional="hide"/>
                <field name="workspace_ref" optional="hide"/>
                <field name="external_ref" optional="hide"/>
                <field name="payment_ref" optional="hide"/>
                <field name="sent_by" optional="hide"/>
                <field name="sent_at" optional="show"/>
                <field name="responded_at" optional="hide"/>
                <field name="adapter_type" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_workflow_dispatch_log_form" model="ir.ui.view">
        <field name="name">workflow.dispatch.log.form</field>
        <field name="model">workflow.dispatch.log</field>
        <field name="arch" type="xml">
            <form string="WorkSpace Dispatch Log">
                <header>
                    <button name="action_retry_now" type="object"
                        string="Retry Delivery" class="btn-primary"
                        invisible="not event_type or status not in ('error','dead')"
                        help="Put this event back on the delivery queue and
                              extend its attempt budget. The event id does not
                              change, so a receiver that already has it will
                              discard the repeat."/>
                    <field name="status" widget="statusbar"
                        statusbar_visible="pending,error,sent,acknowledged,dead"
                        invisible="not event_type"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <div class="alert alert-danger" role="alert"
                        invisible="status != 'dead'">
                        This event was <strong>not delivered</strong>. The
                        record in Cadra is correct; the downstream system has
                        not been told about it. Fix the cause, then use Retry
                        Delivery.
                    </div>
                    <group>
                        <group>
                            <field name="event_type" readonly="1"
                                invisible="not event_type"/>
                            <field name="event_id" readonly="1"
                                invisible="not event_type"/>
                            <field name="asset_id" readonly="1"
                                invisible="not asset_id"/>
                            <field name="tag_label_id" readonly="1"
                                invisible="not tag_label_id"/>
                            <field name="request_id" readonly="1"
                                invisible="not request_id"/>
                            <field name="direction" readonly="1"/>
                            <field name="status" readonly="1"
                                invisible="event_type"/>
                            <field name="adapter_type" readonly="1"/>
                            <field name="config_id" readonly="1"
                                invisible="not config_id"/>
                        </group>
                        <group>
                            <field name="workspace_ref" readonly="1"
                                invisible="event_type"/>
                            <field name="payment_ref" readonly="1"
                                invisible="event_type"/>
                            <field name="external_ref" readonly="1"
                                invisible="not event_type"/>
                            <field name="sent_by" readonly="1"/>
                            <field name="sent_at" readonly="1"/>
                            <field name="responded_at" readonly="1"/>
                        </group>
                    </group>
                    <group string="Delivery" invisible="not event_type">
                        <group>
                            <field name="attempts" readonly="1"/>
                            <field name="max_attempts" readonly="1"/>
                            <field name="http_status" readonly="1"/>
                        </group>
                        <group>
                            <field name="last_attempt_at" readonly="1"/>
                            <field name="next_attempt_at" readonly="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Payload Sent">
                            <field name="payload_sent" readonly="1" widget="code"/>
                        </page>
                        <page string="Response Received">
                            <field name="response_received" readonly="1" widget="code"/>
                            <field name="workflow_comment" readonly="1"/>
                        </page>
                        <page string="Delivery History"
                            invisible="not delivery_history">
                            <field name="delivery_history" readonly="1"/>
                        </page>
                        <page string="Error" invisible="error_message == False">
                            <field name="error_message" readonly="1"/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_workflow_dispatch_log_search" model="ir.ui.view">
        <field name="name">workflow.dispatch.log.search</field>
        <field name="model">workflow.dispatch.log</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="request_id"/>
                <field name="asset_id"/>
                <field name="event_id"/>
                <field name="workspace_ref"/>
                <filter name="dead" string="Dead Letters"
                    domain="[('status','=','dead')]"/>
                <filter name="retrying" string="Retrying"
                    domain="[('status','=','error'),('event_type','!=',False)]"/>
                <filter name="queued" string="Queued"
                    domain="[('status','=','pending'),('event_type','!=',False)]"/>
                <filter name="delivered" string="Delivered"
                    domain="[('status','in',['sent','acknowledged'])]"/>
                <separator/>
                <filter name="events" string="Asset Events"
                    domain="[('event_type','!=',False)]"/>
                <filter name="register_state_events" string="Register-State Events"
                    domain="[('event_type','=','asset.register_state.changed')]"/>
                <filter name="approvals" string="Request Approvals"
                    domain="[('event_type','=',False)]"/>
                <separator/>
                <filter name="pending" string="Awaiting Response" domain="[('status','=','sent')]"/>
                <filter name="approved" string="Approved" domain="[('status','=','approved')]"/>
                <filter name="rejected" string="Rejected" domain="[('status','=','rejected')]"/>
                <filter name="errors" string="Errors" domain="[('status','=','error')]"/>
                <group>
                    <filter name="by_status" string="Status" context="{'group_by':'status'}"/>
                    <filter name="by_event" string="Event" context="{'group_by':'event_type'}"/>
                    <filter name="by_adapter" string="Adapter" context="{'group_by':'adapter_type'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_workflow_dispatch_log" model="ir.actions.act_window">
        <field name="name">WorkSpace Dispatch Log</field>
        <field name="res_model">workflow.dispatch.log</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_workflow_dispatch_log_search"/>
    </record>

    <!-- A dead letter that exists only as a row nobody queries is the same
         failure the retry queue was built to remove. This is the menu an
         operator is pointed at. -->
    <record id="action_workflow_dead_letters" model="ir.actions.act_window">
        <field name="name">Failed Deliveries</field>
        <field name="res_model">workflow.dispatch.log</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('status','=','dead')]</field>
        <field name="search_view_id" ref="view_workflow_dispatch_log_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Nothing has been abandoned.
            </p>
            <p>
                Events that could not be delivered after their full attempt
                budget appear here. The Cadra record is always correct — what
                failed is telling the downstream system about it.
            </p>
        </field>
    </record>

</odoo>
