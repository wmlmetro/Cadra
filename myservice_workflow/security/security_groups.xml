<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!--
            Handoff 42, finishing what 41 started: on Odoo 19 a group reaches
            the user form only through a `res.groups.privilege` (one SELECTION
            per privilege, grouped by its category); a group with none is shown
            only under *Extra Rights* in developer mode. Display grouping only —
            no implication, no access rule changes. See the comment in
            `myservice_asset_register/security/asset_security.xml`.
        -->
        <record id="module_category_workspace" model="ir.module.category">
            <field name="name">NRS WorkSpace Integration</field>
            <field name="sequence">36</field>
        </record>
        <record id="privilege_workspace_integration" model="res.groups.privilege">
            <field name="name">WorkSpace Integration</field>
            <field name="sequence">10</field>
            <field name="category_id" ref="module_category_workspace"/>
            <field name="description">Configures the outbound transport to the NRS WorkSpace (INT-05, INT-09) and reads its dispatch log.</field>
        </record>

        <record id="group_workflow_admin" model="res.groups">
            <field name="name">WorkSpace Integration Admin</field>
            <field name="privilege_id" ref="privilege_workspace_integration"/>
            <field name="sequence">10</field>
            <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        </record>
    </data>
</odoo>
