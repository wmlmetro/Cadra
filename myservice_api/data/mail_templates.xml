<?xml version="1.0" encoding="utf-8"?>
<!--
  The two letters a person receives from their own organisation — handoff 43 §1b.

  Rendered by `res.users._action_reset_password` (models/invitation.py) with
  everything tenant-specific resolved at SEND time into `ctx['cadra_letter']`:
  the organisation's name, the brand colour and logo the per-client
  `cadra_brand_*` module put in `cadra.brand_*`, the link on the host the
  request came in on, and the validity of that link. The template itself
  names no client and no host.

  Six things the handoff asked for, and where each is kept:
    1. the tenant's brand, resolved at send time     — `cadra_letter` (Python)
    2. the link points at the tenant's own host       — `cadra_letter.link`
    3. readable with images blocked                   — every instruction is
       text; the logo is optional; the link is printed in full under the
       button, so the text/plain part Odoo derives (html2plaintext) carries it
    4. no secret in the body                          — a link the person
       redeems; no password anywhere
    5. says what it is in one line                    — the first sentence
    6. the reset-password email too                   — the second template

  NOT noupdate: these are the module's, and an upgrade keeps them current. A
  tenant that edits them in the back office will see the edit overwritten on
  the next upgrade, which is said here so it is not a surprise.
-->
<odoo>
  <data>

    <record id="mail_template_invitation" model="mail.template">
      <field name="name">Cadra: invitation to the asset register</field>
      <field name="model_id" ref="base.model_res_users"/>
      <field name="subject">{{ ctx.get('cadra_letter', {}).get('organisation', 'Cadra') }} asset register — your access</field>
      <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted or '') }}</field>
      <field name="use_default_to" eval="True"/>
      <field name="lang">{{ object.lang }}</field>
      <field name="auto_delete" eval="True"/>
      <field name="body_html" type="html">
<t t-set="L" t-value="ctx.get('cadra_letter') or {}"/>
<table border="0" cellpadding="0" cellspacing="0" width="100%" style="background:#f4f5f7;padding:24px 0;font-family:Arial,Helvetica,sans-serif;">
  <tr><td align="center">
    <table border="0" cellpadding="0" cellspacing="0" width="600" style="max-width:600px;width:100%;background:#ffffff;border-radius:8px;overflow:hidden;">
      <tr>
        <!-- A logo sits on WHITE with the brand colour as a rule beneath it: a
             client's logo carries its own colours (Jaiz's wordmark is navy, on
             a navy band it vanished — report 43 §C). A wordmark-only tenant
             gets the colour as the band. -->
        <td t-if="L.get('logo_url')" t-attf-style="background:#ffffff;border-bottom:5px solid {{ L.get('primary') }};padding:20px 28px;">
          <img t-att-src="L.get('logo_url')" t-att-alt="L.get('organisation')" height="44" style="height:44px;max-height:44px;display:block;"/>
        </td>
        <td t-else="" t-attf-style="background:{{ L.get('primary') }};padding:20px 28px;">
          <span style="color:#ffffff;font-size:20px;font-weight:bold;letter-spacing:0.5px;" t-out="L.get('organisation')"/>
        </td>
      </tr>
      <tr>
        <td style="padding:28px 28px 8px 28px;color:#111827;font-size:15px;line-height:1.5;">
          <p style="margin:0 0 16px 0;">Dear <t t-out="L.get('recipient_name') or object.name"/>,</p>
          <p style="margin:0 0 16px 0;font-weight:bold;">You have been given access to the <t t-out="L.get('organisation')"/> asset register.</p>
          <p style="margin:0 0 16px 0;">To start, choose a password by opening the link below. Your sign-in name is <strong t-out="object.login"/>.</p>
          <table border="0" cellpadding="0" cellspacing="0" style="margin:20px 0;">
            <tr><td t-attf-style="background:{{ L.get('primary') }};border-radius:6px;">
              <a t-att-href="L.get('link')" style="display:inline-block;padding:12px 22px;color:#ffffff;text-decoration:none;font-weight:bold;font-size:15px;">Set my password</a>
            </td></tr>
          </table>
          <p style="margin:0 0 6px 0;font-size:13px;color:#4b5563;">If the button does not work, copy this address into your browser:</p>
          <p style="margin:0 0 16px 0;font-size:13px;word-break:break-all;"><a t-att-href="L.get('link')" t-attf-style="color:{{ L.get('primary_dark') }};" t-out="L.get('link')"/></p>
          <p style="margin:0 0 16px 0;font-size:13px;color:#4b5563;">The link is valid for <t t-out="L.get('validity_days')"/> days. If it has expired, ask the administrator who set up your account to send it again<t t-if="L.get('sender_name')"> — this one was sent by <t t-out="L.get('sender_name')"/></t>.</p>
          <p style="margin:0 0 16px 0;font-size:13px;color:#4b5563;">If you were not expecting this, you can ignore it. Nothing happens until the link is used.</p>
          <p style="margin:0;">Regards,<br/><t t-out="L.get('organisation')"/></p>
        </td>
      </tr>
      <tr>
        <td style="padding:16px 28px 24px 28px;font-size:12px;color:#6b7280;border-top:1px solid #e5e7eb;">
          <t t-out="L.get('organisation')"/> · asset register · <a t-att-href="L.get('login_url')" style="color:#6b7280;" t-out="L.get('login_url')"/>
        </td>
      </tr>
    </table>
  </td></tr>
</table>
      </field>
    </record>

    <record id="mail_template_password_reset" model="mail.template">
      <field name="name">Cadra: password reset</field>
      <field name="model_id" ref="base.model_res_users"/>
      <field name="subject">{{ ctx.get('cadra_letter', {}).get('organisation', 'Cadra') }} asset register — reset your password</field>
      <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted or '') }}</field>
      <field name="use_default_to" eval="True"/>
      <field name="lang">{{ object.lang }}</field>
      <field name="auto_delete" eval="True"/>
      <field name="body_html" type="html">
<t t-set="L" t-value="ctx.get('cadra_letter') or {}"/>
<table border="0" cellpadding="0" cellspacing="0" width="100%" style="background:#f4f5f7;padding:24px 0;font-family:Arial,Helvetica,sans-serif;">
  <tr><td align="center">
    <table border="0" cellpadding="0" cellspacing="0" width="600" style="max-width:600px;width:100%;background:#ffffff;border-radius:8px;overflow:hidden;">
      <tr>
        <!-- A logo sits on WHITE with the brand colour as a rule beneath it: a
             client's logo carries its own colours (Jaiz's wordmark is navy, on
             a navy band it vanished — report 43 §C). A wordmark-only tenant
             gets the colour as the band. -->
        <td t-if="L.get('logo_url')" t-attf-style="background:#ffffff;border-bottom:5px solid {{ L.get('primary') }};padding:20px 28px;">
          <img t-att-src="L.get('logo_url')" t-att-alt="L.get('organisation')" height="44" style="height:44px;max-height:44px;display:block;"/>
        </td>
        <td t-else="" t-attf-style="background:{{ L.get('primary') }};padding:20px 28px;">
          <span style="color:#ffffff;font-size:20px;font-weight:bold;letter-spacing:0.5px;" t-out="L.get('organisation')"/>
        </td>
      </tr>
      <tr>
        <td style="padding:28px 28px 8px 28px;color:#111827;font-size:15px;line-height:1.5;">
          <p style="margin:0 0 16px 0;">Dear <t t-out="L.get('recipient_name') or object.name"/>,</p>
          <p style="margin:0 0 16px 0;font-weight:bold;">A password reset was requested for your account on the <t t-out="L.get('organisation')"/> asset register.</p>
          <p style="margin:0 0 16px 0;">Open the link below to choose a new password. Your sign-in name is <strong t-out="object.login"/>.</p>
          <table border="0" cellpadding="0" cellspacing="0" style="margin:20px 0;">
            <tr><td t-attf-style="background:{{ L.get('primary') }};border-radius:6px;">
              <a t-att-href="L.get('link')" style="display:inline-block;padding:12px 22px;color:#ffffff;text-decoration:none;font-weight:bold;font-size:15px;">Choose a new password</a>
            </td></tr>
          </table>
          <p style="margin:0 0 6px 0;font-size:13px;color:#4b5563;">If the button does not work, copy this address into your browser:</p>
          <p style="margin:0 0 16px 0;font-size:13px;word-break:break-all;"><a t-att-href="L.get('link')" t-attf-style="color:{{ L.get('primary_dark') }};" t-out="L.get('link')"/></p>
          <p style="margin:0 0 16px 0;font-size:13px;color:#4b5563;">The link is valid for <t t-out="L.get('validity_hours')"/> hours.</p>
          <p style="margin:0 0 16px 0;font-size:13px;color:#4b5563;">If you did not ask for this, you can ignore it; your password stays as it is. Nothing happens until the link is used.</p>
          <p style="margin:0;">Regards,<br/><t t-out="L.get('organisation')"/></p>
        </td>
      </tr>
      <tr>
        <td style="padding:16px 28px 24px 28px;font-size:12px;color:#6b7280;border-top:1px solid #e5e7eb;">
          <t t-out="L.get('organisation')"/> · asset register · <a t-att-href="L.get('login_url')" style="color:#6b7280;" t-out="L.get('login_url')"/>
        </td>
      </tr>
    </table>
  </td></tr>
</table>
      </field>
    </record>

  </data>
</odoo>
