<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_myservice_api_client_tree" model="ir.ui.view">
    <field name="name">myservice.api.client.tree</field>
    <field name="model">myservice.api.client</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="client_id"/>
        <field name="user_id"/>
        <field name="active"/>
        <field name="token_ttl_seconds"/>
        <field name="total_record_cap"/>
        <field name="last_used_at"/>
        <field name="last_used_ip"/>
      </list>
    </field>
  </record>

  <record id="view_myservice_api_client_form" model="ir.ui.view">
    <field name="name">myservice.api.client.form</field>
    <field name="model">myservice.api.client</field>
    <field name="arch" type="xml">
      <form>
        <header>
          <button name="action_rotate_secret" type="object" string="Rotate Secret" class="oe_highlight"/>
          <!-- Every client used to run as Administrator, so every row it
               wrote named Administrator and no audit could tell one client
               from another. This re-homes an existing client onto its own
               user and re-syncs that user's groups to its scopes. -->
          <button name="action_provision_user" type="object"
                  string="Provision Own User"
                  help="Give this client its own Odoo user, so the records it writes name the client instead of Administrator."/>
        </header>
        <sheet>
          <group>
            <field name="name"/>
            <field name="active"/>
          </group>
          <group>
            <field name="client_id"/>
            <field name="user_id"/>
            <field name="token_ttl_seconds"/>
            <field name="scopes" placeholder="assets:read assets:write locations:read"/>
          </group>
          <group string="Pagination limits" col="2">
            <!-- 0 = the external default (100 records). -1 = uncapped.
                 A positive number is that many. Vendra and the audit
                 client are provisioned uncapped by data migration; do not
                 rely on somebody remembering to set them here. -->
            <field name="total_record_cap"/>
            <field name="max_page_limit"/>
          </group>
          <group string="Usage" col="2">
            <field name="last_used_at" readonly="1"/>
            <field name="last_used_ip" readonly="1"/>
          </group>
          <group string="Secret" col="2">
            <field name="client_secret_hash" readonly="1"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_myservice_api_clients" model="ir.actions.act_window">
    <field name="name">API Clients</field>
    <field name="res_model">myservice.api.client</field>
    <field name="view_mode">list,form</field>
  </record>
</odoo>
