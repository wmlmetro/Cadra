<?xml version="1.0" encoding="UTF-8" ?>
<odoo>
    <record id="view_users_form" model="ir.ui.view">
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <!-- Odoo 19: inherited views can't set group_ids on the record; scope
             visibility with a groups= attribute on the added page instead. -->
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page name="page_generic_team"
                      string="Teams"
                      groups="generic_team.group_generic_team_user_implicit">
                    <field name="generic_team_member_ids">
                        <list>
                            <field name="team_id"/>
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
