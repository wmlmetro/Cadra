<?xml version="1.0" encoding="utf-8"?>
<templates>

<!-- ── Main Board ─────────────────────────────────────────────────────────── -->
<t t-name="nrs_watchlist.WatchlistBoard">
  <div class="nrs_wlb_root">

    <!-- Header -->
    <div class="nrs_wlb_header">
      <div class="nrs_wlb_logo_block">
        <div class="nrs_wlb_badge">NRS</div>
        <div>
          <div class="nrs_wlb_title">Watchlist Command Board</div>
          <div class="nrs_wlb_sub">SECURITY OPERATIONS CENTRE · NRS FACILITIES MANAGEMENT</div>
        </div>
      </div>
      <div class="nrs_wlb_header_right">
        <div class="nrs_wlb_feed_pill active">INTERPOL FEED</div>
        <div class="nrs_wlb_feed_pill active">DSS / NPF FEED</div>
        <div class="nrs_wlb_feed_pill active">ODOO RECORDS</div>
        <div class="nrs_wlb_clock"><t t-esc="state.clock"/></div>
      </div>
    </div>

    <!-- Controls -->
    <div class="nrs_wlb_controls">
      <span class="nrs_wlb_ctrl_label">TIER:</span>
      <button t-attf-class="nrs_wlb_btn nrs_wlb_btn_delta #{state.filters.delta ? 'active' : ''}"
              t-on-click="() => toggleFilter('delta')">DELTA</button>
      <button t-attf-class="nrs_wlb_btn nrs_wlb_btn_charlie #{state.filters.charlie ? 'active' : ''}"
              t-on-click="() => toggleFilter('charlie')">CHARLIE</button>
      <button t-attf-class="nrs_wlb_btn nrs_wlb_btn_bravo #{state.filters.bravo ? 'active' : ''}"
              t-on-click="() => toggleFilter('bravo')">BRAVO</button>
      <div class="nrs_wlb_sep"/>
      <span class="nrs_wlb_ctrl_label">STATUS:</span>
      <button t-attf-class="nrs_wlb_btn nrs_wlb_btn_active #{state.filters.active ? 'active' : ''}"
              t-on-click="() => toggleFilter('active')">ACTIVE</button>
      <button t-attf-class="nrs_wlb_btn nrs_wlb_btn_detained #{state.filters.detained ? 'active' : ''}"
              t-on-click="() => toggleFilter('detained')">DETAINED</button>
      <button t-attf-class="nrs_wlb_btn #{state.filters.cleared ? 'active' : ''}"
              t-on-click="() => toggleFilter('cleared')">CLEARED</button>
      <div class="nrs_wlb_sep"/>
      <input class="nrs_wlb_search" type="text"
             placeholder="SEARCH NAME / ALIAS..."
             t-on-input="onSearch"/>
      <div class="nrs_wlb_sep"/>
      <button t-attf-class="nrs_wlb_kiosk #{state.kiosk ? '' : 'paused'}"
              t-on-click="toggleKiosk">
        <t t-if="state.kiosk">⏵ KIOSK AUTO-SCROLL</t>
        <t t-else="">⏸ SCROLL PAUSED</t>
      </button>
      <button class="nrs_wlb_reload" t-on-click="loadData">↻ SYNC</button>
    </div>

    <!-- KPIs -->
    <div class="nrs_wlb_kpis">
      <div class="nrs_wlb_kpi"><div class="nrs_wlb_kv kv_red"><t t-esc="kpiTotal"/></div><div class="nrs_wlb_kl">Watchlist</div></div>
      <div class="nrs_wlb_kpi"><div class="nrs_wlb_kv kv_red"><t t-esc="kpiDelta"/></div><div class="nrs_wlb_kl">Delta Tier</div></div>
      <div class="nrs_wlb_kpi"><div class="nrs_wlb_kv kv_amber"><t t-esc="kpiCharlie"/></div><div class="nrs_wlb_kl">Charlie Tier</div></div>
      <div class="nrs_wlb_kpi"><div class="nrs_wlb_kv kv_blue"><t t-esc="kpiBravo"/></div><div class="nrs_wlb_kl">Bravo Tier</div></div>
      <div class="nrs_wlb_kpi"><div class="nrs_wlb_kv kv_green"><t t-esc="kpiDetained"/></div><div class="nrs_wlb_kl">Detained</div></div>
    </div>

    <!-- Board -->
    <div class="nrs_wlb_board_wrap" t-ref="board"
         t-on-mouseenter="onBoardMouseEnter"
         t-on-mouseleave="onBoardMouseLeave">
      <div class="nrs_wlb_scanline"/>
      <t t-if="state.loading">
        <div class="nrs_wlb_loading">LOADING WATCHLIST DATA…</div>
      </t>
      <t t-elif="state.filtered.length === 0">
        <div class="nrs_wlb_empty">NO RECORDS MATCH CURRENT FILTERS</div>
      </t>
      <t t-else="">
        <div class="nrs_wlb_grid">
          <t t-foreach="state.filtered" t-as="subject" t-key="subject.id">
            <WatchlistCard subject="subject" onSelect.bind="selectSubject"/>
          </t>
        </div>
      </t>
    </div>

    <!-- Detail Overlay -->
    <t t-if="state.selected">
      <WatchlistDetail
        subject="state.selected"
        onClose.bind="closeDetail"
        onRefresh.bind="loadData"/>
    </t>

  </div>
</t>

<!-- ── Subject Card ───────────────────────────────────────────────────────── -->
<t t-name="nrs_watchlist.WatchlistCard">
  <div t-attf-class="nrs_wlc tier-#{props.subject.tier}" t-on-click="onCardClick">
    <div t-attf-class="nrs_wlc_tier #{props.subject.tier}"><t t-esc="tierLabel"/></div>
    <div t-attf-class="nrs_wlc_status #{props.subject.status}"><t t-esc="statusLabel"/></div>
    <div class="nrs_wlc_photo">
      <t t-if="props.subject.has_photo">
        <img t-attf-src="#{props.subject.photo_endpoint}" style="width:100%;height:100%;object-fit:cover;filter:grayscale(20%) contrast(1.1);"/>
      </t>
      <t t-elif="props.subject.photo_url">
        <img t-attf-src="#{props.subject.photo_url}" style="width:100%;height:100%;object-fit:cover;filter:grayscale(20%) contrast(1.1);"/>
      </t>
      <t t-else="">
        <div class="nrs_wlc_avatar" t-attf-style="border-color:#{tierColor};color:#{tierColor};">
          <span class="nrs_wlc_initials"><t t-esc="initials"/></span>
          <span class="nrs_wlc_nophoto">NO PHOTO ON FILE</span>
        </div>
      </t>
    </div>
    <div class="nrs_wlc_body">
      <div class="nrs_wlc_name"><t t-esc="props.subject.name"/></div>
      <div class="nrs_wlc_alias">"<t t-esc="props.subject.alias"/>"</div>
      <div class="nrs_wlc_charge"><t t-esc="chargeShort"/></div>
      <div class="nrs_wlc_loc">
        <span class="nrs_wlc_loc_icon">◎</span>
        <t t-esc="locShort"/>
      </div>
      <div class="nrs_wlc_source"><t t-esc="props.subject.source"/></div>
    </div>
  </div>
</t>

<!-- ── Detail Overlay ────────────────────────────────────────────────────── -->
<t t-name="nrs_watchlist.WatchlistDetail">
  <div class="nrs_wld_overlay" t-on-click="props.onClose">
    <div class="nrs_wld_box" t-on-click.stop="">
      <div class="nrs_wld_hdr">
        <div>
          <div class="nrs_wld_name"><t t-esc="subject.name"/></div>
          <div class="nrs_wld_alias">"<t t-esc="subject.alias"/>"</div>
          <div class="nrs_wld_ref"><t t-esc="subject.reference"/></div>
        </div>
        <button class="nrs_wld_close" t-on-click="props.onClose">✕ CLOSE</button>
      </div>
      <div class="nrs_wld_body">
        <div class="nrs_wld_photo">
          <t t-if="subject.has_photo">
            <img t-attf-src="#{subject.photo_endpoint}" style="width:100%;height:100%;object-fit:cover;filter:grayscale(15%);"/>
          </t>
          <t t-elif="subject.photo_url">
            <img t-attf-src="#{subject.photo_url}" style="width:100%;height:100%;object-fit:cover;"/>
          </t>
          <t t-else="">
            <div class="nrs_wld_avatar" t-attf-style="color:#{tierColor};border-color:#{tierColor};">
              <span style="font-size:32px;font-weight:700;"><t t-esc="initials"/></span>
              <span style="font-size:9px;letter-spacing:2px;opacity:.5;margin-top:8px;">NO PHOTO</span>
            </div>
          </t>
        </div>
        <div class="nrs_wld_fields">
          <div class="nrs_wld_field">
            <label>Threat Tier</label>
            <p t-attf-style="color:#{tierColor};font-weight:700;letter-spacing:2px;"><t t-esc="tierLabel"/> TIER</p>
          </div>
          <div class="nrs_wld_field">
            <label>Status</label>
            <p><t t-esc="statusLabel"/></p>
          </div>
          <div class="nrs_wld_field">
            <label>Charge / Reason</label>
            <p><t t-esc="subject.charge"/></p>
          </div>
          <div class="nrs_wld_field">
            <label>Last Known Location</label>
            <p><t t-esc="subject.location"/></p>
          </div>
          <div class="nrs_wld_field">
            <label>Data Source</label>
            <p><t t-esc="subject.source"/></p>
          </div>
          <div class="nrs_wld_field">
            <label>Risk Score</label>
            <p><t t-esc="subject.risk_score"/> / 100</p>
          </div>
          <t t-if="subject.last_seen">
            <div class="nrs_wld_field">
              <label>Last Seen</label>
              <p><t t-esc="subject.last_seen"/></p>
            </div>
          </t>
        </div>
      </div>
      <div class="nrs_wld_actions">
        <button class="nrs_wld_btn flag" t-on-click="flagActive">FLAG ACTIVE</button>
        <button class="nrs_wld_btn alert" t-on-click="raiseAlert">RAISE ALERT</button>
        <button class="nrs_wld_btn clear" t-on-click="markCleared">MARK CLEARED</button>
      </div>
    </div>
  </div>
</t>

</templates>
